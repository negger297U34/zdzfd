    			return hum and hum.Health <= 0
    		end

    		local function taActHeadshotCombatLoop(plr, mode, style, continuous)
    			mode = mode or 'kill'
    			style = style or 'plain'
    			continuous = continuous == true
    			local timeout = tick() + (continuous and 60 or 12)
    			local doStrafe = style == 'strafe' or style == 'csync'

    			while not taActDead() and tick() < timeout do
    				if doStrafe then
    					local hrpMove = taActHRP(lp.Character)
    					local around = plr.Character and (
    						plr.Character:FindFirstChild('Head')
    						or plr.Character:FindFirstChild('HumanoidRootPart')
    					)
    					if hrpMove and around then
    						taActPowerStrafe(hrpMove, around.Position)
    					end
    				end
    				task.wait(TA_ACT_SHOT_CD)
    				if not lp.Character or not plr.Parent or not plr.Character then
    					return mode == 'kill' and true or false
    				end
    				if taActTargetDead(plr) then
    					return mode == 'kill'
    				end
    				local hrp = taActHRP(lp.Character)
    				if not hrp then
    					return false
    				end
    				local tool = taActEquipGun()
    				tool = taActEnsureAmmo(tool) or tool
    				local handle = tool and tool:FindFirstChild('Handle')
    				local troot = plr.Character:FindFirstChild('HumanoidRootPart')
    				local thead = plr.Character:FindFirstChild('Head')
    				if not tool or not handle or not troot or not thead then
    					taActNotify('equip gun', 3)
    					return false
    				end

    				if not taActKnockCheck(plr) then
    					taActHeadshotShoot(plr, style)
    					if taActKnockCheck(plr) and type(_619) == 'function' then
    						pcall(_619, plr)
    					end
    				elseif mode == 'knock' then
    					return true
    				elseif taActSDeath(plr) or taActTargetDead(plr) then
    					task.wait(0.4)
    					return true
    				elseif taActSDeathPending(plr) then
    					if doStrafe then
    						taActPowerStrafe(hrp, thead.Position)
    					end
    					taActHeadshotStomp(plr, style == 'csync')
    					if not continuous then
    						task.wait(0.35)
    						return taActTargetDead(plr) or mode == 'kill'
    					end
    				elseif mode == 'kill' then
    					if doStrafe then
    						taActPowerStrafe(hrp, thead.Position)
    					end
    					taActHeadshotStomp(plr, style == 'csync')
    					if not continuous then
    						task.wait(0.35)
    						return true
    					end
    				else
    					return true
    				end
    			end
    			return false
    		end

    		local function taActRunCombat(tgt, mode, style)
    			if not tgt then
    				return false
    			end
    			local hrp = taActHRP(lp.Character)
    			if not hrp then
    				return false
    			end
    			local originCF = hrp.CFrame
    			local ok = taActHeadshotCombatLoop(tgt, mode, style, false) == true
    			taActRestoreOrigin(hrp, originCF)
    			return ok
    		end

    		local function taActKnockedGotoCF(tchar)
    			if not tchar then
    				return nil
    			end
    			if type(_608) == 'function' then
    				local ok, cf = pcall(_608, tchar)
    				if ok and typeof(cf) == 'CFrame' then
    					return cf
    				end
    			end
    			local upper = tchar:FindFirstChild('UpperTorso')
    			if upper then
    				return CFrame.new(upper.Position + Vector3.new(0, 3, 0))
    			end
    			local lower = tchar:FindFirstChild('LowerTorso')
    			if lower then
    				return lower.CFrame
    			end
    			local tRoot = tchar:FindFirstChild('HumanoidRootPart')
    			if tRoot then
    				return CFrame.new(tRoot.Position + Vector3.new(0, 0.5, 0))
    			end
    			return nil
    		end

    		local function taActGotoKnocked(plr)
    			local hrp = taActHRP(lp.Character)
    			local tchar = plr and plr.Character
    			if not hrp or not tchar then
    				return false
    			end
    			local gotoCF = taActKnockedGotoCF(tchar)
    			if not gotoCF then
    				return false
    			end
    			pcall(function()
    				hrp.CFrame = gotoCF
    				hrp.AssemblyLinearVelocity = Vector3.zero
    				hrp.AssemblyAngularVelocity = Vector3.zero
    				hrp.Velocity = Vector3.zero
    			end)
    			return true
    		end

    		local function taActGotoPlr(plr, nearKnocked)
    			if nearKnocked then
    				return taActGotoKnocked(plr)
    			end
    			local hrp = taActHRP(lp.Character)
    			local tchar = plr and plr.Character
    			local troot = tchar and tchar:FindFirstChild('HumanoidRootPart')
    			if not hrp or not troot then
    				return false
    			end
    			local fromDist = (hrp.Position - troot.Position).Magnitude
    			pcall(function()
    				hrp.CFrame = troot.CFrame
    				hrp.AssemblyLinearVelocity = Vector3.zero
    				hrp.Velocity = Vector3.zero
    			end)
    			do
    				local need = math.clamp(0.10 + (fromDist / 1400), 0.10, 0.22)
    				_G.__FridayMoveSettleUntil = math.max(tonumber(rawget(_G, "__FridayMoveSettleUntil")) or 0, tick() + need)
    			end
    			return true
    		end

    		local function taActUnequipTools()
    			local char = lp.Character
    			if not char then
    				return
    			end
    			local hum = char:FindFirstChildOfClass('Humanoid')
    			local bp = lp:FindFirstChildOfClass('Backpack')
    			pcall(function()
    				if hum then
    					hum:UnequipTools()
    				end
    			end)
    			if bp then
    				for _, c in ipairs(char:GetChildren()) do
    					if c:IsA('Tool') then
    						pcall(function()
    							c.Parent = bp
    						end)
    					end
    				end
    			end
    		end

