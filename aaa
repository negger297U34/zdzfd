        local function worldMcIsIgnoredPart(desc)
            if not desc:IsA("BasePart") then
                return true
            end
            if desc.Transparency >= 0.95 then
                return true
            end
            if desc:IsA("Terrain") then
                return true
            end
            local model = desc:FindFirstAncestorOfClass("Model")
            if model then
                if Players:GetPlayerFromCharacter(model) then
                    return true
                end
                if model:FindFirstChildOfClass("Humanoid") then
                    return true
                end
            end
            if desc:FindFirstAncestorOfClass("Tool") or desc:FindFirstAncestorOfClass("Accessory") then
                return true
            end
            return false
        end

