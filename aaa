    scanRoots()
    workspace.ChildAdded:Connect(function()
        task.defer(scanRoots)
    end)
end)

local function isDowned(player)
    local char = player.Character
    if not char then
        local firedAt = FireTracker.FiredAt[player]
        if firedAt and os.clock() - firedAt < 1.2 then
            return false
        end
        return true
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then
        return true
    end
    local be = char:FindFirstChild("BodyEffects")
    local ko = be and be:FindFirstChild("K.O")
    if ko and ko.Value == true then
        return true
    end
    return false
end

local AIM_HIT_RADIUS = 10
local FIRE_WINDOW = 0.65
local HIT_SYNC = 0.12
local VOID_DIST = 10000
local MIN_RETALIATE_RANK = 40

local EVIDENCE_RANK = {
    ["creator-tag"] = 100,
    ["combatlog-confirmed"] = 90,
    ["ally-creator-tag"] = 88,
    ["ally-aimed-firer"] = 85,
    ["ally-unique-firer"] = 80,
    ["aimed-firer"] = 85,
    ["hit-synced-firer"] = 82,
    ["unique-firer"] = 80,
    ["trusted-lock"] = 75,
    ["combatlog-last"] = 72,
    ["combatlog-resolve"] = 65,
    ["aimed-firer-score"] = 55,
    ["close-recent-firer"] = 55,
    ["unique-near-firer"] = 50,
    ["near-firer-score"] = 45,
}

local function myRootPos()
    local char = LocalPlayer.Character
    local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head"))
    return hrp and hrp.Position or nil
end

local function playerDist(player)
    local me = myRootPos()
    if not me then
        return 0
    end
    local char = player.Character
    if not char then
        return math.huge 
    end
    local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
    if not hrp then
        return math.huge
    end
    return (hrp.Position - me).Magnitude
end

local function isVoidLike(player)
    return playerDist(player) >= VOID_DIST
end

local function mouseOnUs(player, myHead)
    if not myHead then
        return false
    end
    local mp = FireTracker.Mouse[player]
    if not mp or typeof(mp) ~= "Vector3" then
        return false
    end
    return (mp - myHead.Position).Magnitude <= AIM_HIT_RADIUS
end

local function recentFirers(window)
    local now = os.clock()
    window = window or FIRE_WINDOW
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and not isFriendlyWhitelisted(p) and not isDowned(p) then
            local firedAt = FireTracker.FiredAt[p]
            if firedAt and (now - firedAt) <= window then
                list[#list + 1] = p
            end
        end
    end
    return list
end

local function isHitSynced(p, hitAt)
    hitAt = hitAt or HealthState.LastHitAt or os.clock()
    local at = FireTracker.FiredAt[p]
    return at ~= nil and math.abs(hitAt - at) <= HIT_SYNC
end

local function pickBestAttacker(candidates, myHead)
    if not candidates or #candidates == 0 then
        return nil, "none"
    end

    local hitAt = HealthState.LastHitAt or os.clock()

    local aimed = {}
    for _, p in ipairs(candidates) do
        if mouseOnUs(p, myHead) then
            aimed[#aimed + 1] = p
        end
    end
    if #aimed == 1 then
        return aimed[1], "aimed-firer"
    end
    if #aimed > 1 then
        local syncedAimed = {}
        for _, p in ipairs(aimed) do
            if isHitSynced(p, hitAt) then
                syncedAimed[#syncedAimed + 1] = p
            end
        end
        if #syncedAimed == 1 then
            return syncedAimed[1], "hit-synced-firer"
        end
        return nil, "ambiguous-aim"
    end

    if #candidates == 1 then
        local only = candidates[1]
        if isHitSynced(only, hitAt) then
            return only, "hit-synced-firer"
        end
        return nil, "unique-not-aimed"
    end

    local synced = {}
    for _, p in ipairs(candidates) do
        if isHitSynced(p, hitAt) then
            synced[#synced + 1] = p
        end
    end
    if #synced == 1 then
        return synced[1], "hit-synced-firer"
    end

    return nil, "ambiguous-firers"
end

local function findUniqueFireAimAttacker(myHead)
    local firers = recentFirers(FIRE_WINDOW)
    if #firers == 0 then
        return nil, "no-firers"
    end
    return pickBestAttacker(firers, myHead)
end

local function combatLogAttacker()
    local bag = rawget(_G, "_900")
    if type(bag) ~= "table" then
        return nil
    end
    local myHead = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head")
    local firers = recentFirers(FIRE_WINDOW)
    local function trustedEnough(plr)
        if not plr or plr.Parent ~= Players or plr == LocalPlayer or isDowned(plr) then
            return false
        end
        if mouseOnUs(plr, myHead) then
            return true
        end
        if #firers <= 1 and isHitSynced(plr) then
            return true
        end
        return false
    end
    if type(bag.confirmedShooter) == "function" then
        local ok, plr = pcall(bag.confirmedShooter)
        if ok and trustedEnough(plr) then
            return plr, "combatlog-confirmed"
        end
    end
    local last = bag.lastCombatAttacker
    local lastAt = tonumber(bag.lastCombatAttackerAt) or 0
    if last and (tick() - lastAt) <= 0.8 and trustedEnough(last) then
        return last, "combatlog-last"
    end
    return nil
end

local function findAttacker()
    local myChar = LocalPlayer.Character
    local myHead = myChar and myChar:FindFirstChild("Head")
    local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")

    local tagged = findCreatorAttacker(hum)
    if tagged then
        rememberTrusted(tagged, "creator-tag")
        return tagged, "creator-tag"
    end

    local fromCl, clWhy = combatLogAttacker()
    if fromCl then
        rememberTrusted(fromCl, clWhy)
        return fromCl, clWhy
    end

    local locked = HealthState.LastTrustedShooter
    if locked
        and locked.Parent == Players
        and not isDowned(locked)
        and (os.clock() - HealthState.LastTrustedAt) <= 1.35
    then
        local myHead2 = myChar and myChar:FindFirstChild("Head")
        local firers = recentFirers(FIRE_WINDOW)
        if mouseOnUs(locked, myHead2) or (#firers <= 1 and isHitSynced(locked)) then
            return locked, "trusted-lock"
        end
    end

    local unique, why = findUniqueFireAimAttacker(myHead)
    if unique then
        rememberTrusted(unique, why)
        return unique, why
    end

    return nil, why or "no-evidence"
end

local function resolveAttackerAsync()
    local attacker, why = findAttacker()
    if attacker then
        return attacker, why
    end
    local lastWhy = why or "pending"
    for _ = 1, 4 do
        task.wait(0.01)
        attacker, why = findAttacker()
        lastWhy = why or lastWhy
        if attacker then
            return attacker, why
        end
    end
    return nil, lastWhy
end

local function watchCreatorOnInstance(inst)
    if not inst then
        return
    end
    local function consider(child)
        if not child then
            return
        end
        local isTag = isCreatorTagName(child.Name)
        local isObj = child:IsA("ObjectValue")
        if not isTag and not isObj then
            if not (child:IsA("StringValue") or child:IsA("IntValue") or child:IsA("NumberValue")) then
                return
            end
            if not isTag then
                return
            end
        end
        if not isTag and isObj then
            local function onLoose()
                if os.clock() - (HealthState.LastHitAt or 0) > 1.0 then
                    return
                end
                local plr = playerFromTag(child)
                if plr then
                    rememberTrusted(plr, "objectvalue-live")
                end
            end
            child.Changed:Connect(onLoose)
            task.defer(onLoose)
            return
        end
        local function onChanged()
            local plr = playerFromTag(child)
            if plr then
                rememberTrusted(plr, "creator-live")
            end
        end
        if child:IsA("ValueBase") then
            child.Changed:Connect(onChanged)
        end
        task.defer(onChanged)
    end
    for _, child in ipairs(inst:GetChildren()) do
        consider(child)
    end
    inst.ChildAdded:Connect(consider)
end

