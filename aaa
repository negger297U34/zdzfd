local function StripJSON(Box)
	local HiddenButtons = {
		["Import config"] = true,
		["Export current config"] = true,
		["Import theme"] = true,
		["Export current theme"] = true,
	}
	local PendingDivider = false
	local Dummy = setmetatable({}, {
		__index = function()
			return function() end
		end,
	})

	return setmetatable({}, {
		__index = function(_, Key)
			local Value = Box[Key]
			if type(Value) ~= "function" then
				return Value
			end

			return function(_, ...)
				if Key == "AddDivider" then
					PendingDivider = true
					return Dummy
				end

				local First = ...
				local IsJSON = Key == "AddInput" and (First == "SaveManager_JSON" or First == "ThemeManager_ThemeJSON")
				local ButtonText = typeof(First) == "table" and First.Text or First
				local IsHidden = Key == "AddButton" and HiddenButtons[ButtonText] == true

				if PendingDivider and not IsJSON then
					Box:AddDivider()
				end
				PendingDivider = false

				if IsHidden then
					return Dummy
				end

				local Result = Value(Box, ...)
				if IsJSON and Result and Result.SetVisible then
					Result:SetVisible(false)
				end
				return Result
			end
		end,
	})
end

