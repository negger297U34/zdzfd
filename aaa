                    end
                end
                sentryGotoOnTarget(attacker)
                local taMethod = sentryAimIsTargetAim()
                local fired = false
                pcall(function()
                    if taMethod then
                        fired = sentryTaPulse(attacker, mode) == true
                    else
                        fired = sentryAssaultPulse(attacker, mode) == true
                    end
                end)
                if fired then
                    sentAny = true
