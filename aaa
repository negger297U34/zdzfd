    local function httpGet(url)
        local req = (syn and syn.request) or http_request or request or (http and http.request)
        if type(req) == "function" then
            local ok, res = pcall(req, { Url = url, Method = "GET" })
            if ok and type(res) == "table" then
                return res.Body or res.body
            end
        end
        local ok, body = pcall(function()
            return game:HttpGet(url)
        end)
        if ok then
            return body
        end
        return nil
    end

    local function refreshServers()
        serverBrowser.entries = {}
        serverBrowser.labelToJob = {}
        local labels = { "--" }
        local url = string.format(
            "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100",
            game.PlaceId
        )
        local body = httpGet(url)
        if type(body) == "string" and body ~= "" then
            local ok, decoded = pcall(function()
                return HttpService:JSONDecode(body)
            end)
            if ok and type(decoded) == "table" and type(decoded.data) == "table" then
                local raw = {}
                local current = tostring(game.JobId or "")
                for _, s in ipairs(decoded.data) do
                    local jobId = tostring(s.id or s.jobId or "")
                    if jobId ~= "" then
                        table.insert(raw, {
                            jobId = jobId,
                            players = tonumber(s.playing) or 0,
                            max = tonumber(s.maxPlayers) or Players.MaxPlayers,
                            current = jobId == current,
                        })
                    end
                end
                table.sort(raw, function(a, b)
                    if a.players == b.players then
                        return a.jobId < b.jobId
                    end
                    return a.players < b.players
                end)
                labels = {}
                local seen = {}
                for _, entry in ipairs(raw) do
                    local base = string.format("players: %d/%d", entry.players, entry.max)
                    if entry.current then
                        base = base .. " (you)"
                    end
                    seen[base] = (seen[base] or 0) + 1
                    local label = base
                    if seen[base] > 1 then
                        label = string.format("%s (%d)", base, seen[base])
                    end
                    entry.label = label
                    serverBrowser.labelToJob[label] = entry.jobId
                    table.insert(serverBrowser.entries, entry)
                    table.insert(labels, label)
                end
                if #labels == 0 then
                    labels = { "--" }
                end
            end
        end
        return labels
    end

