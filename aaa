    		local function watchStompFlag(flag)
    			if not flag or not flag:IsA('ValueBase') or flag:GetAttribute('__friday_logs_stomp') then
    				return
    			end
    			flag:SetAttribute('__friday_logs_stomp', true)
    			track(flag.Changed:Connect(function()
    				if flag.Value == true or flag.Value == 1 then
    					stompNow()
    				end
    			end))
    			if flag.Value == true or flag.Value == 1 then
    				stompNow()
    			end
    		end

    		for _, child in ipairs(hum:GetChildren()) do
    			fridayCombatLogsWatchCreatorTag(hum, child)
    		end
    		for _, child in ipairs(char:GetChildren()) do
    			fridayCombatLogsWatchCreatorTag(hum, child)
    		end

    		track(hum.HealthChanged:Connect(function(hp)
    			if hp < lastHp and hp > 0 then
    				local dmg = math.floor(lastHp - hp + 0.5)
    				if dmg > 0 then
    					fridayCombatLogsPushShot(hum, dmg .. ' dmg')
    				end
    			end
    			lastHp = hp
    		end))

    		track(hum.Died:Connect(function()
    			if diedLogged then
    				return
    			end
    			diedLogged = true
    			task.spawn(function()
    				local killer = nil
    				for i = 1, 28 do
    					killer = fridayCombatLogsResolveShooterStrict(hum, i >= 10)
    						or fridayCombatLogsResolveShooterProbable(hum)
    					if not killer then
    						local sp = fridayCombatLogsResolveForSentry(hum, nil)
    						if sp then
    							killer = sp
    						end
    					end
    					if not killer then
    						local cs = fridayCombatLogs.confirmedShooter
    						if cs and cs ~= lp and cs.Parent == players
    							and tick() - (fridayCombatLogs.confirmedAt or 0) <= 4 then
    							killer = cs
    						end
    					end
    					if killer and killer ~= lp then
    						break
    					end
    					killer = nil
    					task.wait(0.05)
    				end
    				if killer and killer ~= lp then
    					fridayDbgCL('KILL by', killer.Name)
    					fridayCombatLogsPush('KILL', killer)
    					if type(killer.UserId) == 'number' then
    						fridayHvh.credit(killer.UserId, 'them')
    					end
    				else
    					fridayCombatLogsDbgDump('kill-miss')
    					fridayDbgCL('KILL unknown')
    					fridayCombatLogsPushSelf('KILL', 'you died')
    				end
    			end)
    		end))

    		track(hum.ChildAdded:Connect(function(child)
    			fridayCombatLogsWatchCreatorTag(hum, child)
    		end))

    		track(char.ChildAdded:Connect(function(child)
    			fridayCombatLogsWatchCreatorTag(hum, child)
    		end))

    		track(char:GetAttributeChangedSignal('Stomped'):Connect(function()
    			if char:GetAttribute('Stomped') == true or char:GetAttribute('Stomped') == 1 then
    				stompNow()
    			end
    		end))

    		task.spawn(function()
    			local be = char:WaitForChild('BodyEffects', 8)
    			if not be or fridayCombatLogs.boundChar ~= char then
    				return
    			end
    			for _, child in ipairs(be:GetChildren()) do
    				fridayCombatLogsWatchCreatorTag(hum, child)
    			end
    			track(be.ChildAdded:Connect(function(ch)
    				fridayCombatLogsWatchCreatorTag(hum, ch)
    				if ch and ch:IsA('ValueBase') then
    					local ln = string.lower(ch.Name)
    					if string.find(ln, 'armor', 1, true) then
    						if not ch:GetAttribute('__friday_logs_armor') then
    							ch:SetAttribute('__friday_logs_armor', true)
    							lastArmor = tonumber(ch.Value) or 0
    							track(ch.Changed:Connect(function()
    								local av = tonumber(ch.Value)
    								if av == nil then
    									return
    								end
    								if lastArmor ~= nil and av < lastArmor then
    									local dmg = math.floor(lastArmor - av + 0.5)
    									if dmg > 0 and dmg <= 250 then
    										fridayCombatLogsPushShot(hum, dmg .. ' armor')
    									end
    								end
    								lastArmor = av
    							end))
    						end
    					end
    				end
    			end))
    			watchStompFlag(be:FindFirstChild('SDeath'))
    			watchStompFlag(be:FindFirstChild('Stomped'))
    			watchStompFlag(be:FindFirstChild('Dead'))
    			local armor = be:FindFirstChild('Armor')
    			if armor and armor:IsA('ValueBase') and not armor:GetAttribute('__friday_logs_armor') then
    				armor:SetAttribute('__friday_logs_armor', true)
    				lastArmor = tonumber(armor.Value) or 0
    				track(armor.Changed:Connect(function()
    					local av = tonumber(armor.Value)
    					if av == nil then
    						return
    					end
    					if lastArmor ~= nil and av < lastArmor then
    						local dmg = math.floor(lastArmor - av + 0.5)
    						if dmg > 0 and dmg <= 250 then
    							fridayCombatLogsPushShot(hum, dmg .. ' armor')
    						end
    					end
    					lastArmor = av
    				end))
    			end
    		end)
    	end

