    		local function taActIsCarrying(tgt)
    			local char = lp.Character
    			if not char then
    				return false
    			end
    			if char:FindFirstChild('GRABBING_CONSTRAINT') then
    				return true
    			end
    			local be = char:FindFirstChild('BodyEffects')
    			local grabbing = be and (be:FindFirstChild('Grabbing') or be:FindFirstChild('GRABBING'))
    			if grabbing and grabbing:IsA('ValueBase') and grabbing.Value then
    				return true
    			end
    			if tgt and tgt.Character then
    				local tbe = tgt.Character:FindFirstChild('BodyEffects')
    				local grabbed = tbe and tbe:FindFirstChild('Grabbed')
    				if grabbed and grabbed:IsA('ValueBase') then
    					local v = grabbed.Value
    					if v == lp or v == char then
    						return true
    					end
    					if typeof(v) == 'Instance' and (v == lp or v.Parent == char) then
    						return true
    					end
    				end
    				if tgt.Character:FindFirstChild('GRABBING_CONSTRAINT') then
    					return true
    				end
    			end
    			return false
    		end

    		local function taActGrabbing(char)
    			if taActIsCarrying(nil) then
    				return true
    			end
    			return char and char:FindFirstChild('GRABBING_CONSTRAINT') ~= nil
    		end

    		local function taActTryGrab(tgt, tries)
    			tries = tries or 12
    			if type(_900) == 'table' then
    				_900.suppressAutoEquipUntil = tick() + 1.5
    			end
    			taActUnequipTools()
    			task.wait(0.1)
    			for _ = 1, tries do
    				if taActDead() or not tgt or not tgt.Character then
    					return false
    				end
    				if not taActKnockCheck(tgt) then
    					return false
    				end
    				taActGotoKnocked(tgt)
    				task.wait(0.1)
    				taActPressG()
    				task.wait(0.18)
    				if taActIsCarrying(tgt) then
    					return true
    				end
    			end
    			return false
    		end

    		local function taActTryRelease(tgt, tries)
    			tries = tries or 5
    			for _ = 1, tries do
    				taActPressG()
    				task.wait(0.15)
    				if not taActIsCarrying(tgt) then
    					return true
    				end
    			end
    			return not taActIsCarrying(tgt)
    		end

    		local function taActWithBusy(fn, lockReason)
    			lockReason = lockReason or 'ta'
    			do
    				local tS = tick()
    				while rawget(_G, '__FridaySentryRetaliating') == true and tick() - tS < 2.2 do
    					task.wait(0.05)
    				end
    			end
    			if taActBusy or (type(fridayPosLockBusy) == 'function' and fridayPosLockBusy()) then
    				local t0 = tick()
    				while (taActBusy or (type(fridayPosLockBusy) == 'function' and fridayPosLockBusy()))
    					and tick() - t0 < 2.5
    				do
    					task.wait(0.05)
    				end
    				if taActBusy or (type(fridayPosLockBusy) == 'function' and fridayPosLockBusy()) then
    					taActNotify('action busy (poslock depth=' .. tostring(friday.PosLock and friday.PosLock.depth) .. ' reason=' .. tostring(friday.PosLock and friday.PosLock.reason) .. ')', 3)
    					return false, 'busy'
    				end
    			end
    			taActBusy = true
    			_G.__FridayTaActBusy = true
    			_G.__FridayTaActBusyAt = tick()
    			fridayPosLockAcquire(lockReason)
    			local ok, err = pcall(fn)
    			fridayPosLockRelease(lockReason)
    			_G.__FridayTaActBusy = false
    			_G.__FridayTaActBusyAt = 0
    			taActBusy = false
    			pcall(taActHolster, 1.25)
    			if not ok then
    				taActNotify('action failed: ' .. tostring(err), 3)
    				return false, tostring(err)
    			end
    			return true
    		end

    		local function taActBringOne(tgt, originCF)
    			if not tgt or tgt.Parent ~= players then
    				return false, 'invalid'
    			end
    			local hrp = taActHRP(lp.Character)
    			if not hrp or not originCF then
    				return false, 'no hrp'
    			end

    			if not taActKnockCheck(tgt) then
    				local knocked = taActHeadshotCombatLoop(tgt, 'knock', 'strafe', false) == true
    				hrp = taActHRP(lp.Character) or hrp
    				if not knocked and not taActKnockCheck(tgt) then
    					taActRestoreOrigin(hrp, originCF)
    					return false, 'failed to knock'
    				end
    			end

    			if not taActGotoKnocked(tgt) then
    				taActRestoreOrigin(taActHRP(lp.Character), originCF)
    				return false, 'goto knocked failed'
    			end
    			task.wait(0.08)

    			if not taActTryGrab(tgt, 18) then
    				taActRestoreOrigin(taActHRP(lp.Character), originCF)
    				return false, 'grab failed'
    			end

    			task.wait(0.1)
    			hrp = taActHRP(lp.Character)
    			taActRestoreOrigin(hrp, originCF)
    			task.wait(0.12)

    			taActTryRelease(tgt, 8)
    			if taActIsCarrying(tgt) then
    				taActTryRelease(tgt, 6)
    			end
    			taActRestoreOrigin(taActHRP(lp.Character), originCF)
    			return true
    		end

