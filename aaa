		return (part.CFrame * CFrame.new(0, (dir or -1) * part.Size.Y * 0.5, 0)).Position
	end

	local function collectSkeletonBones(character)
		local bones = {}
		local function push(a, b)
			if a and b and (a - b).Magnitude > 0.05 then
				bones[#bones + 1] = { a, b }
			end
		end

		local isR15 = character:FindFirstChild("UpperTorso") ~= nil

		if isR15 then
			local joints = {}
			for _, chain in ipairs(R15_MOTOR_CHAIN) do
				for _, name in ipairs(chain) do
					if not joints[name] then
						joints[name] = motorJointPos(findMotor(character, name))
					end
				end
				push(joints[chain[1]], joints[chain[2]])
			end
			push(joints.LeftShoulder, joints.RightShoulder)
			push(joints.LeftHip, joints.RightHip)

			for _, tip in ipairs(R15_TIP) do
				local j = joints[tip.motor] or motorJointPos(findMotor(character, tip.motor))
				local p = character:FindFirstChild(tip.part)
				push(j, limbTipPos(p, tip.tip))
			end

			if #bones < 4 then
				local function partPos(name)
					local p = character:FindFirstChild(name)
					return p and p:IsA("BasePart") and p.Position or nil
				end
				local pairsList = {
					{ "Head", "UpperTorso" },
					{ "UpperTorso", "LowerTorso" },
					{ "UpperTorso", "LeftUpperArm" },
					{ "LeftUpperArm", "LeftLowerArm" },
					{ "LeftLowerArm", "LeftHand" },
					{ "UpperTorso", "RightUpperArm" },
					{ "RightUpperArm", "RightLowerArm" },
					{ "RightLowerArm", "RightHand" },
					{ "LowerTorso", "LeftUpperLeg" },
					{ "LeftUpperLeg", "LeftLowerLeg" },
					{ "LeftLowerLeg", "LeftFoot" },
					{ "LowerTorso", "RightUpperLeg" },
					{ "RightUpperLeg", "RightLowerLeg" },
					{ "RightLowerLeg", "RightFoot" },
					{ "LeftUpperArm", "RightUpperArm" },
					{ "LeftUpperLeg", "RightUpperLeg" },
				}
				for i = #bones, 1, -1 do
					bones[i] = nil
				end
				for _, pair in ipairs(pairsList) do
					push(partPos(pair[1]), partPos(pair[2]))
				end
			end
		else
			local torso = character:FindFirstChild("Torso")
			local head = character:FindFirstChild("Head")
			local la = character:FindFirstChild("Left Arm")
			local ra = character:FindFirstChild("Right Arm")
			local ll = character:FindFirstChild("Left Leg")
			local rl = character:FindFirstChild("Right Leg")
			if not torso then
				return bones
			end

			local neck = motorJointPos(findMotor(character, "Neck"))
				or (torso.Position + Vector3.new(0, torso.Size.Y * 0.5, 0))
			local lShoulder = motorJointPos(findMotor(character, "Left Shoulder"))
				or (torso.Position + Vector3.new(-torso.Size.X * 0.5, torso.Size.Y * 0.35, 0))
			local rShoulder = motorJointPos(findMotor(character, "Right Shoulder"))
				or (torso.Position + Vector3.new(torso.Size.X * 0.5, torso.Size.Y * 0.35, 0))
			local lHip = motorJointPos(findMotor(character, "Left Hip"))
				or (torso.Position + Vector3.new(-torso.Size.X * 0.25, -torso.Size.Y * 0.5, 0))
			local rHip = motorJointPos(findMotor(character, "Right Hip"))
				or (torso.Position + Vector3.new(torso.Size.X * 0.25, -torso.Size.Y * 0.5, 0))
			local pelvis = (lHip + rHip) * 0.5
			local chest = (neck + pelvis) * 0.5

			if head then
				push(neck, head.Position + Vector3.new(0, head.Size.Y * 0.25, 0))
			end
			push(neck, chest)
			push(chest, pelvis)
			push(lShoulder, rShoulder)
			push(lHip, rHip)
			push(lShoulder, neck)
			push(rShoulder, neck)
			push(lHip, pelvis)
			push(rHip, pelvis)
			if la then
				local tip = la.Position - la.CFrame.UpVector * (la.Size.Y * 0.5)
				push(lShoulder, tip)
			end
			if ra then
				local tip = ra.Position - ra.CFrame.UpVector * (ra.Size.Y * 0.5)
				push(rShoulder, tip)
			end
			if ll then
				local tip = ll.Position - ll.CFrame.UpVector * (ll.Size.Y * 0.5)
				push(lHip, tip)
			end
			if rl then
				local tip = rl.Position - rl.CFrame.UpVector * (rl.Size.Y * 0.5)
				push(rHip, tip)
			end
		end

		return bones
	end


