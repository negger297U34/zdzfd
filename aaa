            { 1, 5 }, { 2, 6 }, { 3, 7 }, { 4, 8 },
        }
        local function hbFlag(key, default)
            local v = ui.Flags[key]
            if v == nil then
                return default
            end
            return v
        end
        local function hbColor(key, default)
            local v = ui.Flags[key]
            if typeof(v) == "Color3" then
                return v
            end
            if type(v) == "table" and typeof(v.Color) == "Color3" then
                return v.Color
            end
            return default
        end
        local function hbDestroyVisual(d)
            if type(d.Visual) == "table" then
                for _, ln in ipairs(d.Visual) do
                    pcall(function()
                        ln.Visible = false
                        ln:Remove()
                    end)
                end
            end
            d.Visual = nil
        end
        local function hbUpdateVisual(d, part, size, col, trans)
            if type(d.Visual) ~= "table" then
                d.Visual = {}
                for i = 1, 12 do
                    local ok, ln = pcall(function()
                        local l = Drawing.new("Line")
                        l.Thickness = 1
                        l.Visible = false
                        return l
                    end)
                    d.Visual[i] = ok and ln or nil
                end
            end
            local cam = workspace.CurrentCamera
            if not cam then
                return
            end
            local cf = part.CFrame
            local hx, hy, hz = size.X * 0.5, size.Y * 0.5, size.Z * 0.5
            local pts = {
                cf * Vector3.new(-hx, -hy, -hz), cf * Vector3.new(hx, -hy, -hz),
                cf * Vector3.new(hx, -hy, hz), cf * Vector3.new(-hx, -hy, hz),
                cf * Vector3.new(-hx, hy, -hz), cf * Vector3.new(hx, hy, -hz),
                cf * Vector3.new(hx, hy, hz), cf * Vector3.new(-hx, hy, hz),
            }
            local scr, on = {}, {}
            for i = 1, 8 do
                local sp, vis = cam:WorldToViewportPoint(pts[i])
                scr[i] = Vector2.new(sp.X, sp.Y)
                on[i] = vis == true and sp.Z > 0
            end
            for i, e in ipairs(HB_EDGES) do
                local ln = d.Visual[i]
                if ln then
                    ln.From = scr[e[1]]
                    ln.To = scr[e[2]]
                    ln.Color = col
                    ln.Transparency = math.clamp(1 - trans * 0.2, 0.8, 1)
                    ln.Visible = on[e[1]] or on[e[2]]
                end
            end
        end
        local function hbRestore(part, d)
            pcall(function()
                if part and part.Parent then
                    part.Size = d.Size
                    part.CanCollide = d.CanCollide
                end
            end)
            hbDestroyVisual(d)
            stored[part] = nil
        end
        local function hbRestoreAll()
            for part, d in pairs(stored) do
                hbRestore(part, d)
            end
        end
        local function hbTick()
            if hbFlag("ta_hitbox_expander", false) ~= true then
                hbRestoreAll()
                return
            end
            local size = Vector3.new(
                math.clamp(tonumber(hbFlag("ta_hitbox_sx", 12.6)) or 12.6, 1, 20),
                math.clamp(tonumber(hbFlag("ta_hitbox_sy", 12.3)) or 12.3, 1, 20),
                math.clamp(tonumber(hbFlag("ta_hitbox_sz", 12.6)) or 12.6, 1, 20)
            )
            local show = hbFlag("ta_hitbox_show", true) ~= false
            local col = hbColor("ta_hitbox_color", Color3.fromRGB(20, 50, 160))
            local trans = math.clamp(tonumber(hbFlag("ta_hitbox_trans", 0.79)) or 0.79, 0, 1)
            local seen = {}
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer then
                    local part = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                    if part then
                        seen[part] = true
