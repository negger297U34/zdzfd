    	local function fridaySentryLogsWanted()
    		local sentryOn = flags['ta_sentry'] == true
    			or (Library and Library.Flags and Library.Flags.ta_sentry == true)
    		if not sentryOn then
    			return false
    		end
    		local sel = flags['ta_sentry_actions']
    		if type(sel) ~= 'table' then
    			sel = Library and Library.Flags and Library.Flags.ta_sentry_actions
    		end
    		if type(sel) ~= 'table' then
    			return false
    		end
    		for k, v in pairs(sel) do
    			local name = (v == true and type(k) == 'string' and k) or (type(v) == 'string' and v) or nil
    			if name and string.lower(tostring(name)) == 'sentry logs' then
    				return true
    			end
    		end
    		return false
    	end

    	fridayCombatLogsInit = function()
    		local wantUi = fridaySentryLogsWanted()
    		local wantCapture = wantUi or (type(_G.__FridayOutputLogOn) == 'function' and _G.__FridayOutputLogOn() == true)
    		if not wantCapture then
    			fridayCombatLogs.enabled = false
    			fridayCombatLogsSetVisible(false)
