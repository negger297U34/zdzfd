	local function Contains(Object, X, Y)
		local Position, Size = Object.AbsolutePosition, Object.AbsoluteSize
		return X >= Position.X and X <= Position.X + Size.X and Y >= Position.Y and Y <= Position.Y + Size.Y
	end

	local function Covers(Object, Bounds)
		local Size = Object.AbsoluteSize
		return Size.X * Size.Y > Bounds.X * Bounds.Y * 0.5
	end

	local function Hits(Root, X, Y, Depth, Bounds)
		for _, Child in Root:GetChildren() do
			if Child:IsA("GuiObject") and Child.Visible and Contains(Child, X, Y) then
				if not Covers(Child, Bounds) then
					if Child:IsA("GuiButton") or Child:IsA("TextBox") or Child:IsA("ScrollingFrame") or Child.BackgroundTransparency < 1 then
						return true
					end
				end
				if Depth > 0 and Hits(Child, X, Y, Depth - 1, Bounds) then
					return true
				end
			end
		end
		return false
	end

