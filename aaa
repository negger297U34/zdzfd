	local function applyNametag(player, hide)
		local char = player and player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hum then
			return
		end
		if hide then
			if nametagState[player] == nil then
				nametagState[player] = {
					DisplayDistanceType = hum.DisplayDistanceType,
					HealthDisplayType = hum.HealthDisplayType,
					NameDisplayDistance = hum.NameDisplayDistance,
				}
			end
			hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
			hum.NameDisplayDistance = 0
		else
			local prev = nametagState[player]
			if prev then
				pcall(function()
					hum.DisplayDistanceType = prev.DisplayDistanceType
					hum.HealthDisplayType = prev.HealthDisplayType
					hum.NameDisplayDistance = prev.NameDisplayDistance
				end)
				nametagState[player] = nil
			else
				hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.DisplayWhenDamaged
			end
		end
	end

