    local function _fridayFindDaHoodMainRemote()
    	local rs = game:GetService('ReplicatedStorage')
    	local strictNames = { 'MainRemoteEvent', 'MainEvent', 'MAINEVENT', 'MainGameEvent' }
    	local remotes = rs:FindFirstChild('Remotes')
    	if remotes then
    		for _, name in ipairs(strictNames) do
    			if _fridayIsRemoteEvent(remotes:FindFirstChild(name)) then
    				return remotes:FindFirstChild(name)
    			end
    		end
    	end
    	local gameRemotes = rs:FindFirstChild('GameRemotes')
    	if gameRemotes and _fridayIsRemoteEvent(gameRemotes:FindFirstChild('MainGameEvent')) then
    		return gameRemotes:FindFirstChild('MainGameEvent')
    	end
    	for _, name in ipairs(strictNames) do
    		if _fridayIsRemoteEvent(rs:FindFirstChild(name)) then
    			return rs:FindFirstChild(name)
    		end
    	end
    	local mainRemotes = rs:FindFirstChild('MainRemotes')
    	if mainRemotes then
    		for _, name in ipairs(strictNames) do
    			if _fridayIsRemoteEvent(mainRemotes:FindFirstChild(name)) then
    				return mainRemotes:FindFirstChild(name)
    			end
    		end
    	end
    	return nil
    end

    local function _fridayIsDaHoodBodyEffects(char)
    	if not char then
    		return false
    	end
    	local be = char:FindFirstChild('BodyEffects')
    	if not be then
    		return false
    	end
    	local knock = be:FindFirstChild('K.O') or be:FindFirstChild('KO')
    	if not knock then
    		return false
    	end
    	return be:FindFirstChild('Armor')
    		or be:FindFirstChild('Health')
    		or be:FindFirstChild('Grabbed')
    		or be:FindFirstChild('Attacking')
    end

    local function _fridayFindUnsupportedLayout()
    	local rs = game:GetService('ReplicatedStorage')
    	local remotes = rs:FindFirstChild('Remotes')
    	if not remotes then
    		return nil
    	end
    	local blocked = {
    		'GunSystem', 'GunService', 'GunRemotes', 'WeaponSystem', 'WeaponsSystem',
    		'CombatSystem', 'ShootRequest', 'FireRequest', 'GunRemote',
    	}
    	for _, name in ipairs(blocked) do
    		local inst = remotes:FindFirstChild(name)
    		if inst then
    			return name
    		end
    	end
    	local gunSystem = remotes:FindFirstChild('GunSystem')
    	if gunSystem and gunSystem:FindFirstChild('ShootRequest') then
    		return 'GunSystem.ShootRequest'
    	end
    	for _, ch in ipairs(remotes:GetChildren()) do
    		if ch:IsA('RemoteEvent') or ch:IsA('UnreliableRemoteEvent') then
    			local ln = string.lower(ch.Name)
    			if ln == 'shootrequest' or ln == 'firerequest' or ln == 'shootgun' then
    				return ch.Name
    			end
    		end
    	end
    	return nil
    end

