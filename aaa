function Library:AttachSpinningLogo(Logo, VisibilityRoot, FPS)
	FPS = math.max(1, FPS or 20)
	Logo.ImageTransparency = 1

	task.spawn(function()
		local Images = Library:PreloadSpinFrames()
		if #Images == 0 then
			return
		end

		local Warm = Instance.new("Frame")
		Warm.BackgroundTransparency = 1
		Warm.Size = UDim2.fromOffset(1, 1)
		Warm.ClipsDescendants = true
		Warm.Parent = Logo

		local Labels = {}
		for Index, Asset in Images do
			local Label = Instance.new("ImageLabel")
			Label.BackgroundTransparency = 1
			Label.Size = UDim2.fromOffset(1, 1)
			Label.Image = Asset
			Label.Parent = Warm
			Labels[Index] = Label
		end
		pcall(function()
			game:GetService("ContentProvider"):PreloadAsync(Labels)
		end)

		local Start = os.clock()
		while os.clock() - Start < 3 do
			local Ready = true
			for _, Label in Labels do
				if not Label.IsLoaded then
					Ready = false
					break
				end
			end
			if Ready then
				break
			end
			task.wait()
		end
		Warm:Destroy()

		Logo.Image = Images[1]
		Logo.ImageTransparency = 0
		if #Images < 2 then
			return
		end

		local LastIndex = 1
		local Origin = os.clock()
		Library:GiveSignal(game:GetService("RunService").RenderStepped:Connect(function()
			if not Logo.Parent or (VisibilityRoot and not VisibilityRoot.Visible) then
				return
			end
			local Index = (math.floor((os.clock() - Origin) * FPS) % #Images) + 1
			if Index ~= LastIndex then
				LastIndex = Index
				Logo.Image = Images[Index]
			end
		end))
	end)
end

