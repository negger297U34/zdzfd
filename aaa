        "rbxassetid://11723817205", "rbxassetid://11719595104",
    }
    local indGui, indImage, indLastPos = nil, nil, nil

    local function flagNum(name, default)
        local v = tonumber(ui.Flags[name])
        if v == nil then
            return default
        end
        return v
    end

    local function ensureIndGui()
        if indGui and indGui.Parent then
            return
        end
        indGui = Instance.new("ScreenGui")
        indGui.Name = "FridayServerInd"
        indGui.ResetOnSpawn = false
        indGui.IgnoreGuiInset = true
        indGui.DisplayOrder = 5
        pcall(function()
            indGui.Parent = (type(gethui) == "function" and gethui()) or game:GetService("CoreGui")
        end)
        if not indGui.Parent then
            indGui.Parent = Client:FindFirstChildOfClass("PlayerGui")
        end
        indImage = Instance.new("ImageLabel")
        indImage.BackgroundTransparency = 1
        indImage.ImageTransparency = 1
        indImage.BorderSizePixel = 0
        indImage.Parent = indGui
        Instance.new("UICorner", indImage).CornerRadius = UDim.new(1, 0)
    end

    local function hideInd()
        if indImage then
            indImage.ImageTransparency = 1
        end
        indLastPos = nil
    end

    local indConn = RunService.RenderStepped:Connect(function(dt)
        if _G.__FridayUnloaded or ui.Flags.self_server_ind ~= true then
            hideInd()
            return
        end
        local cam = workspace.CurrentCamera
        local char = Client.Character
        local anchor = char and (char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart"))
        if not cam or not anchor then
            hideInd()
            return
        end
        ensureIndGui()
        local serverPos = rawget(_G, "__ArtefactServerPos")
        if typeof(serverPos) ~= "Vector3" then
            serverPos = anchor.Position
        end
        local pos, onScreen = cam:WorldToViewportPoint(serverPos)
        if not onScreen or pos.Z <= 0 then
            hideInd()
            return
        end
        local lerp = math.clamp(flagNum("self_ind_lerp", 1), 0, 1)
        local factor = math.min((dt or 0) * (1 + 19 * lerp), 1)
        if not indLastPos then
            indLastPos = pos
        end
        local sx = indLastPos.X + (pos.X - indLastPos.X) * factor
        local sy = indLastPos.Y + (pos.Y - indLastPos.Y) * factor
        indLastPos = Vector3.new(sx, sy, pos.Z)
        local size = math.clamp(flagNum("self_ind_size", 12), 0, 50)
        local idx = math.clamp(math.floor(flagNum("self_ind_icon", 5) + 0.5), 0, #IND_ICONS - 1)
        indImage.Image = IND_ICONS[idx + 1]
        indImage.Size = UDim2.fromOffset(size, size)
        indImage.Position = UDim2.fromOffset(sx - size / 2, sy - size / 2)
        indImage.ImageTransparency = 0
    end)

    _G.__FridayOmegaCleanup = _G.__FridayOmegaCleanup or {}
    table.insert(_G.__FridayOmegaCleanup, function()
        pcall(function()
            indConn:Disconnect()
        end)
        if indGui then
            pcall(function()
                indGui:Destroy()
            end)
        end
    end)
