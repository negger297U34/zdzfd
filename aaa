    			return
    		end
    		fridayCombatLogsDisconnectLocal()
    		char:SetAttribute('__friday_logs_bound', true)
    		fridayCombatLogs.boundChar = char
    		fridayCombatLogsResetPoll(char)
    		local hum = char:FindFirstChildOfClass('Humanoid') or char:WaitForChild('Humanoid', 8)
    		if not hum then
    			return
    		end
    		local lastHp = hum.Health
    		local lastArmor = nil
    		local stompedState = false
    		local diedLogged = false
    		local function track(conn)
    			if conn then
    				table.insert(fridayCombatLogs.localConns, conn)
    			end
    		end

    		local function stompNow()
    			if stompedState then
    				return
    			end
    			stompedState = true
    			local stomper = fridayCombatLogsResolveStomper(hum)
    			if stomper and stomper ~= lp then
    				fridayCombatLogsPush('STOMP', stomper)
    				if type(stomper.UserId) == 'number' then
    					fridayHvh.credit(stomper.UserId, 'them')
    				end
    			else
