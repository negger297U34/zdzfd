            while gen == manipState.constGen
                and manipFeatureOn()
                and manipConstantWanted()
                and not manipState.stopping
                and not (_G.__FridayUnloaded or _G.__FridayOmegaUnloaded)
            do
                local t0 = tick()
                local taBusy = _G.__FridayTaActBusy == true
                    or (type(fridayPosLockBusy) == "function" and fridayPosLockBusy())
                    or rawget(_G, "__FridaySentryRetaliating") == true
                if not taBusy then
                    pcall(manipKillAll, {
                        ignoreAlive = true,
                        keepEquipped = true,
                        bypassBusy = true,
                        bursts = 2,
                    })
                end
                local left = interval - (tick() - t0)
                if left > 0 then
