    local function manipKillAll(opts)
        opts = opts or {}
        if opts.instinct ~= true and opts.sentry ~= true then
            if manipState.stopping or not manipFeatureOn() then
                return false
            end
        elseif manipState.stopping and opts.force ~= true then
            return false
        end
        if opts.sentry ~= true and rawget(_G, "__FridaySentryRetaliating") == true then
            return false
        end
        if opts.bypassBusy ~= true
            and (
                _G.__FridayTaActBusy == true
                or (type(fridayPosLockBusy) == "function" and fridayPosLockBusy())
            )
        then
            return false
        end
        local character = LocalPlayer.Character
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        if character == nil or backpack == nil then
            return false
        end

        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local KillAllRemote = manipFindKillRemote()
        if KillAllRemote == nil or humanoid == nil or humanoid.Health <= 0 then
            return false
        end

        local tool = manipEnsureLoadedGun(manipConstantWanted() and 0 or 0.9)
        character = LocalPlayer.Character or character
        backpack = LocalPlayer:FindFirstChild("Backpack") or backpack
        humanoid = character and character:FindFirstChildOfClass("Humanoid") or humanoid
        local handle = tool and tool:FindFirstChild("Handle")
        local ammo = tool and manipGetAmmo(tool)

        if tool == nil
            or handle == nil
            or ammo == nil
            or humanoid == nil
            or humanoid.Health <= 0
            or (tonumber(ammo.Value) or 0) <= 0
        then
            return false
        end
        manipWatchToolAmmo(tool)

        local pellets = {}
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local targetCharacter, valid = manipGetTarget(player, opts)
                local head = targetCharacter
                    and (targetCharacter:FindFirstChild("Head")
                        or targetCharacter:FindFirstChild("HumanoidRootPart")
                        or targetCharacter:FindFirstChild("UpperTorso")
                        or targetCharacter:FindFirstChild("Torso"))
                if valid and head then
                    local position = head.Position
                    for _ = 1, 20 do
                        pellets[#pellets + 1] = {
                            AimPosition = position,
                            Result1 = position,
                            Result2 = head,
                            Result3 = Vector3.yAxis,
                        }
                    end
                end
            end
        end

        if #pellets == 0 then
            return false
        end

        local rangeObject = tool:FindFirstChild("Range")
        local damageObject = tool:FindFirstChild("Damage")
        local range = (opts.ignoreAlive == true) and math.huge
            or (rangeObject and rangeObject.Value or 200)
        local damage = damageObject and damageObject.Value or 50

        local wasEquipped = tool.Parent == character
        tool.Enabled = true
        if not wasEquipped then
            pcall(function()
                tool.Parent = character
            end)
        end

        local bursts = opts.bursts
            or ((opts.ignoreAlive == true) and 10 or 8)
        if type(bursts) ~= "number" or bursts < 1 then
            bursts = 8
        end
        for _ = 1, bursts do
            pcall(function()
                KillAllRemote:FireServer(
                    "ShootGun",
                    handle,
                    handle.Position,
                    pellets,
                    nil,
                    nil,
                    nil,
                    range,
                    damage
                )
            end)
        end

        local usedTool = tool
        local usedGen = manipState.refillGen
        task.defer(function()
            if usedGen ~= manipState.refillGen or manipState.stopping then
                return
            end
            manipPostUseRefresh(usedTool)
        end)

        if not wasEquipped
            and opts.keepEquipped ~= true
            and usedTool
            and usedTool.Parent == character
        then
            local other = manipFindLoadedCopy(usedTool.Name, usedTool)
            if other then
                manipEquipTool(other)
            else
                pcall(function()
                    usedTool.Parent = backpack
                end)
            end
        elseif usedTool then
            local other = manipFindLoadedCopy(usedTool.Name, usedTool)
            if other then
                manipEquipTool(other)
            end
        end
        return true
    end

