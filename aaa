    		end

    		local function taActRestoreOrigin(hrp, originCF)
    			if not hrp or not originCF then
    				return
    			end
    			pcall(function()
    				if hrp.Parent then
    					hrp.CFrame = originCF
    					hrp.AssemblyLinearVelocity = Vector3.zero
    					hrp.AssemblyAngularVelocity = Vector3.zero
    					hrp.Velocity = Vector3.zero
    				end
    			end)
    		end

    		local function taActTargetDead(plr)
    			if not plr or not plr.Character then
