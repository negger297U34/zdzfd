		local Flag = Args.Flag or Args.Name
		local Entry = Bind(Flag)
		local Api = {}

		if Entry and Entry.Element.Type == "Slider" then
			local Element = Entry.Element
			if Args.Callback then
				table.insert(Entry.Callbacks, Args.Callback)
			end
			function Api:Set(Value)
				local Number = tonumber(Value) or Args.Default or Element.Min
				Number = math.clamp(Number, Element.Min, Element.Max)
				if Number == Element.Value then
					Fire(Entry)
				else
					Element:SetValue(Number)
				end
			end
			Call(Flag, Args.Callback, Store[Flag])
		else
			local Min, Max = Args.Min or 0, Args.Max or 100
			local Power = 10 ^ (Args.Decimals or 0)
			function Api:Set(Value)
				local Number = tonumber(Value) or Args.Default or Min
				Number = math.floor(math.clamp(Number, Min, Max) * Power + 0.5) / Power
				Store[Flag] = Number
				Call(Flag, Args.Callback, Number)
			end
			Api:Set(Args.Default or Min)
