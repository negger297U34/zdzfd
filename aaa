			end

			local req = (syn and syn.request) or http_request or request or (http and http.request)
			if type(req) == "function" then
				local ok, res = pcall(req, {
					Url = "https://groups.roblox.com/v2/users/" .. tostring(player.UserId) .. "/groups/roles",
					Method = "GET",
				})
				local body = ok and type(res) == "table" and (res.Body or res.body)
				if type(body) == "string" then
					local okJson, data = pcall(function()
						return game:GetService("HttpService"):JSONDecode(body)
					end)
					if okJson and type(data) == "table" and type(data.data) == "table" then
						for _, entry in ipairs(data.data) do
							local group, role = entry.group, entry.role
							if type(group) == "table" and type(role) == "table" and tonumber(group.id) == groupId then
								return tonumber(role.rank) or 1, tostring(role.name or "")
							end
						end
					end
				end
			end

			return 0, nil
		end

		local function getStaffRole(player, groupId)
			if not player or not groupId then
				return nil
			end
			local rank, roleName = lookupRole(player, groupId)
			if type(rank) ~= "number" or rank <= 0 then
				return nil
			end
			memberCount += 1
			if type(roleName) ~= "string" or roleName == "" then
				roleName = "rank " .. tostring(rank)
			end
			local scope = string.lower(tostring(Library.Flags.staff_alert_scope or ""))
			if string.find(scope, "any", 1, true) or rank >= 255 or isStaffRole(roleName) then
				return roleName
			end
			return nil
		end

		local function destroyCard(player)
			local card = cards[player]
			if card then
				pcall(function()
					card:Destroy()
				end)
				cards[player] = nil
			end
		end

		local function wipeCards()
			for player in pairs(cards) do
				destroyCard(player)
			end
			for k in pairs(dismissed) do
				dismissed[k] = nil
			end
		end

		local function createCard(player, roleName)
			if not player or cards[player] or dismissed[player.UserId] then
				return
			end
			cards[player] = Bridge.NotifyAvatar({
				Title = "Staff Alert",
				Description = player.DisplayName .. " (@" .. player.Name .. ")\n" .. string.upper(roleName),
				Persist = true,
				Closable = true,
				Callback = function(reason)
					if reason == "user" then
						dismissed[player.UserId] = true
					end
					cards[player] = nil
				end,
			}, player.UserId)
		end

		local function scanPlayer(player, notifyJoin)
			if not player or player == LocalPlayer or not currentGroupId then
				return
			end
			task.spawn(function()
				local roleName = getStaffRole(player, currentGroupId)
				if roleName then
					if staffAlertMethod() == "Kick" then
						staffKick(player)
						return
					end
					createCard(player, roleName)
				end
			end)
		end

		local function scanAll(notifySummary)
			if not currentGroupId then
				wipeCards()
				return
			end
			local present = {}
			memberCount = 0
			for _, player in ipairs(PlayersSvc:GetPlayers()) do
				if player ~= LocalPlayer then
					present[player] = true
					scanPlayer(player, false)
				end
			end
			for player in pairs(cards) do
				if not present[player] then
					destroyCard(player)
				end
			end
			if notifySummary and staffAlertMethod() ~= "Kick" then
				task.delay(4, function()
					if not currentGroupId then
						return
					end
					local n = 0
					for _ in pairs(cards) do
						n += 1
					end
					if n > 0 then
						staffNotify("Staff Alert", n .. " staff in server", 6)
					else
						staffNotify("Staff Alert", "no staff in server (" .. tostring(memberCount) .. " group members found)", 4)
					end
				end)
			end
		end

		local spyLabel
		local function setSpyText(text)
			pcall(function()
				if spyLabel and type(spyLabel.SetText) == "function" then
					spyLabel:SetText(text)
				end
			end)
		end

		local inputGen = 0
		local function applyGroupId(raw, notifySummary)
			groupGen += 1
			local my = groupGen
			local parsed = tonumber(tostring(raw or ""):match("%d+"))
			if not parsed then
				currentGroupId = nil
				wipeCards()
				setSpyText("Spying on —")
				return
			end
			currentGroupId = parsed
			wipeCards()
			setSpyText("Spying on …")
			task.spawn(function()
				local name
				if GroupService then
					local ok, info = pcall(function()
						return GroupService:GetGroupInfoAsync(parsed)
					end)
					if ok and type(info) == "table" then
						name = info.Name
					end
				end
				if my ~= groupGen then
					return
				end
				setSpyText("Spying on " .. tostring(name or ("group " .. tostring(parsed))))
				scanAll(notifySummary)
			end)
		end

		StaffAlertSec:Dropdown({
			Name = "Method",
			Flag = "staff_alert_method",
			Items = { "Notification", "Kick" },
			Default = "Notification",
			Callback = function(v)
				if type(v) == "table" then
					v = v[1] or v.Name or v.Value or v.Selected
				end
				v = tostring(v or "Notification")
				if flags then
					flags.staff_alert_method = v
				end
				if Library and Library.Flags then
					Library.Flags.staff_alert_method = v
				end
			end,
		})
		StaffAlertSec:Textbox({
			Name = "Group Id",
			Flag = "staff_alert_group_id",
			Default = "",
			Placeholder = "group id",
			Numeric = true,
			Callback = function(v)
				flags.staff_alert_group_id = tostring(v or "")
				if Library and Library.Flags then
					Library.Flags.staff_alert_group_id = tostring(v or "")
				end
				inputGen += 1
				local my = inputGen
				task.delay(0.4, function()
					if my ~= inputGen then
						return
					end
					applyGroupId(v, true)
				end)
			end,
		})
		spyLabel = StaffAlertSec:Label({ Name = "Spying on —" })
		StaffAlertSec:Dropdown({
			Name = "Detect",
			Flag = "staff_alert_scope",
			Items = { "Staff roles", "Any member" },
			Default = "Staff roles",
			Callback = function()
				if currentGroupId then
					wipeCards()
					scanAll(true)
				end
			end,
		})

		addedConn = PlayersSvc.PlayerAdded:Connect(function(player)
			scanPlayer(player, true)
		end)
		removingConn = PlayersSvc.PlayerRemoving:Connect(function(player)
			if player then
				dismissed[player.UserId] = nil
				destroyCard(player)
			end
		end)

		_G.__FridayOmegaCleanup = _G.__FridayOmegaCleanup or {}
		table.insert(_G.__FridayOmegaCleanup, function()
			currentGroupId = nil
			wipeCards()
			if addedConn then
				pcall(function()
					addedConn:Disconnect()
				end)
				addedConn = nil
			end
			if removingConn then
				pcall(function()
					removingConn:Disconnect()
				end)
				removingConn = nil
			end
			if staffGui then
				pcall(function()
					staffGui:Destroy()
				end)
				staffGui = nil
			end
			if _G.__FridayStaffAlertGui then
				pcall(function()
					_G.__FridayStaffAlertGui:Destroy()
				end)
				_G.__FridayStaffAlertGui = nil
			end
		end)

		task.defer(function()
			local existing = Library.Flags and Library.Flags.staff_alert_group_id
			if existing and tostring(existing) ~= "" then
				applyGroupId(existing, true)
			end
		end)
	end
end

do
    local IND_ICONS = {
        "rbxassetid://11716557686", "rbxassetid://11716560177", "rbxassetid://11722865980",
