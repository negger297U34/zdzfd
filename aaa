        (gameRemotes and gameRemotes:FindFirstChild("MainGameEvent"))
        or (mainRemotes and mainRemotes:FindFirstChild("MainRemoteEvent"))

    if exact and exact:IsA("RemoteEvent") then
        return exact
    end

    local fallback
    for _, object in ipairs(ReplicatedStorage:GetDescendants()) do
        if object:IsA("RemoteEvent") then
            fallback = fallback or object
            local name = object.Name:lower()
            if name:find("main", 1, true)
