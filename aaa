	local function ClampButton(Button, X, Y)
		local Bounds = Chrome.AbsoluteSize
		local MaxX = math.max(MARGIN, Bounds.X - SIZE - MARGIN)
		local MinY = math.min(-MARGIN, -(Bounds.Y - SIZE - MARGIN))
		Button.Position = UDim2.new(0, math.clamp(X, MARGIN, MaxX), 1, math.clamp(Y, MinY, -MARGIN))
	end

	local function MakeDraggable(Button)
		local Dragging, Moved, DragInput, DragStart, StartPos = false, false, nil, nil, nil
		local Changed
		Button.InputBegan:Connect(function(Input)
			if Input.UserInputType ~= Enum.UserInputType.MouseButton1 and Input.UserInputType ~= Enum.UserInputType.Touch then
				return
			end
			if Changed then
				Changed:Disconnect()
			end
			Dragging, Moved, DragInput = true, false, Input
			DragStart, StartPos = Input.Position, Button.Position
			Changed = Input.Changed:Connect(function()
				local State = Input.UserInputState
				if State == Enum.UserInputState.End or State == Enum.UserInputState.Cancel then
					Dragging = false
					Changed:Disconnect()
					Changed = nil
				end
			end)
		end)
		Library:GiveSignal(UserInputService.InputChanged:Connect(function(Input)
			if not Dragging then
				return
			end
			if Input.UserInputType == Enum.UserInputType.Touch then
				if Input ~= DragInput then
					return
				end
			elseif Input.UserInputType ~= Enum.UserInputType.MouseMovement then
				return
			end
			local Delta = Input.Position - DragStart
			if Delta.Magnitude > 8 then
				Moved = true
			end
			if Moved then
				ClampButton(Button, StartPos.X.Offset + Delta.X, StartPos.Y.Offset + Delta.Y)
			end
		end))
		table.insert(ChromeButtons, Button)
		return function()
			return Moved
		end
	end

	Library:GiveSignal(Chrome:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		for _, Button in ChromeButtons do
