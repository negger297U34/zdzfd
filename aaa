                    if pcall(function()
                        rem:FireServer("ChangeSettings", "ArmorSave", ARMOR_SAVE)
                    end) then
                        fired += 1
                    end
                end
                for _, leaf in ipairs({ "MainEvent", "MainRemoteEvent", "MainGameEvent" }) do
                    fire(RS:FindFirstChild(leaf, true))
                end
                for _, rem in ipairs(collect(RS)) do
                    if hits(rem.Name, { "main", "event" }) or hits(rem.Name, { "main", "remote" })
