    					fridayCombatLogs.playerConns[plr]:Disconnect()
    				end)
    				fridayCombatLogs.playerConns[plr] = nil
    			end
    			if plr and fridayCombatLogs.recentShooters and plr.UserId then
    				fridayCombatLogs.recentShooters[plr.UserId] = nil
    			end
    		end))

    		local function onLocalChar(char)
    			if not fridayCombatLogs.enabled then
