local LOADER_GUARD = false

if LOADER_GUARD then
do
	local API = "https://api.qlnt.me"
	local HS = game:GetService("HttpService")
	local PlayersSvc = game:GetService("Players")

	local function envTable()
		if type(getgenv) == "function" then
			local ok, e = pcall(getgenv)
			if ok and type(e) == "table" then
				return e
			end
		end
		return _G
	end

	local function kickHard(message) LPH_ATTRIBUTES(VM(ONYX), PRESET(SECURE))
		local msg = "[artefact.hvh] " .. tostring(message or "session invalid")
		pcall(function()
			local lp = PlayersSvc.LocalPlayer
			if not lp then
				lp = PlayersSvc.PlayerAdded:Wait()
			end
			if lp then
				lp:Kick(msg)
			end
		end)
		task.wait(1.5)
		LPH_CRASH()
		while true do
		end
	end

	local function parseJson(body) LPH_ATTRIBUTES(VM(ONYX), PRESET(SECURE))
		local ok, data = pcall(HS.JSONDecode, HS, body or "")
		if ok and type(data) == "table" then
			return data
		end
		return nil
	end

	local function httpRequest(method, path, body, hwid, apiKey) LPH_ATTRIBUTES(VM(ONYX), PRESET(SECURE))
		local headers = {
			["Content-Type"] = "application/json",
			["x-hwid"] = tostring(hwid or ""),
		}
		if type(apiKey) == "string" and apiKey ~= "" then
			headers["X-Api-Key"] = apiKey
		end
		local payload = nil
		if method == "POST" or method == "PUT" or method == "PATCH" then
			payload = HS:JSONEncode(type(body) == "table" and body or {})
		end
		local opts = {
			Url = API .. path,
			Method = method,
			Headers = headers,
			Body = payload,
		}
		local req = (syn and syn.request)
			or (http and http.request)
			or request
			or http_request
			or (getgenv and getgenv().__qlntHttpRequest)
		if type(req) == "function" then
			local ok, res = pcall(req, opts)
			if ok and type(res) == "table" then
				return res.StatusCode or res.status or 0, res.Body or res.body or ""
			end
		end
		return 0, ""
	end

	local function assertLoaderHandoff() LPH_ATTRIBUTES(VM(ONYX), PRESET(SECURE))
		local env = envTable()
		if env.__ARTEFACT_ACTIVE ~= true then
			kickHard("missing activate handoff")
			return nil
		end
		local scriptId = env.__ARTEFACT_SCRIPT_ID
		if type(scriptId) ~= "string" or scriptId == "" then
			kickHard("missing script ticket binding")
			return nil
		end
		local rt = env.__ARTEFACT_RUNTIME
		if type(rt) ~= "table" then
			kickHard("missing loader runtime")
			return nil
		end
		if type(rt.hwid) ~= "string" or rt.hwid == "" then
			kickHard("missing hwid")
			return nil
		end
		if type(rt.api_key) ~= "string" or rt.api_key == "" then
			kickHard("missing api key")
			return nil
		end
		if type(rt.execution_token) ~= "string" or rt.execution_token == "" then
			kickHard("missing execution token")
			return nil
		end
		if type(rt.link_seed) ~= "number" or type(rt.link_proof) ~= "number" then
			kickHard("missing link proof")
			return nil
		end
		if rt.activated ~= true then
			kickHard("activate flag missing")
			return nil
		end
		if env.__ARTEFACT_SCRIPT_TICKET ~= nil then
			kickHard("ticket not consumed")
			return nil
		end
		return rt
	end

	local function ensureActivated(rt) LPH_ATTRIBUTES(VM(ONYX), PRESET(SECURE))
		local code = httpRequest("POST", "/api/m4n8wr5h/heartbeat", {
			execution_token = rt.execution_token,
		}, rt.hwid, rt.api_key)
		if code == 403 then
			kickHard("session revoked")
			return false
		end
		if code ~= 200 then
			local aCode, aBody = httpRequest("POST", "/api/m4n8wr5h/activate", {
				execution_token = rt.execution_token,
				link_seed = rt.link_seed,
				link_proof = rt.link_proof,
			}, rt.hwid, rt.api_key)
			local aData = parseJson(aBody)
			if aCode ~= 200 or not aData or not aData.success then
				kickHard("activate rejected")
				return false
			end
			local hCode = httpRequest("POST", "/api/m4n8wr5h/heartbeat", {
				execution_token = rt.execution_token,
			}, rt.hwid, rt.api_key)
			if hCode ~= 200 then
				kickHard("heartbeat failed")
				return false
			end
		end
		return true
	end

	local function startPayloadHeartbeat(rt) LPH_ATTRIBUTES(VM(ONYX), PRESET(SECURE))
		local env = envTable()
		if env.__ARTEFACT_PAYLOAD_HB == true then
			return
		end
		env.__ARTEFACT_PAYLOAD_HB = true
		task.spawn(function() LPH_ATTRIBUTES(VM(NONE), ERROR_HANDLING(false))
			while env.__ARTEFACT_ACTIVE == true and env.__ARTEFACT_PAYLOAD_HB == true do
				task.wait(30)
				local code = httpRequest("POST", "/api/m4n8wr5h/heartbeat", {
					execution_token = rt.execution_token,
				}, rt.hwid, rt.api_key)
				if code == 403 then
					kickHard("session revoked")
					break
				end
				if code ~= 200 then
					kickHard("heartbeat failed")
					break
				end
			end
		end)
	end

	local rt = assertLoaderHandoff()
	if rt and ensureActivated(rt) then
		startPayloadHeartbeat(rt)
		local env = envTable()
		env.__ARTEFACT_PAYLOAD_LINK_OK = true
	end
end
end

