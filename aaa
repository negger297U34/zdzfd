    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local tool = getAnyGun(character, backpack)
    local handle = tool and tool:FindFirstChild("Handle")
    local ammo = tool and (tool:FindFirstChild("Ammo") or tool:FindFirstChild("ammo"))

    if ammo and not usableAmmo(tool, ammo) then
        tool = waitForUsableGun(0.9)
        handle = tool and tool:FindFirstChild("Handle")
        ammo = tool and (tool:FindFirstChild("Ammo") or tool:FindFirstChild("ammo"))
        if not tool or not handle or (ammo and not usableAmmo(tool, ammo)) then
            return false
        end
    end

    if humanoid == nil or humanoid.Health <= 0 or tool == nil or handle == nil then
        return false
    end

    local targetCharacter = player and player.Character
    local targetHumanoid = targetCharacter
        and targetCharacter:FindFirstChildOfClass("Humanoid")
    local head = targetCharacter and (
        targetCharacter:FindFirstChild("Head")
        or targetCharacter:FindFirstChild("HumanoidRootPart")
    )

    if targetCharacter == nil
        or targetHumanoid == nil
        or targetHumanoid.Health <= 0
        or head == nil
    then
        return false
    end

    local aimPos = head.Position
    pcall(function()
        tool.Enabled = true
        if tool.Parent ~= character then
            humanoid:EquipTool(tool)
        end
    end)
    if tool.Parent ~= character then
        pcall(function()
            tool.Parent = character
        end)
    end
    handle = tool:FindFirstChild("Handle") or handle
    if not handle then
        return false
    end

    local bag = rawget(_G, "_900")
    local remote = (type(bag) == "table" and bag.lastShootGunRemote)
        or KillAllRemote
    local args = type(bag) == "table" and bag.lastShootGunArgs
    local sent = false

    if remote and type(args) == "table" and args[1] == "ShootGun" then
        local out = {}
        for i = 1, #args do
            out[i] = args[i]
        end
        if typeof(out[2]) == "Vector3" and typeof(out[3]) == "Vector3" then
            out[3] = aimPos
            if typeof(out[4]) == "Instance" then
                out[4] = head
            end
        elseif typeof(out[2]) == "Vector3" then
            out[2] = aimPos
            if typeof(out[3]) == "Instance" then
                out[3] = head
            end
        elseif #out >= 5 then
            out[4] = aimPos
            out[5] = head
        end
        if flags.ta_inf_range == true then
            if #out >= 7 and type(out[7]) == "number" then
                out[7] = 99999
            end
        elseif #out >= 7 and type(out[7]) == "number" and out[7] >= 9000 then
            local dist = 100
            local o, a = out[2], out[3]
            if typeof(o) == "Vector3" and typeof(a) == "Vector3" then
                dist = (a - o).Magnitude
            elseif typeof(out[3]) == "Vector3" and typeof(out[4]) == "Vector3" then
                dist = (out[4] - out[3]).Magnitude
            end
            out[7] = dist
        end
        for _ = 1, 1 do
            if pcall(function()
                remote:FireServer(table.unpack(out))
            end) then
                sent = true
            end
        end
    end

    if not sent and remote then
        local origin = handle.Position
        local pellets = {}
        for _ = 1, 20 do
            pellets[#pellets + 1] = {
                AimPosition = aimPos,
                Result1 = aimPos,
                Result2 = head,
                Result3 = Vector3.yAxis,
            }
        end
        local damageObject = tool:FindFirstChild("Damage")
        local damage = damageObject and damageObject.Value or 50
        local layouts
        if flags.ta_inf_range == true then
            layouts = {
                { "ShootGun", handle, origin, pellets, nil, nil, nil, math.huge, damage },
                { "ShootGun", origin, aimPos, head, 99999 },
                { "ShootGun", aimPos, head, 99999 },
                { "ShootGun", origin, aimPos, head, tool, 99999 },
                { "ShootGun", tool, origin, aimPos, head, 99999 },
            }
        else
            layouts = {
                { "ShootGun", handle, origin, pellets },
                { "ShootGun", origin, aimPos, head },
                { "ShootGun", aimPos, head },
                { "ShootGun", origin, aimPos, head, tool },
                { "ShootGun", tool, origin, aimPos, head },
            }
        end
        for _, layout in ipairs(layouts) do
            if pcall(function()
                remote:FireServer(table.unpack(layout))
            end) then
                sent = true
                break
            end
        end
    end

    pcall(function()
        if tool.Activate then
            tool:Activate()
        end
    end)

    return sent == true
end

local function sentryAimIsTargetAim()
