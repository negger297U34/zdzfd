    function fridayPosLockAcquire(reason)
    	local pl = friday.PosLock
    	local was = pl.depth or 0
    	pl.depth = was + 1
    	pl.reason = reason or pl.reason or 'pos'
    	_613 = true
    	if was == 0 and type(fridayPosHomePush) == 'function' then
    		if reason ~= 'goto' then
    			fridayPosHomePush(reason or 'pos')
    		end
    	elseif was > 0 and reason and reason ~= 'goto' and type(fridayPosHomePush) == 'function' then
    		fridayPosHomePush(reason)
    	end
    	if pl.depth == 1 then
    		pcall(function()
    			if type(_760) == 'function' then
    				_760()
    			end
    		end)
    	end
    end

    function fridayPosLockRelease(reason)
    	local pl = friday.PosLock
    	if (pl.depth or 0) <= 0 then
    		_613 = false
    		return
    	end
    	pl.depth = pl.depth - 1
    	if type(fridayPosHomePop) == 'function' and reason ~= 'goto' then
    		fridayPosHomePop(reason, pl.depth <= 0)
    	end
    	if pl.depth <= 0 then
    		pl.depth = 0
    		pl.reason = nil
    		_613 = false
    	end
    end

    function fridayPosLockWait(maxSec)
    	maxSec = maxSec or 10
    	local t0 = tick()
    	while fridayPosLockBusyExceptBuy() and tick() - t0 < maxSec do
