local function requestAmmoRefill(tool, ammo, force)
    if tool == nil then
        return false
    end
    if force == true then
        _G.__FridayLoadoutRefillBusy = false
    end
    if force ~= true then
        local stopUntil = tonumber(rawget(_G, "__FridayAssaultStopUntil")) or 0
        if (stopUntil > 0 and os.clock() < stopUntil) or _G.__FridayAssaultStoppingLive() then
            return false
        end
    end
    local shared = rawget(_G, "__FridayOmegaLoadoutRefill")
        or rawget(_G, "__FridayOmegaInfAmmoSwitch")
        or rawget(_G, "__FridayOmegaAssaultSwitch")
    if type(shared) == "function" then
        if force ~= true and loadoutRefillBusy() then
            return false
        end
        pcall(shared, tool, force == true)
        return true
    end
    if force ~= true and loadoutRefillBusy() then
        return false
    end
    if LoadoutRemote == nil or not LoadoutRemote.Parent then
        LoadoutRemote = findLoadoutRemote()
    end
    if LoadoutRemote == nil
        or refillActive
        or tool == nil
        or ammo == nil
        or ammo:GetAttribute("FridaySentryRefillRequested")
    then
        return false
    end

    local character = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack == nil then
        return false
    end

    ammo:SetAttribute("FridaySentryRefillRequested", true)
    refillActive = true
    _G.__FridayLoadoutRefillBusy = true
    _G.__FridayLoadoutRefillBusyAt = os.clock()

    local requestedName = tool.Name
    local oldTools = {}
    local equippedTools = {}
    local newestTools = {}
    local seenTools = {}

    for _, container in ipairs({ backpack, character }) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") and Guns[item.Name] then
                    oldTools[item] = true
                    if item.Parent == character then
                        equippedTools[item.Name] = true
                    end
                end
            end
        end
    end

    local connections = {}
    local heartbeat
    local stopped = false
    local deadline = os.clock() + 2
    local lastAdded = os.clock()

    local function stop()
        if stopped then
            return
        end
        stopped = true
        for _, connection in ipairs(connections) do
            pcall(function()
                connection:Disconnect()
            end)
        end
        if heartbeat then
            pcall(function()
                heartbeat:Disconnect()
            end)
        end
        if not newestTools[requestedName] and ammo.Parent then
            ammo:SetAttribute("FridaySentryRefillRequested", nil)
        end
        refillActive = false
        _G.__FridayLoadoutRefillBusy = false
    end

    local function accept(item)
        if not item:IsA("Tool")
            or not Guns[item.Name]
            or oldTools[item]
            or seenTools[item]
        then
            return
        end
        seenTools[item] = true
        lastAdded = os.clock()
        local name = item.Name
        local previous = newestTools[name]
        if previous and previous ~= item and previous.Parent then
            pcall(function()
                previous:Destroy()
            end)
        end
        newestTools[name] = item
        for oldTool in pairs(oldTools) do
            if oldTool.Name == name and oldTool.Parent then
                pcall(function()
                    oldTool:Destroy()
                end)
            end
        end
        if equippedTools[name] and character and item.Parent then
            if rawget(_G, "__FridaySentryHolsterAfterRefill") ~= true then
                pcall(function()
                    item.Parent = character
                end)
            end
        end
    end

    connections[1] = backpack.ChildAdded:Connect(accept)
    if character then
        connections[2] = character.ChildAdded:Connect(accept)
    end

    pcall(function()
        LoadoutRemote:FireServer(Loadout)
    end)

    heartbeat = RunService.Heartbeat:Connect(function() LPH_ATTRIBUTES(VM(NONE))
        local now = os.clock()
        if now >= deadline or (next(newestTools) and now - lastAdded >= 0.2) then
            stop()
        end
    end)

    return true
end

