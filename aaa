	local function ResolvePlayer(Query)
		Query = type(Query) == "string" and (Query:match("^%s*(.-)%s*$") or "") or ""
		if Query == "" then
			return nil
		end
		local Q = Query:lower()
		local AsId = tonumber(Query)
		local Best, BestScore = nil, 0
		for _, Plr in Players:GetPlayers() do
			if Plr ~= LP then
				if AsId and Plr.UserId == AsId then
					return Plr
				end
				local Name, Display = Plr.Name:lower(), Plr.DisplayName:lower()
				local Score = 0
				if Name == Q or Display == Q then
					Score = 100
				elseif Name:sub(1, #Q) == Q or Display:sub(1, #Q) == Q then
					Score = 80
				elseif Name:find(Q, 1, true) or Display:find(Q, 1, true) then
					Score = 50
				end
				if Score > BestScore then
					Best, BestScore = Plr, Score
				end
			end
		end
		return Best
	end

	local function RunAction(ActionName, Targets)
		local Actions = _G.__FridayOmegaTaActions
		if type(Actions) ~= "table" or type(Actions[ActionName]) ~= "function" then
			Notify("backend combat non chargé (" .. tostring(ActionName) .. ")")
			return false
		end

		_G.__FridayCmdOverrideGen = (_G.__FridayCmdOverrideGen or 0) + 1
		local Gen = _G.__FridayCmdOverrideGen
		_G.__FridayCmdOverrideTargets = Targets

		local T0 = tick()
		while _G.__FridayTaActBusy == true and tick() - T0 < 2.5 do
			task.wait(0.05)
		end

		local IsLoop = ActionName == "loopKill" or ActionName == "loopKnock" or ActionName == "loopBring" or ActionName == "loopFling"
		local Ok, Err = pcall(Actions[ActionName])
		task.spawn(function()
			local Start = tick()
			if IsLoop then
				while _G.__FridayCmdOverrideGen == Gen and _G.__FridayTaActBusy ~= true and tick() - Start < 2 do
					task.wait(0.05)
				end
				while _G.__FridayCmdOverrideGen == Gen and _G.__FridayTaActBusy == true do
					task.wait(0.1)
				end
			else
				while _G.__FridayCmdOverrideGen == Gen and _G.__FridayTaActBusy == true and tick() - Start < 45 do
					task.wait(0.05)
				end
				task.wait(0.05)
			end
			if _G.__FridayCmdOverrideGen == Gen and _G.__FridayCmdOverrideTargets == Targets then
				_G.__FridayCmdOverrideTargets = nil
			end
		end)
		if not Ok then
			Notify("cmd failed: " .. tostring(Err), 3)
		end
		return Ok
	end

