        local style = styleNow()
        if style == "Selected" then
            local lp = game:GetService("Players").LocalPlayer
            local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
            local origin = (typeof(strafeState.cf) == "CFrame" and strafeState.cf.Position)
                or (myRoot and myRoot.Position)
            local cur = currentLive()
            if cur then
                if type(_G.__FridayOmegaTaIsSelected) == "function" then
                    local ok, sel = pcall(_G.__FridayOmegaTaIsSelected, cur)
                    if ok and sel then
                        return cur
                    end
                else
                    return cur
                end
            end
            if type(_G.__FridayOmegaTaSelectedPool) == "function" then
                local ok, pool = pcall(_G.__FridayOmegaTaSelectedPool)
                if ok and type(pool) == "table" then
                    local best, bestD = nil, math.huge
                    for _, plr in ipairs(pool) do
                        local live = alivePlr(plr)
                        local hrp = live and live.Character and (
                            live.Character:FindFirstChild("HumanoidRootPart")
                            or live.Character:FindFirstChild("Head")
                        )
                        if live and hrp then
                            local d = origin and (hrp.Position - origin).Magnitude or 0
                            if d < bestD then
                                bestD, best = d, live
                            end
                        end
                    end
                    if best then
                        return best
                    end
                end
            end
            return nil
        end
        if style == "Everyone" then
            local cur = currentLive()
            if cur then
                return cur
            end
            if type(_G.__FridayOmegaTaPick) == "function" then
                local ok, pick = pcall(_G.__FridayOmegaTaPick)
                if ok then
                    local live = alivePlr(pick)
                    if live then
                        return live
                    end
                end
            end
            local best, bestD = nil, math.huge
            local cam = workspace.CurrentCamera
            local lp = game:GetService("Players").LocalPlayer
            local origin = cam and cam.ViewportSize and (cam.ViewportSize * 0.5) or Vector2.new(0, 0)
            for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
                if plr ~= lp then
                    local live = alivePlr(plr)
                    local head = live and live.Character and live.Character:FindFirstChild("Head")
                    if head and cam then
                        local pos, on = cam:WorldToScreenPoint(head.Position)
                        if on then
                            local d = (origin - Vector2.new(pos.X, pos.Y)).Magnitude
                            if d < bestD then
                                bestD, best = d, live
                            end
                        end
                    end
                end
            end
            return best
