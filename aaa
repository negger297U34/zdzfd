local function Toggle(Box, Flag, Text, Default)
	FeatureFlags[Flag] = true
	return Box:AddToggle(Flag, { Text = Text, Default = Default == true })
end

local function Slider(Box, Flag, Text, Default, Min, Max, Rounding)
	FeatureFlags[Flag] = true
	return Box:AddSlider(Flag, {
		Text = Text,
		Default = Default,
		Min = Min,
		Max = Max,
		Rounding = Rounding or 0,
	})
end

local function Dropdown(Box, Flag, Text, Values, Default, Multi)
	FeatureFlags[Flag] = true
	local Dropdown = Box:AddDropdown(Flag, {
		Text = Text,
		Values = Values,
		Default = (not Multi and Default ~= "") and Default or nil,
		Multi = Multi == true,
		Searchable = #Values > 8,
	})

	if Multi and typeof(Default) == "table" and #Default > 0 then
		local Selected = {}
		for _, Value in Default do
			Selected[Value] = true
		end
		Options[Flag]:SetValue(Selected)
	end

	return Dropdown
end

local function PlayerDropdown(Box, Flag, Text)
	FeatureFlags[Flag] = true
	return Box:AddDropdown(Flag, {
		Text = Text,
		SpecialType = "Player",
		ExcludeLocalPlayer = true,
		Multi = true,
		Searchable = true,
		FormatDisplayValue = function(Value)
			return typeof(Value) == "Instance" and Value.DisplayName or tostring(Value)
		end,
		FormatListValue = function(Value)
			if typeof(Value) == "Instance" then
				return Value.DisplayName .. " (@" .. Value.Name .. ")"
			end
			return tostring(Value)
		end,
	})
end

local function Color(Parent, Flag, Title, Default)
	FeatureFlags[Flag] = true
	return Parent:AddColorPicker(Flag, { Title = Title, Default = Default })
end

local KeybindLinks = {}

local function Keybind(ToggleObj, Flag, Text)
	local Label = ToggleObj.TextLabel
	local Before = {}
	for _, Child in Label:GetChildren() do
		Before[Child] = true
	end

	ToggleObj:AddKeyPicker(Flag, {
		Text = Text,
		Default = "None",
		Mode = "Toggle",
		SyncToggleState = false,
	})
	table.insert(KeybindLinks, { Toggle = ToggleObj, Picker = Options[Flag], Flag = Flag })

	for _, Child in Label:GetChildren() do
		if not Before[Child] and Child:IsA("GuiButton") then
			Child.Visible = false
		end
	end

	local Entry = Library.KeybindToggles[#Library.KeybindToggles]
	if Entry and Entry.SetText then
		local SetText = Entry.SetText
		function Entry:SetText()
			SetText(self, Text)
		end
		Entry:SetText()
	end

	return ToggleObj
end

local function Textbox(Box, Flag, Text, Default, Placeholder)
	FeatureFlags[Flag] = true
	return Box:AddInput(Flag, {
		Text = Text,
		Default = Default or "",
		Placeholder = Placeholder or "",
		Finished = true,
