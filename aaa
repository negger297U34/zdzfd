					Notify({ Title = "Camera Lock", Description = "no target near the crosshair", Time = 2 })
				end
			end
		end,
		desync_key = function(State)
			_G.__FridayAaBindLive = State
		end,
		ta_strafe_key = function(State)
			if type(_G.__FridayStrafeSetLive) == "function" then
				pcall(_G.__FridayStrafeSetLive, State)
			end
		end,
		ta_sentry_key = function()
			if type(_G.__FridayOmegaSyncSentry) == "function" then
				pcall(_G.__FridayOmegaSyncSentry)
			end
		end,
		silent_aim_key = function()
			if type(_G.__FridayOmegaSyncSilent) == "function" then
				pcall(_G.__FridayOmegaSyncSilent)
			end
		end,
		self_emote_key = function(State)
			if Toggles.self_emote_active and Toggles.self_emote_active.Value ~= State then
				Toggles.self_emote_active:SetValue(State)
			end
		end,
	}

	local function KeyChanged(Flag, State)
		State = State == true
		local Hook = KeyHooks[Flag]
		if Hook then
			Call(Flag, Hook, State, KeyTables[Flag])
		end
		local Callbacks = KeyCallbacks[Flag]
		if Callbacks then
			for _, Callback in Callbacks do
				Call(Flag, Callback, KeyTables[Flag].Toggled)
			end
		end
	end

	local function FlagOf(Object)
		for Flag, Candidate in Toggles do
			if Candidate == Object then
				return Flag
			end
		end
