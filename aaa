    local function strafeStartMove()
        if strafeState.conn then
            return
        end
        local rs = game:GetService("RunService")
        strafeState.angle = 0
        strafeState.dir = 1
        strafeState.nextChange = 0
        strafeState.jitter = 0
        strafeState.lastTp = 0
        strafeState.lastTa = 0
        strafeState.live = true
        do
            local lp = game:GetService("Players").LocalPlayer
            local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
            if root then
                strafeState.homeCF = root.CFrame
                _G.__FridayStrafeRestoreCF = root.CFrame
                if typeof(strafeState.cf) ~= "CFrame" then
                    strafeState.cf = root.CFrame
                end
                if flags.ta_strafe_walkable == true then
                    strafeState.walkCF = root.CFrame
                    _G.__FridayStrafeRestoreCF = root.CFrame
                end
            end
        end
        strafeEnsureVis()
        strafeApplyLocalCharVis()
        if flags.ta_strafe_walkable == true then
            strafeClearMovers(false)
            strafeEnsureSetback()
            strafeBindWalk()
        end
        strafeState.conn = rs.Heartbeat:Connect(function(dt)
            if rawget(_G, "__FridayStrafeOn") ~= true or flags.ta_strafe ~= true then
                strafeStopMove()
                return
            end
            if rawget(_G, "__FridayStrafePaused") == true or rawget(_G, "__FridayTaStompGluing") == true then
                return
            end
            pcall(strafeKeepHeldGun)
            dt = tonumber(dt) or 0
            local lp = game:GetService("Players").LocalPlayer
            local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
            local tgt = strafeGetTarget()
            local tchar = tgt and tgt.Character
            local troot = tchar and (tchar:FindFirstChild("HumanoidRootPart") or tchar:FindFirstChild("Head"))
            local thum = tchar and tchar:FindFirstChildOfClass("Humanoid")
            if not root or not troot or not thum or thum.Health <= 0 then
                if flags.ta_strafe_walkable ~= true then
                    local home = strafeHomeCF()
                    if root and typeof(home) == "CFrame" then
                        strafeApplyHome(root, home)
                    end
                end
                strafeApplyLocalCharVis()
                strafeEnsureVis()
                strafeHideServerPos()
                _G.__FridayStrafeAimReady = false
                _G.__FridayStrafeTgtUid = nil
                strafeState.tgtUid = nil
                fridayStrafeDbg("hb", string.format(
                    "NO TARGET root=%s tgt=%s (bind/FOV empty — rebind Sticky or look at player)",
                    tostring(root ~= nil),
                    tostring(tgt and tgt.Name)
                ), 0.9)
                return
            end
            do
                local tool = lp.Character and lp.Character:FindFirstChildOfClass("Tool")
                if tool then
                    _G.__FridayStrafeHeldGun = tool.Name
                end
            end
            local walkable = flags.ta_strafe_walkable == true
            if walkable then
                if strafeState.bv or strafeState.bg then
                    strafeClearMovers(false)
                end
            else
                strafeDestroySetback()
                strafeEnsureMovers(root)
            end
            strafeApplyLocalCharVis()
            strafeEnsureVis()
            local tPos = troot.Position
            local myPos = root.Position
            local diff = myPos - tPos
            local dist = diff.Magnitude
            local speed = strafeFlagNum("ta_strafe_speed", 24)
            local radius = strafeFlagNum("ta_strafe_distance", 8)
            local height = strafeFlagNum("ta_strafe_height", 0)
            local jitterAmt = strafeFlagNum("ta_strafe_jitter", 0.2)
            local reverse = strafeFlagNum("ta_strafe_reverse", 30)
            local hVar = strafeFlagNum("ta_strafe_height_var", 2)
            local rVar = strafeFlagNum("ta_strafe_radius_var", 2.5)
            local wave = strafeFlagNum("ta_strafe_wave", 12)
            local smooth = math.clamp(strafeFlagNum("ta_strafe_smooth", 0.45), 0.05, 1)
            local dirMode = strafeFlagStr("ta_strafe_dir", "Auto")
            strafeState.nextChange = (strafeState.nextChange or 0) - dt
            if strafeState.nextChange <= 0 then
                strafeState.nextChange = 0.05 + math.random() * 0.08
                if dirMode == "Left" then
                    strafeState.dir = 1
                elseif dirMode == "Right" then
                    strafeState.dir = -1
                elseif math.random() * 100 < reverse then
                    strafeState.dir = -(strafeState.dir or 1)
                end
                strafeState.speedBurst = (math.random() > 0.5) and math.random(4, 10) or 0
                strafeState.radiusVar = (math.random() * 2 - 1) * rVar
                strafeState.heightVar = (math.random() * 2 - 1) * hVar
            end
            local targetJitter = (math.random() * 2 - 1) * 0.6 * (jitterAmt * 4)
            strafeState.jitter = (strafeState.jitter or 0) + (targetJitter - (strafeState.jitter or 0)) * 0.4
            local now = tick()
            local dynSpeed = speed + math.sin(now * 8) * (wave * 0.6) + math.cos(now * 5) * (wave * 0.45) + (strafeState.speedBurst or 0)
            local orbitFrom = walkable and (typeof(strafeState.cf) == "CFrame" and strafeState.cf.Position or tPos) or myPos
            local orbitDiff = orbitFrom - tPos
            local orbitDist = orbitDiff.Magnitude
            strafeState.angle = (strafeState.angle + (dynSpeed * (strafeState.dir or 1) + (strafeState.jitter or 0)) * dt) % 6.28318530718
            local radiusOffset = (orbitDist - radius) * 0.2 + (strafeState.radiusVar or 0)
            local dynRadius = math.clamp(radius + radiusOffset, math.max(1, radius - 5), radius + 5)
            local angJit = (math.random() * 2 - 1) * 0.5 * jitterAmt
            local radJit = (math.random() * 2 - 1) * rVar * 0.4
            local finalAngle = strafeState.angle + angJit
            local finalRadius = dynRadius + radJit
            local oY = height + (math.random() * 2 - 1) * 0.15 * hVar + (strafeState.heightVar or 0)
            local desiredPos = tPos + Vector3.new(math.cos(finalAngle) * finalRadius, oY, math.sin(finalAngle) * finalRadius)
            if math.random() < (0.12 * jitterAmt) then
                desiredPos = desiredPos + Vector3.new((math.random() * 2 - 1) * 4, (math.random() * 2 - 1) * 2, (math.random() * 2 - 1) * 4)
            end
            local desired = CFrame.lookAt(desiredPos, tPos)
            strafeState.cf = desired
            strafeUpdateServerPos(desired)
            strafeState.tgtPos = tPos
            strafeState.visRadius = radius
            do
                local uid = tgt.UserId
                if strafeState.tgtUid ~= uid then
                    local prevPos = strafeState.lastTgtPos
                    if typeof(prevPos) ~= "Vector3" then
                        prevPos = strafeState.lastCombatPos
                    end
                    if typeof(prevPos) ~= "Vector3" then
                        prevPos = root.Position
                    end
                    local jump = typeof(prevPos) == "Vector3" and (prevPos - tPos).Magnitude or 0
                    local ringMax = math.max(radius, 1) + 6.5
                    local orbitPos = (typeof(strafeState.cf) == "CFrame" and strafeState.cf.Position) or root.Position
                    local alreadyInRing = (orbitPos - tPos).Magnitude <= ringMax
                        or (root.Position - tPos).Magnitude <= ringMax
                    strafeState.tgtUid = uid
                    _G.__FridayStrafeTgtUid = uid
                    fridayStrafeArmChainSettle(jump, "retarget→" .. tostring(tgt.Name), alreadyInRing)
                else
                    _G.__FridayStrafeTgtUid = uid
                end
                strafeState.lastTgtPos = tPos
            end
            do
                local pts = strafeState.trailPts
                if type(pts) ~= "table" then
                    pts = {}
                    strafeState.trailPts = pts
                end
                pts[#pts + 1] = desiredPos
                while #pts > 12 do
                    table.remove(pts, 1)
                end
            end
            local ringSlack = 6.5
            local combatMax = math.max(radius, 1) + ringSlack
            local combatMin = math.max(0.2, radius - 6)
            local exitMax = combatMax + 2.5
            local approachGate = combatMax + 2
            local function strafeMarkAimReady()
                local livePos = root.Position
                if ((tonumber(rawget(_G, "__FridayStrafeChainUntil")) or 0) - tick()) > 0 then
                    _G.__FridayStrafeAimReady = false
                    return
                end
                if type(_G.__FridayTaPosInRange) == "function"
                    and not ((type(flags) == "table" and flags.ta_inf_range == true)
                        or (Library and Library.Flags and Library.Flags.ta_inf_range == true))
                    and not _G.__FridayTaPosInRange(tPos, livePos)
                then
                    _G.__FridayStrafeAimReady = false
                    return
                end
                _G.__FridayStrafeAimReady = true
                _G.__FridayMoveSettleUntil = 0
                strafeState.peakApproach = 0
                strafeState.stableFrames = 0
                strafeState.chainCovered = false
                strafeState.softRetarget = false
                strafeState.lastCombatPos = livePos
            end
            if walkable then
                strafePushPad()
                strafeMarkAimReady()
                return
            end
            strafeUnbindWalk()
            strafeDestroySetback()
            if dist > approachGate then
                local unit = diff.Magnitude > 0.05 and diff.Unit or Vector3.new(0, 0, 1)
                local closePos = tPos + unit * math.max(1, radius)
                strafeState.peakApproach = math.max(tonumber(strafeState.peakApproach) or 0, dist)
                strafeState.stableFrames = 0
                root.CFrame = root.CFrame:Lerp(CFrame.lookAt(closePos, tPos), math.clamp(smooth + 0.45, 0.35, 1))
                strafeMarkAimReady()
            else
                root.CFrame = root.CFrame:Lerp(desired, math.clamp(smooth + 0.15, 0.2, 1))
                strafeMarkAimReady()
            end
            if strafeState.bv and strafeState.bv.Parent then
                local toTgt = tPos - myPos
                if toTgt.Magnitude > 0.05 then
                    strafeState.bv.Velocity = toTgt.Unit * (dynSpeed + (math.random() * 10 - 5))
                end
            end
            if strafeState.bg and strafeState.bg.Parent then
                strafeState.bg.CFrame = CFrame.lookAt(myPos, tPos)
            end
        end)
    end

    local function strafeSetLive(on)
        on = on == true and flags.ta_strafe == true
        local wasOn = rawget(_G, "__FridayStrafeOn") == true
        strafeState.live = on
        _G.__FridayStrafeOn = on
        fridayStrafeDbg("live", "strafeSetLive on=" .. tostring(on)
            .. " walkable=" .. tostring(flags.ta_strafe_walkable == true)
            .. " asFlag=" .. tostring(flags.ta_auto_shoot == true)
            .. " infRange=" .. tostring(flags.ta_inf_range == true), 0)
        if on then
            strafeState.cleanupGen = (tonumber(strafeState.cleanupGen) or 0) + 1
            local lastOff = tonumber(strafeState.lastOffAt) or 0
            local rapidRe = wasOn ~= true and lastOff > 0 and (tick() - lastOff) < 2.8
            strafeCaptureHeldGun()
            _G.__FridayStrafeNeedBind = true
            if type(_G.__FridayOmegaTaOnKeybind) == "function" then
                pcall(_G.__FridayOmegaTaOnKeybind, true)
            else
                _G.__FridayTaPendingOn = true
            end
            _G.__FridayStrafeNeedBind = nil
            if rapidRe then
                local lp = game:GetService("Players").LocalPlayer
