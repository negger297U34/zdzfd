	local function keybindSwitchColor(a, b, phase)
		phase = phase % 1
		local white = Color3.new(1, 1, 1)
		local cycle = phase * 4
		local seg = math.floor(cycle) % 4
		local u = cycle % 1
		if seg == 0 then
			return a:Lerp(white, u)
		elseif seg == 1 then
			return white:Lerp(b, u)
		elseif seg == 2 then
			return b:Lerp(white, u)
		end
		return white:Lerp(a, u)
	end

