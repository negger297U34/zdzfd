    	local function fridayCombatLogsPointSegDist(p, a, b)
    		local ab = b - a
    		local denom = ab:Dot(ab)
    		if denom < 1e-6 then
    			return (a - p).Magnitude
    		end
    		local t = math.clamp((p - a):Dot(ab) / denom, 0, 1)
    		return ((a + ab * t) - p).Magnitude
    	end

    	local function fridayCombatLogsAimScore(plr, hrp)
    		if not plr or not plr.Character or not hrp then
    			return nil
    		end
    		local th = plr.Character:FindFirstChild('HumanoidRootPart')
    		local head = plr.Character:FindFirstChild('Head')
    		local tool = plr.Character:FindFirstChildOfClass('Tool')
    		if not th or not head then
    			return nil
    		end
    		local toMe = hrp.Position - th.Position
    		local dist = toMe.Magnitude
    		if dist < 2 or dist > 900 then
    			return nil
    		end
    		local myHead = lp.Character and lp.Character:FindFirstChild('Head')
    		local be = plr.Character:FindFirstChild('BodyEffects')
    		local mp = be and be:FindFirstChild('MousePos')
    		if mp and myHead then
    			local ok, v = pcall(function()
    				return mp.Value
    			end)
    			if ok and typeof(v) == 'Vector3' then
    				local mouseDist = (v - myHead.Position).Magnitude
    				if mouseDist > 10 then
    					return nil
    				end
    				local score = mouseDist * 0.45 + math.min(dist, 800) * 0.002
    				if not tool then
    					score += 6
    				end
    				return score, dist, 1
    			end
    		end
    		local dir = toMe.Unit
    		local look = head.CFrame.LookVector
    		local rootLook = th.CFrame.LookVector
    		local dot = math.max(look:Dot(dir), rootLook:Dot(dir))
    		if dot < 0.92 then
    			return nil
    		end
    		local hasTool = tool ~= nil
    		local score = (1 - dot) * 40 + math.min(dist, 800) * 0.002
    		if not hasTool then
    			score += 6
    		end
    		return score, dist, dot
    	end

