	function Section:Dropdown(Args)
		Args = Args or {}
		local Flag = Args.Flag or Args.Name
		local Entry = Bind(Flag)
		local Api = {}

		if Entry and Entry.Element.Type == "Dropdown" then
			local Element = Entry.Element
			local IsPlayer = Element.SpecialType == "Player"
			if Args.Callback then
				table.insert(Entry.Callbacks, Args.Callback)
			end

			function Api:Refresh(Items)
				if IsPlayer then
					return
				end
				local List = {}
				for _, Item in ipairs(Items or {}) do
					table.insert(List, tostring(Item))
				end
				Quiet(Entry, function()
					Element:SetValues(List)
					if not Element.Multi and Element.Value == nil and List[1] ~= nil then
						Element:SetValue(List[1])
					end
				end)
				Fire(Entry)
			end

			function Api:Set(Value)
				Quiet(Entry, function()
					WriteElement(Element, Value)
				end)
				Fire(Entry)
			end

			function Api:Get()
				return Store[Flag]
			end

			Api.SetValue = Api.Set
			Api.SetValues = Api.Refresh

			if not Element.Multi and Element.Value == nil then
				Quiet(Entry, function()
					if type(Args.Default) == "string" and Args.Default ~= "" then
						Element:SetValue(Args.Default)
					end
					if Element.Value == nil and type(Element.Values) == "table" and Element.Values[1] ~= nil then
						Element:SetValue(Element.Values[1])
					end
				end)
			end
			Call(Flag, Args.Callback, Store[Flag])
		else
			local Multi = Args.Multi == true
			local Items = {}
			for _, Item in ipairs(Args.Items or {}) do
				table.insert(Items, tostring(Item))
			end
			local Selected = {}
			local Single = (not Multi) and (Args.Default or Items[1] or "") or nil

			local function Mark(Value)
				if type(Value) == "table" then
					for Key, Item in Value do
						if type(Key) == "string" and Item == true then
							Selected[Key] = true
						elseif type(Item) == "string" then
							Selected[Item] = true
						end
					end
				elseif type(Value) == "string" then
					Selected[Value] = true
				end
			end

			local function Emit()
				if Multi then
					local Out = {}
					for _, Name in Items do
						if Selected[Name] then
							table.insert(Out, Name)
						end
					end
					Store[Flag] = Out
				else
					Store[Flag] = Single
				end
				Call(Flag, Args.Callback, Store[Flag])
			end

			function Api:Refresh(NewItems)
				Items = {}
				for _, Item in ipairs(NewItems or {}) do
					table.insert(Items, tostring(Item))
				end
				if Multi then
					local Keep = {}
					for _, Name in Items do
						if Selected[Name] then
							Keep[Name] = true
						end
					end
					Selected = Keep
				elseif not table.find(Items, Single) then
					Single = Items[1] or ""
				end
				Emit()
			end

			function Api:Set(Value)
				if Multi then
					Selected = {}
					Mark(Value)
				else
					Single = tostring(Value or "")
				end
				Emit()
			end

			function Api:Get()
				return Store[Flag]
			end

			Api.SetValue = Api.Set
			Api.SetValues = Api.Refresh

			if Multi then
				Mark(Args.Default)
			end
			Emit()
		end

		if Flag == "ta_auto_equip_gun" then
			_G.__FridayOmegaAutoEquipGunDropdown = Api
		end

