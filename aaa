	local function readArmor(player, character)
		local bodyEffects = character:FindFirstChild("BodyEffects")
		if bodyEffects then
			local armor = bodyEffects:FindFirstChild("Armor") or bodyEffects:FindFirstChild("Defense")
			if armor and (armor:IsA("NumberValue") or armor:IsA("IntValue")) then
				return tonumber(armor.Value) or 0
			end
		end
		return 0
	end

	local function getTorso(character)
		return character:FindFirstChild("UpperTorso")
			or character:FindFirstChild("Torso")
			or character:FindFirstChild("HumanoidRootPart")
	end

	local function isKnockedCharacter(character)
		if not character then
			return false
		end
		if character:GetAttribute("Knocked") == true then
			return true
		end
		local be = character:FindFirstChild("BodyEffects")
		if be then
			local ko = be:FindFirstChild("K.O") or be:FindFirstChild("KO")
			if ko and ko.Value then
				return true
			end
		end
		return false
	end

	local function computeSmartBox(character, camera)
		local root = character:FindFirstChild("HumanoidRootPart")
			or character:FindFirstChild("UpperTorso")
			or character:FindFirstChild("Torso")

		local parts = character:FindFirstChild("UpperTorso") and BOX_EXTENT_R15 or BOX_EXTENT_R6
		local minX, minY = math.huge, math.huge
		local maxX, maxY = -math.huge, -math.huge
		local any = false

		local function absorb(sp)
			if sp.Z <= 0 then
				return
			end
			any = true
			local x, y = sp.X, sp.Y
			if x < minX then minX = x end
			if y < minY then minY = y end
			if x > maxX then maxX = x end
			if y > maxY then maxY = y end
		end

		local wMinX, wMinY, wMinZ = math.huge, math.huge, math.huge
		local wMaxX, wMaxY, wMaxZ = -math.huge, -math.huge, -math.huge
		local hasPart = false
		local useParts = true

		for _, name in ipairs(parts) do
			local part = character:FindFirstChild(name)
			if part and part:IsA("BasePart") then
				if root and (part.Position - root.Position).Magnitude > 18 then
					continue
				end
				hasPart = true
				local cf, size = part.CFrame, part.Size
				local hx, hy, hz = size.X * 0.5, size.Y * 0.5, size.Z * 0.5
				for ox = -1, 1, 2 do
					for oy = -1, 1, 2 do
						for oz = -1, 1, 2 do
							local p = cf * Vector3.new(ox * hx, oy * hy, oz * hz)
							if p.X < wMinX then wMinX = p.X end
							if p.Y < wMinY then wMinY = p.Y end
							if p.Z < wMinZ then wMinZ = p.Z end
							if p.X > wMaxX then wMaxX = p.X end
							if p.Y > wMaxY then wMaxY = p.Y end
							if p.Z > wMaxZ then wMaxZ = p.Z end
						end
					end
				end
			end
		end

		if hasPart then
			local worldH = wMaxY - wMinY
			local worldW = math.max(wMaxX - wMinX, wMaxZ - wMinZ)
			if worldH > 22 or worldW > 22 then
				useParts = false
			else
				absorb(camera:WorldToViewportPoint(Vector3.new(wMinX, wMinY, wMinZ)))
				absorb(camera:WorldToViewportPoint(Vector3.new(wMinX, wMinY, wMaxZ)))
				absorb(camera:WorldToViewportPoint(Vector3.new(wMinX, wMaxY, wMinZ)))
				absorb(camera:WorldToViewportPoint(Vector3.new(wMinX, wMaxY, wMaxZ)))
				absorb(camera:WorldToViewportPoint(Vector3.new(wMaxX, wMinY, wMinZ)))
				absorb(camera:WorldToViewportPoint(Vector3.new(wMaxX, wMinY, wMaxZ)))
				absorb(camera:WorldToViewportPoint(Vector3.new(wMaxX, wMaxY, wMinZ)))
				absorb(camera:WorldToViewportPoint(Vector3.new(wMaxX, wMaxY, wMaxZ)))
			end
		end

		if useParts and any and maxX > minX and maxY > minY then
			local pad = 8
			local size = Vector2.new((maxX - minX) + pad * 2, (maxY - minY) + pad * 2)
			local vp = camera.ViewportSize
			local maxW, maxH = vp.X * 0.45, vp.Y * 0.7
			if size.X > maxW or size.Y > maxH then
			else
				return Vector2.new(minX - pad, minY - pad), size
			end
		end

		local torso = getTorso(character)
		if not torso then
			return nil, nil
		end
		local screenPos, onScreen = camera:WorldToViewportPoint(torso.Position + ESP_OFFSET)
		if not onScreen or screenPos.Z <= 0 then
			return nil, nil
		end
		local offsetPos = camera:WorldToViewportPoint(torso.Position - ESP_OFFSET)
		local difference = offsetPos.Y - screenPos.Y
		local ySize = math.abs(difference) * 6
		local xSize = math.abs(difference) * 4
		if ySize < 6 then
			ySize = 6
		end
		if xSize < 4 then
			xSize = 4
		end
		local vp = camera.ViewportSize
		ySize = math.clamp(ySize, 6, vp.Y * 0.55)
		xSize = math.clamp(xSize, 4, vp.X * 0.35)
		return Vector2.new(offsetPos.X - xSize / 2, offsetPos.Y - ySize / 2), Vector2.new(xSize, ySize)
	end

	local function drawSkeleton(esp, character, color)
		for _ = #esp.skeleton + 1, 24 do
			table.insert(esp.skeleton, createDrawing("Line", { Color = Color3.new(1, 1, 1), Thickness = 1.6, Visible = false }))
		end
		local bones = collectSkeletonBones(character)
		local used = 0
		for i, bone in ipairs(bones) do
			local line = esp.skeleton[i]
			if not line then
				break
			end
			local a2, aOn = Camera:WorldToViewportPoint(bone[1])
			local b2, bOn = Camera:WorldToViewportPoint(bone[2])
			if aOn and bOn and a2.Z > 0 and b2.Z > 0 then
				line.From = Vector2.new(a2.X, a2.Y)
				line.To = Vector2.new(b2.X, b2.Y)
				line.Color = color
				line.Thickness = 1.6
				line.Visible = true
				used = i
			else
				line.Visible = false
			end
		end
		for i = used + 1, #esp.skeleton do
			esp.skeleton[i].Visible = false
		end
	end

	local update = function() LPH_ATTRIBUTES(VM(NONE))
		Camera = Workspace.CurrentCamera
		if not Camera then
			return
		end
		if not LocalRootPart or not LocalRootPart.Parent then
			refreshLocalRoot()
		end

		local enabled = flagOn("esp_enabled", false)
		local selfEsp = flagOn("esp_self", false)
		local showHighlight = flagOn("esp_highlight", false)
		local hideNametags = flagOn("esp_hide_nametags", false)

		if menuOpen() or not enabled then
			for player, esp in pairs(cache) do
				hideEsp(esp)
				removeHighlight(player)
			end
			for _, player in ipairs(Players:GetPlayers()) do
				removeHighlight(player)
				if hideNametags == false then
					applyNametag(player, false)
				end
			end
			_G.__FridayEspIdle = true
			return
		end
		_G.__FridayEspIdle = false

		local showBox = flagOn("esp_box", true)
		local showCornerBox = flagOn("esp_corner_box", false)
		local showBoxFill = flagOn("esp_box_fill", false)
		local fillMode = string.lower(tostring(flagVal("esp_box_fill_mode", "gradient")))
		local showName = flagOn("esp_name", true)
		local showHealth = flagOn("esp_health_bar", true)
		local showArmor = flagOn("esp_armor_bar", true)
		local showOffscreen = false
		local showDistance = flagOn("esp_distance", false)
		local showTool = flagOn("esp_tool_text", false)
		local showTracer = flagOn("esp_tracer", false)
		local showSkeleton = false
		local teamCheck = false
		local rainbow = false
		local tracerPos = tostring(flagVal("esp_tracer_position", "Bottom"))
		local boxColor = flagColor("esp_box_color", Color3.fromRGB(100, 150, 255))
		local boxFillColor = flagColor("esp_box_fill_color", Color3.fromRGB(100, 150, 255))
		local nameColor = flagColor("esp_name_color", Color3.fromRGB(255, 255, 255))
		local EspAccent = (Library.Theme and Library.Theme["Accent"]) or Color3.fromRGB(152, 188, 255)
		local oneColor = flagOn("esp_bar_one_color", false)
		local hpC1, hpC2, hpC3, arC1, arC2, arC3
		if oneColor then
			local solidHp = Color3.fromRGB(0, 255, 0)
			local solidAr = Color3.fromRGB(0, 155, 255)
			hpC1, hpC2, hpC3 = solidHp, solidHp, solidHp
			arC1, arC2, arC3 = solidAr, solidAr, solidAr
		else
			hpC1 = flagColor("esp_health_c1", flagColor("esp_health_bar_color", Color3.fromRGB(0, 255, 0)))
			hpC2 = flagColor("esp_health_c2", Color3.fromRGB(255, 255, 0))
			hpC3 = flagColor("esp_health_c3", Color3.fromRGB(255, 0, 0))
			arC1 = flagColor("esp_armor_c1", flagColor("esp_armor_bar_color", EspAccent))
			arC2 = flagColor("esp_armor_c2", EspAccent:Lerp(Color3.new(1, 1, 1), 0.5))
			arC3 = flagColor("esp_armor_c3", Color3.fromRGB(255, 255, 255))
		end
		local tracerColor = flagColor("esp_tracer_color", Color3.fromRGB(150, 200, 255))
		local skeletonColor = Color3.fromRGB(200, 200, 200)
		local hlColorA = flagColor("esp_highlight_color", Color3.fromRGB(255, 100, 100))
		local hlColorB = flagColor("esp_highlight_color_b", Color3.fromRGB(100, 180, 255))
		local now = tick()
		local gradPhase = (now * 0.35) % 1
		local hlSwitch = keybindSwitchColor(hlColorA, hlColorB, gradPhase)

		for player, esp in pairs(cache) do
			if not player or not player.Parent then
				removeEsp(player)
				continue
			end
			if player == LocalPlayer and not selfEsp then
				hideEsp(esp)
				removeHighlight(player)
				applyNametag(player, false)
				continue
			end

			local character = player.Character
			if not character then
				hideEsp(esp)
				removeHighlight(player)
				continue
			end

			if hideNametags then
				if nametagState[player] == nil then
					applyNametag(player, true)
				end
			elseif nametagState[player] ~= nil then
				applyNametag(player, false)
			end

			local rootPart = character:FindFirstChild("HumanoidRootPart")
			local head = character:FindFirstChild("Head")
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if not LocalRootPart or not rootPart or not head or not humanoid or humanoid.Health <= 0 then
				hideEsp(esp)
				removeHighlight(player)
				continue
			end
			if not flagOn("esp_show_knocked", false) and isKnockedCharacter(character) then
				hideEsp(esp)
				removeHighlight(player)
				continue
			end
			if teamCheck and LocalPlayer.Team and player.Team and LocalPlayer.Team == player.Team then
				hideEsp(esp)
				removeHighlight(player)
				continue
			end

			local distance = (LocalRootPart.Position - rootPart.Position).Magnitude
			local liveBoxColor = rainbow and getRainbowColor(now) or boxColor
			local offscreen = placeOffscreenArrow(esp, rootPart.Position, liveBoxColor, showOffscreen)
			local boxPosition, boxSize = computeSmartBox(character, Camera)
			if not boxPosition or not boxSize then
				if offscreen then
					hideEsp(esp)
					if esp.offArrow then
						esp.offArrow.Visible = true
					end
					removeHighlight(player)
				else
					hideEsp(esp)
					removeHighlight(player)
				end
				continue
			end
			if offscreen then
				hideEsp(esp)
				if esp.offArrow then
					esp.offArrow.Visible = true
				end
				removeHighlight(player)
				continue
			end

			local hrp2D = Camera:WorldToViewportPoint(rootPart.Position)
			local liveFillColor = rainbow and getRainbowColor(now) or boxFillColor

			if showBoxFill then
				if fillMode == "fill" then
					if esp.boxFillImage then
						esp.boxFillImage.Visible = false
					end
					esp.boxFill.Size = boxSize
					esp.boxFill.Position = boxPosition
					esp.boxFill.Color = liveFillColor
					esp.boxFill.Transparency = 0.72
					esp.boxFill.Visible = true
				else
					esp.boxFill.Visible = false
					if esp.boxFillImage then
						pcall(function()
							local wantMode = "gradient"
							if esp._fillDataMode ~= wantMode and gradImageData ~= "" then
								esp.boxFillImage.Data = gradImageData
								esp._fillDataMode = wantMode
							end
							esp.boxFillImage.Size = boxSize
							esp.boxFillImage.Position = boxPosition
							esp.boxFillImage.Color = liveFillColor
							esp.boxFillImage.Transparency = 0.38
							esp.boxFillImage.Visible = true
						end)
					else
						esp.boxFill.Size = boxSize
						esp.boxFill.Position = boxPosition
						esp.boxFill.Color = liveFillColor
						esp.boxFill.Transparency = 0.72
						esp.boxFill.Visible = true
					end
				end
			else
				esp.boxFill.Visible = false
				if esp.boxFillImage then
					esp.boxFillImage.Visible = false
				end
			end

			if showCornerBox then
				for _ = #esp.cornerLines + 1, 8 do
					table.insert(esp.cornerLines, createDrawing("Line", { Color = Color3.new(1, 1, 1), Thickness = 1.4, Visible = false }))
				end
				esp.box.Visible = false
				esp.boxOutline.Visible = false
				placeCornerBox(esp, boxPosition, boxSize, liveBoxColor, true)
			elseif showBox then
				placeCornerBox(esp, boxPosition, boxSize, liveBoxColor, false)
				esp.boxOutline.Size = boxSize
				esp.boxOutline.Position = boxPosition
				esp.boxOutline.Visible = true
				esp.box.Size = boxSize
				esp.box.Position = boxPosition
				esp.box.Color = liveBoxColor
				esp.box.Visible = true
			else
				placeCornerBox(esp, boxPosition, boxSize, liveBoxColor, false)
				esp.box.Visible = false
				esp.boxOutline.Visible = false
			end

			local armorValue = readArmor(player, character)
			local doArmor = showArmor and armorValue >= 1
			local healthSide = flagSide("esp_health_side", "Left")
			local armorSide = flagSide("esp_armor_side", "Left")
			local nameSide = flagSide("esp_name_side", "Top")
			local distSide = flagSide("esp_distance_side", "Bottom")
			local toolSide = flagSide("esp_tool_side", "Bottom")

			local barStacks = { Left = 0, Right = 0, Top = 0, Bottom = 0 }
			local textBySide = { Left = {}, Right = {}, Top = {}, Bottom = {} }

			if doArmor then
				local armorPercentage = math.clamp(armorValue / 200, 0, 1)
				local idx = barStacks[armorSide] or 0
				placeBar(esp.armorOutline, esp.armorSegs, boxPosition, boxSize, armorSide, armorPercentage, idx, arC1, arC2, arC3)
				barStacks[armorSide] = idx + 1
			else
				hideBarDrawings(esp.armorOutline, esp.armorSegs)
			end

			if showHealth and humanoid.MaxHealth > 0 then
				local healthPercentage = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
				local idx = barStacks[healthSide] or 0
				placeBar(esp.healthOutline, esp.healthSegs, boxPosition, boxSize, healthSide, healthPercentage, idx, hpC1, hpC2, hpC3)
				barStacks[healthSide] = idx + 1
			else
				hideBarDrawings(esp.healthOutline, esp.healthSegs)
			end

			if showName then
				esp.nameText.Visible = true
				esp.nameText.Size = NAME_SIZE
				esp.nameText.Font = 2
				esp.nameText.Outline = true
				esp.nameText.Text = player.DisplayName
				esp.nameText.Color = nameColor
				table.insert(textBySide[nameSide], { drawing = esp.nameText })
			else
				esp.nameText.Visible = false
			end

			if showDistance then
				esp.distanceText.Visible = true
				esp.distanceText.Size = SMALL_SIZE
				esp.distanceText.Font = 2
				esp.distanceText.Outline = true
				esp.distanceText.Text = "[ " .. math.floor(distance) .. " M ]"
				esp.distanceText.Color = Color3.new(1, 1, 1)
				table.insert(textBySide[distSide], { drawing = esp.distanceText })
			else
				esp.distanceText.Visible = false
			end

			if showTool then
				local tool = character:FindFirstChildOfClass("Tool")
				if tool then
					esp.toolText.Visible = true
					esp.toolText.Size = SMALL_SIZE
					esp.toolText.Font = 2
					esp.toolText.Outline = true
					esp.toolText.Text = tool.Name
					esp.toolText.Color = Color3.new(1, 1, 1)
					table.insert(textBySide[toolSide], { drawing = esp.toolText })
				else
					esp.toolText.Visible = false
				end
			else
				esp.toolText.Visible = false
			end

			for side, items in pairs(textBySide) do
				if #items > 0 then
					placeTextStack(items, boxPosition, boxSize, side, barStackDepth(barStacks[side] or 0))
				end
			end

			if showTracer then
				local screenSize = Camera.ViewportSize
				local tracerStart = tracerPos == "Top" and Vector2.new(screenSize.X / 2, 0)
					or Vector2.new(screenSize.X / 2, screenSize.Y)
				esp.tracer.From = tracerStart
				esp.tracer.To = Vector2.new(hrp2D.X, hrp2D.Y)
				esp.tracer.Color = rainbow and getRainbowColor(now) or tracerColor
				esp.tracer.Visible = true
			else
				esp.tracer.Visible = false
			end

			if showSkeleton then
				drawSkeleton(esp, character, rainbow and getRainbowColor(now) or skeletonColor)
			else
				for _, line in ipairs(esp.skeleton) do
					line.Visible = false
				end
			end

			if showHighlight then
				local highlight = playerHighlights[player]
				if not highlight or not highlight.Parent or highlight.Adornee ~= character then
					highlight = createHighlight(character, player)
				end
				if highlight then
					local col = rainbow and getRainbowColor(now) or hlSwitch
					highlight.FillColor = col
					highlight.OutlineColor = rainbow and getRainbowColor(now + 0.2) or hlColorB
				end
			else
				removeHighlight(player)
			end
		end
	end

	local function syncPlayers()
		local selfEsp = flagOn("esp_self", false)
		local hideNametags = flagOn("esp_hide_nametags", false)
		local enabled = flagOn("esp_enabled", false)
		for _, player in ipairs(Players:GetPlayers()) do
			if player == LocalPlayer and not selfEsp then
				if cache[player] then
					removeEsp(player)
				else
					removeHighlight(player)
				end
				applyNametag(player, false)
			else
				if enabled and not cache[player] then
					createEsp(player)
				end
				if hideNametags and enabled then
					applyNametag(player, true)
				elseif not hideNametags then
					applyNametag(player, false)
				end
			end
		end
	end

	local function wirePlayer(player)
		player.CharacterAdded:Connect(function(char)
			motorCache[char] = nil
			task.defer(function()
				if flagOn("esp_hide_nametags", false) and flagOn("esp_enabled", false) then
					applyNametag(player, true)
				end
			end)
		end)
		player.CharacterRemoving:Connect(function(char)
			motorCache[char] = nil
		end)
	end

	Players.PlayerAdded:Connect(function(player)
		_G.__FridayEspIdle = false
		if flagOn("esp_enabled", false) and (player ~= LocalPlayer or flagOn("esp_self", false)) then
			createEsp(player)
		end
		wirePlayer(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		removeEsp(player)
		nametagState[player] = nil
	end)

	for _, player in ipairs(Players:GetPlayers()) do
		if flagOn("esp_enabled", false) and (player ~= LocalPlayer or flagOn("esp_self", false)) then
			createEsp(player)
		end
		wirePlayer(player)
	end

	local syncAccum = 0
	RunService.Heartbeat:Connect(function(dt) LPH_ATTRIBUTES(VM(NONE))
		if _G.__FridayUnloaded or _G.__FridayOmegaUnloaded then
			return
		end
		syncAccum += dt or 0
		if syncAccum >= 0.5 then
			syncAccum = 0
			syncPlayers()
		end
	end)

	local espRsAccum = 0
	RunService.RenderStepped:Connect(function(dt) LPH_ATTRIBUTES(VM(NONE))
		if _G.__FridayUnloaded or _G.__FridayOmegaUnloaded then
			return
		end
		espRsAccum += dt or 0
		if espRsAccum < (1 / 48) then
			return
		end
		espRsAccum = 0
		if not flagOn("esp_enabled", false) or menuOpen() then
			if not _G.__FridayEspIdle then
				update()
			end
			return
		end
		if _G.__FridayEspIdle then
			syncPlayers()
		end
		update()
	end)

	table.insert(_G.__FridayOmegaCleanup or {}, function()
		for player in pairs(cache) do
			removeEsp(player)
		end
		for player in pairs(nametagState) do
			applyNametag(player, false)
		end
	end)
end

