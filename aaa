            rs:BindToRenderStep("FridayStrafePad", Enum.RenderPriority.First.Value, strafePushPad)
        end)
        strafeState.padHb = rs.Heartbeat:Connect(strafePushPad)
        pcall(function()
            rs:BindToRenderStep("FridayStrafeWalk", Enum.RenderPriority.Camera.Value + 1, strafeWalkVisual)
        end)
        strafeState.walkRs = rs.RenderStepped:Connect(strafeWalkVisual)
        strafeWalkVisual(0)
    end

    local function strafeClearMovers(freeze)
        local function wipe(obj)
            if obj then
                pcall(function()
                    obj:Destroy()
                end)
            end
        end
        wipe(strafeState.bv)
        wipe(strafeState.bg)
        strafeState.bv, strafeState.bg = nil, nil
        local lp = game:GetService("Players").LocalPlayer
        local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        if root then
            pcall(function()
                for _, obj in ipairs(root:GetChildren()) do
                    if obj.Name == "FridayStrafeVel" or obj.Name == "FridayStrafeGyro" then
                        obj:Destroy()
                    end
                end
                if freeze == true then
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                end
            end)
        end
    end

    local function strafeEnsureMovers(root)
        if flags.ta_strafe_walkable == true then
            strafeClearMovers()
            return
        end
        if not root then
            return
        end
        if not strafeState.bv or not strafeState.bv.Parent then
            local bv = Instance.new("BodyVelocity")
            bv.Name = "FridayStrafeVel"
            bv.MaxForce = Vector3.new(100000, 100000, 100000)
            bv.Velocity = Vector3.zero
            bv.Parent = root
            strafeState.bv = bv
        end
        if not strafeState.bg or not strafeState.bg.Parent then
            local bg = Instance.new("BodyGyro")
            bg.Name = "FridayStrafeGyro"
            bg.MaxTorque = Vector3.new(100000, 100000, 100000)
            bg.P = 10000
            bg.D = 150
            bg.Parent = root
            strafeState.bg = bg
        end
    end

