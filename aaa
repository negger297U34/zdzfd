local function waitForUsableGun(timeout)
    timeout = timeout or 0.85
    local t0 = os.clock()
    while os.clock() - t0 < timeout do
        local character = LocalPlayer.Character
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        local tool = getAnyGun(character, backpack)
        local ammo = tool and (tool:FindFirstChild("Ammo") or tool:FindFirstChild("ammo"))
        if tool and tool:FindFirstChild("Handle") then
            if not ammo then
                return tool
            end
            local val = tonumber(ammo.Value)
            if val == nil or val > 0 then
                return tool
            end
            requestAmmoRefill(tool, ammo)
        end
        task.wait(0.05)
    end
    return getAnyGun(LocalPlayer.Character, LocalPlayer:FindFirstChild("Backpack"))
end

local function getAnyGun(character, backpack)
    local prefer = rawget(_G, "__FridayPreferGunTool")
    if typeof(prefer) == "Instance"
        and prefer:IsA("Tool")
        and prefer.Parent
        and prefer:FindFirstChild("Handle")
    then
        return prefer
    end
    local force = rawget(_G, "__FridayForceGunName")
    if type(force) == "string" and force ~= "" then
        local loaded, empty
        for _, container in ipairs({ character, backpack }) do
            if container then
                for _, t in ipairs(container:GetChildren()) do
                    if t:IsA("Tool") and t.Name == force and t:FindFirstChild("Handle") then
                        local ammo = t:FindFirstChild("Ammo") or t:FindFirstChild("ammo")
                        local v = ammo and tonumber(ammo.Value)
                        if v == nil or v > 0 then
                            loaded = t
                            break
                        elseif not empty then
                            empty = t
                        end
                    end
                end
            end
            if loaded then
                break
            end
        end
        return loaded or empty
    end
    local order = { "[TacticalShotgun]", "[Double-Barrel SG]", "[Revolver]" }
    for _, name in ipairs(order) do
        local t = (backpack and backpack:FindFirstChild(name))
            or (character and character:FindFirstChild(name))
        if t and t:IsA("Tool") and t:FindFirstChild("Handle") then
            return t
        end
    end
    for _, container in ipairs({ character, backpack }) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") and item:FindFirstChild("Handle") then
                    local n = string.lower(item.Name)
                    if Guns[item.Name]
                        or item:FindFirstChild("Ammo")
                        or item:FindFirstChild("ammo")
                        or (string.match(n, "^%[.+%]$") and not string.find(n, "knife", 1, true))
                    then
                        return item
                    end
                end
            end
        end
    end
    return nil
end

