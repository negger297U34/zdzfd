    function fridayPosHomeRoot()
    	local ph = friday.PosHome
    	if typeof(ph.rootCF) == 'CFrame' then
    		return ph.rootCF
    	end
    	local top = ph.stack and ph.stack[1]
    	return top and top.cf or nil
    end

    local function fridayPosHomeGetHrp()
    	local plr = game:GetService('Players').LocalPlayer
    	return plr and plr.Character and plr.Character:FindFirstChild('HumanoidRootPart')
    end

    function fridayPosHomePush(reason, cf)
    	local ph = friday.PosHome
    	ph.stack = ph.stack or {}
    	local hrp = fridayPosHomeGetHrp()
    	if typeof(cf) ~= 'CFrame' then
    		cf = hrp and hrp.CFrame or nil
    	end
    	if typeof(cf) ~= 'CFrame' then
    		return nil
    	end
    	if #ph.stack == 0 then
    		ph.rootCF = cf
    		ph.rootVel = hrp and hrp.AssemblyLinearVelocity or Vector3.zero
    	end
    	table.insert(ph.stack, {
    		reason = reason or 'pos',
    		cf = cf,
    		at = tick(),
    	})
    	return cf
    end

    function fridayPosHomePop(reason, restore)
    	local ph = friday.PosHome
    	ph.stack = ph.stack or {}
    	if #ph.stack == 0 then
    		return
    	end
    	local idx = #ph.stack
    	if reason then
    		for i = #ph.stack, 1, -1 do
    			if ph.stack[i].reason == reason then
    				idx = i
    				break
    			end
    		end
    	end
    	table.remove(ph.stack, idx)
    	if #ph.stack == 0 then
    		if restore ~= false and typeof(ph.rootCF) == 'CFrame' then
    			local hrp = fridayPosHomeGetHrp()
    			if hrp and hrp.Parent then
    				pcall(function()
    					hrp.CFrame = ph.rootCF
    					if typeof(ph.rootVel) == 'Vector3' then
    						hrp.AssemblyLinearVelocity = ph.rootVel
    					end
    				end)
    			end
    		end
    		ph.rootCF = nil
    		ph.rootVel = nil
    	end
    end

    function fridayPosHomeReset()
    	friday.PosHome.stack = {}
    	friday.PosHome.rootCF = nil
    	friday.PosHome.rootVel = nil
    end

