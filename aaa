        t:Colorpicker({ Name = "AA Color", Flag = "desync_color", Default = Color3.fromRGB(0, 255, 100) })
    end
end

task.wait()
do
    local function flagOn(name)
        return ui.Flags[name] == true
    end
    local function flagNum(name, default)
        local v = tonumber(ui.Flags[name])
        if v == nil then
            return default
        end
        return v
    end
    local function kbLive(flag)
        local v = ui.Flags[flag]
        if type(v) ~= "table" then
            v = { Mode = "Toggle", Key = "None", Toggled = false }
            ui.Flags[flag] = v
        end
        if v.Mode == "Always" then
            return true
        end
        return v.Toggled == true
    end
    local function typing()
        return UserInputService:GetFocusedTextBox() ~= nil
            or (rawget(_G, "__FridayOmegaChatTyping") and _G.__FridayOmegaChatTyping())
    end

    do
        local function run()
            local DEFAULT_WALK = 16
            local live = { cframe = false, walk = false, fly = false, jump = false }
            local walkBoosted = false
            local wasFlying = false
            local flyBg, flyBv, flyRoot
            local jumpConns, jumpHum = {}, nil
            local jumpPower, jumpHeight = 50, 7
            local noSlowConn, noJumpConn
            local noSitOn, noSitDesc, noSitHum, noSitChar = false, nil, nil, nil
            local avConn, avChar, avLast
            local avOrig = workspace.FallenPartsDestroyHeight
            local noclipOn, noclipChar, noclipDesc = false, nil, nil
            local afOn, afLast = false, nil
            local lastAnim, lastGrip = false, false
            local animConn, gripAdd, gripRespawn
            local origGrip = setmetatable({}, { __mode = "k" })

            local function destroyFly()
                if flyBg then
                    pcall(function()
                        flyBg:Destroy()
                    end)
                    flyBg = nil
                end
                if flyBv then
                    pcall(function()
                        flyBv:Destroy()
                    end)
                    flyBv = nil
                end
                flyRoot = nil
            end
            local function ensureFly(hrp)
                if flyRoot == hrp and flyBg and flyBg.Parent == hrp and flyBv and flyBv.Parent == hrp then
                    return
                end
                destroyFly()
                flyRoot = hrp
                flyBg = Instance.new("BodyGyro")
                flyBg.Name = "FridayFlyGyro"
                flyBg.P = 9e4
                flyBg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
                flyBg.CFrame = hrp.CFrame
                flyBg.Parent = hrp
                flyBv = Instance.new("BodyVelocity")
                flyBv.Name = "FridayFlyVelocity"
                flyBv.Velocity = Vector3.zero
                flyBv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                flyBv.Parent = hrp
            end
            local function clearJump()
                for _, c in ipairs(jumpConns) do
                    pcall(function()
                        c:Disconnect()
                    end)
                end
                jumpConns = {}
                jumpHum = nil
            end
            local function hookJump(hum, jp, jh)
                jumpPower, jumpHeight = jp, jh
                if jumpHum == hum and #jumpConns > 0 then
                    return
                end
                clearJump()
                if not hum or not hum.Parent then
                    return
                end
                jumpHum = hum
                table.insert(jumpConns, hum:GetPropertyChangedSignal("JumpPower"):Connect(function()
                    if live.jump and math.abs(hum.JumpPower - jumpPower) > 0.01 then
                        hum.JumpPower = jumpPower
                    end
                end))
                table.insert(jumpConns, hum:GetPropertyChangedSignal("JumpHeight"):Connect(function()
                    if live.jump and math.abs(hum.JumpHeight - jumpHeight) > 0.01 then
                        hum.JumpHeight = jumpHeight
                    end
                end))
                table.insert(jumpConns, hum:GetPropertyChangedSignal("UseJumpPower"):Connect(function()
                    if live.jump and hum.UseJumpPower ~= true then
                        hum.UseJumpPower = true
                    end
                end))
            end
            local function applyJump()
                if not live.jump then
                    return
                end
                local char = Client.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if not hum then
                    return
                end
                local jp = flagNum("mov_jump_power", 50)
                local grav = workspace.Gravity
                if grav <= 0 then
                    grav = 196.2
                end
                local jh = (jp * jp) / (2 * grav)
                hookJump(hum, jp, jh)
                pcall(function()
                    hum.UseJumpPower = true
                    hum.JumpPower = jp
                    hum.JumpHeight = jh
                end)
            end
            local function syncLive()
                live.cframe = flagOn("mov_cframe") and kbLive("mov_cframe_key")
                live.walk = flagOn("mov_walk") and kbLive("mov_walk_key")
                live.fly = flagOn("mov_fly") and kbLive("mov_fly_key")
                live.jump = flagOn("mov_jump") and kbLive("mov_jump_key")
                _G.__FridayMovWalkLive = live.walk == true
            end
            local function impulseJump(jp)
                local hrp = Client.Character and Client.Character:FindFirstChild("HumanoidRootPart")
                if not hrp then
                    return
                end
                local v = hrp.AssemblyLinearVelocity
                pcall(function()
                    hrp.AssemblyLinearVelocity = Vector3.new(v.X, jp, v.Z)
                end)
            end
            UserInputService.JumpRequest:Connect(function()
                if typing() then
                    return
                end
                local char = Client.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if not hum or hum.Health <= 0 then
                    return
                end
                if flagOn("mov_inf_jump") then
                    pcall(function()
                        hum.Jump = true
                        hum:ChangeState(Enum.HumanoidStateType.Jumping)
                    end)
                end
                if not live.jump then
                    return
                end
                local st = hum:GetState()
                if st == Enum.HumanoidStateType.Freefall or st == Enum.HumanoidStateType.Jumping
                    or st == Enum.HumanoidStateType.FallingDown or st == Enum.HumanoidStateType.Dead then
                    return
                end
                local jp = flagNum("mov_jump_power", 50)
                impulseJump(jp)
                task.delay(0.02, function()
                    if live.jump then
                        impulseJump(jp)
                    end
                end)
                task.delay(0.05, function()
                    if live.jump then
                        impulseJump(jp)
                    end
                end)
            end)
            Client.CharacterAdded:Connect(clearJump)

            local function setNoSlow(char)
                if noSlowConn then
                    pcall(function()
                        noSlowConn:Disconnect()
                    end)
                    noSlowConn = nil
                end
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if not hum then
                    return
                end
                local old = math.max(hum.WalkSpeed, DEFAULT_WALK)
                if hum.WalkSpeed < DEFAULT_WALK then
                    hum.WalkSpeed = DEFAULT_WALK
                end
                noSlowConn = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
                    if not flagOn("mov_no_slow") then
                        return
                    end
                    if hum.WalkSpeed < DEFAULT_WALK then
                        hum.WalkSpeed = old
                        return
                    end
                    old = hum.WalkSpeed
                end)
            end
            local function setNoJumpCd(char)
                if noJumpConn then
                    pcall(function()
                        noJumpConn:Disconnect()
                    end)
                    noJumpConn = nil
                end
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if not hum then
                    return
                end
                local old = math.max(hum.JumpPower, 50)
                if hum.JumpPower < 50 then
                    hum.JumpPower = 50
                end
                noJumpConn = hum:GetPropertyChangedSignal("JumpPower"):Connect(function()
                    if not flagOn("mov_no_jump_cd") then
                        return
                    end
                    if hum.JumpPower < 50 then
                        hum.JumpPower = old
                        return
                    end
                    old = hum.JumpPower
                end)
            end
            local function disableSeat(obj)
                if obj:IsA("Seat") or obj:IsA("VehicleSeat") then
                    obj.Disabled = true
                    obj.CanTouch = false
                    obj:SetAttribute("FridayNoSit", true)
                end
            end
            local function stopNoSit()
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if (obj:IsA("Seat") or obj:IsA("VehicleSeat")) and obj:GetAttribute("FridayNoSit") then
                        obj.Disabled = false
                        obj.CanTouch = true
                        obj:SetAttribute("FridayNoSit", nil)
                    end
                end
                if noSitDesc then
                    noSitDesc:Disconnect()
                end
                if noSitHum then
                    noSitHum:Disconnect()
                end
                if noSitChar then
                    noSitChar:Disconnect()
                end
                noSitDesc, noSitHum, noSitChar = nil, nil, nil
                noSitOn = false
            end
            local function hookSit(char)
                if noSitHum then
                    noSitHum:Disconnect()
                end
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if not hum then
                    return
                end
                noSitHum = hum:GetPropertyChangedSignal("Sit"):Connect(function()
                    if hum.Sit then
                        hum.Sit = false
                    end
                end)
            end
            local function startNoSit()
                if noSitOn then
                    return
                end
                noSitOn = true
                for _, obj in ipairs(workspace:GetDescendants()) do
                    disableSeat(obj)
                end
                noSitDesc = workspace.DescendantAdded:Connect(function(obj)
                    if obj:IsA("Seat") or obj:IsA("VehicleSeat") then
                        task.defer(disableSeat, obj)
                    end
                end)
                hookSit(Client.Character)
                noSitChar = Client.CharacterAdded:Connect(hookSit)
            end
            local function stopVoid()
                if avConn then
                    avConn:Disconnect()
                end
                if avChar then
                    avChar:Disconnect()
                end
                avConn, avChar = nil, nil
                pcall(function()
                    workspace.FallenPartsDestroyHeight = avOrig
                end)
                avLast = nil
            end
            local function startVoid()
                stopVoid()
                pcall(function()
                    workspace.FallenPartsDestroyHeight = 0 / 0
                end)
                avChar = Client.CharacterAdded:Connect(function()
                    task.delay(0.25, function()
                        local hrp = Client.Character and Client.Character:FindFirstChild("HumanoidRootPart")
                        if hrp and hrp.Position.Y > -200 then
                            avLast = hrp.CFrame
                        end
                    end)
                end)
                avConn = RunService.Heartbeat:Connect(function()
                    if not flagOn("mov_anti_void") then
                        return
                    end
                    local hrp = Client.Character and Client.Character:FindFirstChild("HumanoidRootPart")
                    if not hrp then
                        return
                    end
                    if hrp.Position.Y < -450 then
                        hrp.CFrame = avLast or CFrame.new(0, 50, 0)
                        return
                    end
                    if hrp.Position.Y > -200 then
                        avLast = hrp.CFrame
                    end
                end)
            end
            local function stopNoclip()
                if noclipChar then
                    noclipChar:Disconnect()
                end
                if noclipDesc then
                    noclipDesc:Disconnect()
                end
                noclipChar, noclipDesc = nil, nil
            end
            local function applyNoclip(char)
                stopNoclip()
                if not char then
                    return
                end
                local function clip(part)
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
                for _, part in ipairs(char:GetDescendants()) do
                    clip(part)
                end
                noclipDesc = char.DescendantAdded:Connect(clip)
            end
            local function startNoclip()
                applyNoclip(Client.Character)
                noclipChar = Client.CharacterAdded:Connect(applyNoclip)
            end
            local function stopAnim()
                if animConn then
                    animConn:Disconnect()
                    animConn = nil
                end
                local hum = Client.Character and Client.Character:FindFirstChildOfClass("Humanoid")
                if hum then
                    for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
                        pcall(function()
                            track:AdjustSpeed(1)
                        end)
                    end
                end
            end
            local function startAnim()
                stopAnim()
                animConn = RunService.Heartbeat:Connect(function()
                    if not flagOn("mov_anim_breaker") then
                        return
                    end
                    local hum = Client.Character and Client.Character:FindFirstChildOfClass("Humanoid")
                    if not hum then
                        return
                    end
                    local tracks
                    pcall(function()
                        tracks = hum:GetPlayingAnimationTracks()
                    end)
                    if type(tracks) ~= "table" then
                        return
                    end
                    local lag = flagNum("mov_anim_lagger", 0)
                    local jitter = flagNum("mov_anim_jitter", 0)
                    for _, track in ipairs(tracks) do
                        if track.IsPlaying then
                            local speed = (lag / 50) + ((math.random() - 0.5) * (jitter / 100))
                            pcall(function()
                                track:AdjustSpeed(math.max(0.1, speed))
                                if jitter > 0 then
                                    local np = track.TimePosition + ((math.random() - 0.5) * (jitter / 100))
                                    if np >= 0 and np <= track.Length then
                                        track.TimePosition = np
                                    end
                                end
                            end)
                        end
                    end
                end)
            end
            local function resetGrips()
                local char = Client.Character
                if not char then
                    return
                end
                for _, tool in ipairs(char:GetChildren()) do
                    if tool:IsA("Tool") and origGrip[tool] then
                        tool.Grip = origGrip[tool]
                        origGrip[tool] = nil
                    end
                end
            end
            local function randGrip(tool)
                if not tool or not tool:IsA("Tool") then
                    return
                end
                if not origGrip[tool] then
                    origGrip[tool] = tool.Grip
                end
                tool.Grip = CFrame.Angles(math.rad(math.random(0, 360)), math.rad(math.random(0, 360)), math.rad(math.random(0, 360)))
            end
            local function setGrips(on)
                if gripAdd then
                    gripAdd:Disconnect()
                    gripAdd = nil
                end
                if gripRespawn then
                    gripRespawn:Disconnect()
                    gripRespawn = nil
                end
                if not on then
                    resetGrips()
                    origGrip = setmetatable({}, { __mode = "k" })
                    return
                end
                local char = Client.Character
                if char then
                    for _, tool in ipairs(char:GetChildren()) do
                        randGrip(tool)
                    end
                    gripAdd = char.ChildAdded:Connect(randGrip)
                end
                gripRespawn = Client.CharacterAdded:Connect(function(newChar)
                    task.delay(0.5, function()
                        origGrip = setmetatable({}, { __mode = "k" })
                        if flagOn("mov_random_tools") then
                            for _, tool in ipairs(newChar:GetChildren()) do
                                randGrip(tool)
                            end
                            if gripAdd then
                                gripAdd:Disconnect()
                            end
                            gripAdd = newChar.ChildAdded:Connect(randGrip)
                        end
                    end)
                end)
            end
            local extrasAccum = 0
            RunService.Heartbeat:Connect(function(dt)
                extrasAccum += dt or 0
                if extrasAccum < 0.1 then
                    if noclipOn and Client.Character then
                        for _, part in ipairs(Client.Character:GetChildren()) do
                            if part:IsA("BasePart") then
                                part.CanCollide = false
                            end
                        end
                    end
                    if afOn then
                        local hrp = Client.Character and Client.Character:FindFirstChild("HumanoidRootPart")
                        if hrp and not live.fly then
                            local mag = hrp.AssemblyLinearVelocity.Magnitude
                            if mag > 140 then
                                hrp.AssemblyLinearVelocity = Vector3.zero
                                hrp.AssemblyAngularVelocity = Vector3.zero
                                if afLast then
                                    hrp.CFrame = afLast
                                end
                            elseif mag < 55 then
                                afLast = hrp.CFrame
                            end
                        end
                    end
                    return
                end
                extrasAccum = 0
                if flagOn("mov_no_slow") then
                    if not noSlowConn then
                        setNoSlow(Client.Character)
                    end
                elseif noSlowConn then
                    noSlowConn:Disconnect()
                    noSlowConn = nil
                end
                if flagOn("mov_no_jump_cd") then
                    if not noJumpConn then
                        setNoJumpCd(Client.Character)
                    end
                elseif noJumpConn then
                    noJumpConn:Disconnect()
                    noJumpConn = nil
                end
                if flagOn("mov_no_sit") then
                    startNoSit()
                elseif noSitOn then
                    stopNoSit()
                end
                if flagOn("mov_anti_void") then
                    if not avConn then
                        startVoid()
                    end
                elseif avConn then
                    stopVoid()
                end
                local wantClip = flagOn("mov_noclip")
                if wantClip ~= noclipOn then
                    noclipOn = wantClip
                    if wantClip then
                        startNoclip()
                    else
                        stopNoclip()
                    end
                end
                afOn = flagOn("mov_anti_fling")
                local animOn = flagOn("mov_anim_breaker")
                if animOn ~= lastAnim then
                    lastAnim = animOn
                    if animOn then
                        startAnim()
                    else
                        stopAnim()
                    end
                end
                local gripOn = flagOn("mov_random_tools")
                if gripOn ~= lastGrip then
                    lastGrip = gripOn
                    setGrips(gripOn)
                end
                if live.jump then
                    applyJump()
                elseif jumpHum then
                    clearJump()
                end
            end)
            Client.CharacterAdded:Connect(function(char)
                if flagOn("mov_no_slow") then
                    task.defer(setNoSlow, char)
                end
                if flagOn("mov_no_jump_cd") then
                    task.defer(setNoJumpCd, char)
                end
                if flagOn("mov_anim_breaker") then
                    task.delay(0.5, startAnim)
                end
            end)

            RunService.RenderStepped:Connect(function()
                syncLive()
                local any = walkBoosted or wasFlying or flagOn("mov_cframe") or flagOn("mov_walk")
                    or flagOn("mov_fly") or flagOn("mov_spin") or flagOn("mov_face_back") or flagOn("mov_jump")
                    or flagOn("auto_sprint")
                if not any then
                    return
                end
                local wantFly = live.fly
                local need = wantFly or wasFlying or live.cframe or live.walk or walkBoosted
                    or flagOn("auto_sprint") or flagOn("mov_spin") or flagOn("mov_face_back")
                if not need then
                    return
                end
                local char = Client.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hum or not hrp then
                    return
                end
                if wantFly and not wasFlying then
                    pcall(function()
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                    end)
                    ensureFly(hrp)
                end
                if wantFly then
                    local cam = workspace.CurrentCamera
                    if cam then
                        ensureFly(hrp)
                        hum.PlatformStand = true
                        local iy = math.max(0.1, flagNum("mov_fly_speed", 3))
                        local F, B, L, R, Q, E = 0, 0, 0, 0, 0, 0
                        if not typing() then
                            if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Z) then
                                F = iy
                            end
                            if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                                B = -iy
                            end
                            if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Q) then
                                L = -iy
                            end
                            if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                                R = iy
                            end
                            if UserInputService:IsKeyDown(Enum.KeyCode.Space) or UserInputService:IsKeyDown(Enum.KeyCode.E) then
                                Q = iy * 2
                            end
                            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
                                E = -iy * 2
                            end
                        end
                        local moving = (L + R) ~= 0 or (F + B) ~= 0 or (Q + E) ~= 0
                        if not moving and hum.MoveDirection.Magnitude > 0 then
                            moving = true
                        end
                        local SPEED = moving and 50 or 0
                        if flyBv and flyBg then
                            if moving then
                                local keyVel = ((cam.CFrame.LookVector * (F + B))
                                    + ((cam.CFrame * CFrame.new(L + R, (F + B + Q + E) * 0.2, 0).Position) - cam.CFrame.Position))
                                    * SPEED
                                if (F + B + L + R + Q + E) == 0 then
                                    keyVel = Vector3.new(hum.MoveDirection.X, 0, hum.MoveDirection.Z) * SPEED * iy
                                end
                                flyBv.Velocity = keyVel
                            else
                                flyBv.Velocity = Vector3.zero
                            end
                            flyBg.CFrame = cam.CFrame
                        end
                    end
                elseif wasFlying then
                    destroyFly()
                    pcall(function()
                        hum.PlatformStand = false
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                    end)
                end
                wasFlying = wantFly
                if live.cframe and hum.MoveDirection.Magnitude > 0 then
                    hrp.CFrame = hrp.CFrame + (hum.MoveDirection * (flagNum("mov_cframe_speed", 3) / 30))
                end
                local wsTarget = flagNum("mov_walk_speed", 50)
                if live.walk then
                    if hum.WalkSpeed ~= wsTarget then
                        hum.WalkSpeed = wsTarget
                    end
                    walkBoosted = true
                elseif flagOn("auto_sprint") then
                    if hum.WalkSpeed ~= 22 then
                        hum.WalkSpeed = 22
                    end
                    walkBoosted = true
                elseif walkBoosted then
                    if hum.WalkSpeed ~= DEFAULT_WALK then
                        hum.WalkSpeed = DEFAULT_WALK
                    end
                    walkBoosted = false
                end
                if flagOn("mov_spin") then
                    hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(flagNum("mov_spin_speed", 10)), 0)
                end
                if flagOn("mov_face_back") then
                    local cam = workspace.CurrentCamera
                    if cam then
                        local _, cy = cam.CFrame:ToOrientation()
                        hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, cy + math.pi, 0)
                    end
                end
            end)
        end
        run()
    end

    do
        local function run()
            local setback = Instance.new("Part")
            setback.Name = "AntiAim Setback"
            setback.Parent = workspace
            setback.Size = Vector3.new(2, 2, 1)
            setback.CanCollide = false
            setback.Anchored = true
            setback.Transparency = 1
            local desync = {
                enabled = false,
                oldPosition = nil,
                teleportPosition = nil,
                lastAlivePos = nil,
                respawnGen = 0,
            }
            local lastDeathPos
            local custom = {
                randomPower = 27,
                randomizedAmount = 50,
                strafeSpeed = 8.8,
                strafeDistance = 17.5,
                fourDFreq = 7,
                fourDMag = 20.2,
                fourDDist = 1,
            }
            local ox, oy, oz = 0, 10, 0
            local drawingOk = false
            local line, dot, status
            pcall(function()
                line = Drawing.new("Line")
                dot = Drawing.new("Circle")
                status = Drawing.new("Text")
                drawingOk = true
            end)
            if drawingOk then
                line.Thickness = 2
                line.Visible = false
                dot.Radius = 6
                dot.Thickness = 1.5
                dot.NumSides = 16
                dot.Filled = true
                dot.Visible = false
                status.Size = 18
                status.Font = 2
                status.Outline = true
                status.OutlineColor = Color3.fromRGB(0, 0, 0)
                status.Center = true
                status.Visible = false
            end
            local function sane(p)
                if typeof(p) ~= "Vector3" then
                    return false
                end
                if p.Y < -250 or p.Y > 2500 then
                    return false
                end
                return math.abs(p.X) <= 12000 and math.abs(p.Z) <= 12000
            end
            local function fakePos(root)
                local mode = string.lower(tostring(ui.Flags.desync_mode or "void"))
                local pos = root.Position
                local t = tick()
                if mode == "destroy cheaters" then
                    return Vector3.new(11223344556677889900, 1, 1)
                elseif mode == "underground" then
                    return pos - Vector3.new(0, 9, 0)
                elseif mode == "undergroundv2" then
                    return pos - Vector3.new(0, 13, 0)
                elseif mode == "custom" then
                    local strafe = math.sin(t * custom.strafeSpeed) * custom.strafeDistance
                    local fourD = math.sin(t * custom.fourDFreq) * custom.fourDMag * custom.fourDDist
                    local rp = custom.randomPower * (custom.randomizedAmount / 100)
                    local rFloor = math.floor(rp * 10 + 1)
                    return pos - Vector3.new(
                        ox + strafe + math.random(-rFloor, rFloor) / 10,
                        oy + fourD,
                        oz + math.random(-rFloor, rFloor) / 10
                    )
                elseif mode == "void spam" then
                    return Vector3.new(math.random(10000, 50000), math.random(10000, 50000), math.random(10000, 50000))
                elseif mode == "void" then
                    return Vector3.new(pos.X + math.random(-444444, 444444), pos.Y + math.random(-444444, 444444), pos.Z + math.random(-44444, 44444))
                elseif mode == "spin" then
