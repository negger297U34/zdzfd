local function sentryClearHolsterBlock()
    local gen = (tonumber(rawget(_G, "__FridaySentryHolsterGen")) or 0) + 1
    _G.__FridaySentryHolsterGen = gen
    _G.__FridaySentryHolsterUntil = 0
    _G.__FridaySentryHolsterAfterRefill = false
    local bag = rawget(_G, "_900")
    if type(bag) == "table" then
        bag.suppressAutoEquipUntil = 0
    end
end

local function sentryGotoOnTarget(player)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local tchar = player and player.Character
    local part = tchar and (
        tchar:FindFirstChild("HumanoidRootPart")
        or tchar:FindFirstChild("Head")
        or tchar:FindFirstChild("UpperTorso")
        or tchar:FindFirstChild("Torso")
    )
    if not hrp or not part then
        return false
    end
    pcall(function()
        local targetPos = part.Position + Vector3.new(0, 1, 0)
        hrp.CFrame = CFrame.new(targetPos, part.Position)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        if hrp:FindFirstChild("Velocity") or true then
            pcall(function()
                hrp.Velocity = Vector3.zero
            end)
        end
    end)
    return true
end

local function sentryBindTa(player, mode)
    local prev = rawget(_G, "__FridaySentryTaForce")
    local fresh = type(prev) ~= "table" or prev.plr ~= player
    _G.__FridaySentryTaForce = {
        plr = player,
        mode = mode or "knock",
        untilAt = tick() + 2.6,
    }
    if type(_G.__FridayTaForceBind) == "function" then
        pcall(_G.__FridayTaForceBind, player)
    end
    return fresh
end

local function sentryClearTa()
    _G.__FridaySentryTaForce = nil
    if type(_G.__FridayTaClearForceBind) == "function" then
        pcall(_G.__FridayTaClearForceBind)
    end
end

local function sentryAssaultPulse(player, mode)
    local killAll = rawget(_G, "__FridayOmegaManipKillAll")
    local uid = tonumber(player and player.UserId)
    if type(killAll) ~= "function" or not uid then
        return killTarget(player) == true
    end
    local any = false
    for round = 1, 6 do
        if player.Parent ~= Players then
            break
        end
        local ok, fired = pcall(killAll, {
            sentry = true,
            force = true,
            bypassBusy = true,
            onlyUid = uid,
            ignoreAlive = mode == "kill",
            keepEquipped = round < 6,
            bursts = 12,
        })
        if ok and fired == true then
            any = true
        end
        if round < 6 then
            task.wait(0.04)
        end
    end
    if not any then
        return killTarget(player) == true
    end
    return true
end

local function sentryTaPulse(player, mode)
    sentryClearHolsterBlock()
    if sentryBindTa(player, mode) then
        task.wait()
    end
    sentryGotoOnTarget(player)
    local character = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if character == nil then
        return false
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local tool = getAnyGun(character, backpack)
    local ammo = tool and (tool:FindFirstChild("Ammo") or tool:FindFirstChild("ammo"))
    if ammo and not usableAmmo(tool, ammo) then
        requestAmmoRefill(tool, ammo)
        tool = waitForUsableGun(0.22)
        ammo = tool and (tool:FindFirstChild("Ammo") or tool:FindFirstChild("ammo"))
    end
    if humanoid == nil or humanoid.Health <= 0 or tool == nil then
        return false
    end
    pcall(function()
        tool.Enabled = true
        if tool.Parent ~= character then
            humanoid:EquipTool(tool)
        end
    end)
    if tool.Parent ~= character then
        pcall(function()
            tool.Parent = character
        end)
    end
    local fired = false
    for shot = 1, 3 do
        if tool.Parent ~= character or player.Parent ~= Players then
            break
        end
        if pcall(function()
            if tool.Activate then
                tool:Activate()
            end
        end) then
            fired = true
        end
        local live = tool:FindFirstChild("Ammo") or tool:FindFirstChild("ammo")
        if live then
            local left = tonumber(live.Value)
            if left ~= nil and left <= 0 then
                break
            end
        end
        local targetHum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if targetHum == nil or targetHum.Health <= 0 then
            break
        end
        if shot < 3 then
            task.wait(0.035)
        end
    end
    ammo = tool:FindFirstChild("Ammo") or tool:FindFirstChild("ammo")
    if ammo then
        local val = tonumber(ammo.Value)
        if val ~= nil and val <= 0 then
            requestAmmoRefill(tool, ammo)
        end
    end
    return fired
end
local function isGunTool(name)
    return Guns[name]
        or name:find("Gun", 1, true)
        or name:find("Shotgun", 1, true)
        or name:find("Revolver", 1, true)
        or name:find("Pistol", 1, true)
end

local function playerGuns(player)
    local list = {}
    local function add(container)
        if not container then
            return
        end
        for _, t in ipairs(container:GetChildren()) do
            if t:IsA("Tool") and isGunTool(t.Name) then
                list[#list + 1] = t
            end
        end
    end
    add(player.Character)
    add(player:FindFirstChild("Backpack"))
    return list
end

local GunWatch = setmetatable({}, { __mode = "k" })

local FireTracker = {
    FiredAt = {}, 
    Mouse = {}, 
}

local HealthState = {
    Last = nil,
    LastHitAt = 0,
    LastGunshotAt = 0,
    LastTrustedShooter = nil,
    LastTrustedAt = 0,
}

local function isCreatorTagName(name)
    if type(name) ~= "string" then
        return false
    end
    local ln = string.lower(name)
    local compact = (ln:gsub("%s+", ""))
    return compact == "creator"
        or compact == "creatortag"
        or compact == "killer"
        or compact == "damager"
        or compact == "lastdamager"
        or compact == "attacker"
        or compact == "causedby"
        or compact == "hitby"
        or compact == "lastattacker"
        or ln == "creator tag"
        or ln == "last damager"
        or ln == "last attacker"
        or ln == "hit by"
end

local function playerFromValue(value)
    if typeof(value) == "Instance" then
        if value:IsA("Player") then
            return value
        end
        local plr = Players:GetPlayerFromCharacter(value)
        if plr then
            return plr
        end
        if value.Parent and value.Parent:IsA("Model") then
            return Players:GetPlayerFromCharacter(value.Parent)
        end
    elseif type(value) == "string" and value ~= "" then
        local byName = Players:FindFirstChild(value)
        if byName and byName:IsA("Player") then
            return byName
        end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Name == value or plr.DisplayName == value then
                return plr
            end
        end
    elseif type(value) == "number" then
        local ok, plr = pcall(Players.GetPlayerByUserId, Players, value)
        if ok then
            return plr
        end
    end
    return nil
end

local function playerFromTag(tag)
    if not tag then
        return nil
    end
    if tag:IsA("ObjectValue") then
        return playerFromValue(tag.Value)
    end
    if tag:IsA("StringValue") or tag:IsA("IntValue") or tag:IsA("NumberValue") then
        return playerFromValue(tag.Value)
    end
    return nil
end

local function rememberTrusted(plr, why)
    if not plr or plr == LocalPlayer or plr.Parent ~= Players then
        return
    end
    if isFriendlyWhitelisted(plr) then
        return
    end
    HealthState.LastTrustedShooter = plr
    HealthState.LastTrustedAt = os.clock()
end

local function collectCreatorPlayers(root, into, seen)
    if not root then
        return
    end
    local function consider(inst)
        if not (inst:IsA("ObjectValue") or inst:IsA("StringValue")
            or inst:IsA("IntValue") or inst:IsA("NumberValue"))
        then
            return
        end
        if not isCreatorTagName(inst.Name) then
            return
        end
        local plr = playerFromTag(inst)
        if plr and plr ~= LocalPlayer and not seen[plr] and not isFriendlyWhitelisted(plr) then
            seen[plr] = true
            into[#into + 1] = plr
        end
    end
    for _, child in ipairs(root:GetChildren()) do
        consider(child)
    end
    for _, desc in ipairs(root:GetDescendants()) do
        consider(desc)
    end
end

local function findCreatorAttacker(hum)
    local char = LocalPlayer.Character
    if not hum then
        hum = char and char:FindFirstChildOfClass("Humanoid")
    end
    if not hum then
        return nil
    end
    local list, seen = {}, {}
    collectCreatorPlayers(hum, list, seen)
    if char then
        collectCreatorPlayers(char, list, seen)
        local be = char:FindFirstChild("BodyEffects")
        if be then
            collectCreatorPlayers(be, list, seen)
        end
    end
    if #list == 0 then
        return nil
    end
    if #list == 1 then
        return list[1]
    end
    local locked = HealthState.LastTrustedShooter
    if locked and seen[locked] then
        return locked
    end
    return nil
end

local function recordFire(player, why)
    if not player or player == LocalPlayer then
        return
    end
    FireTracker.FiredAt[player] = os.clock()
    FireTracker.FireWhy = FireTracker.FireWhy or {}
    FireTracker.FireWhy[player] = why or "fire"
end

local function findAmmoValue(tool)
    if not tool then
        return nil
    end
    local ammo = tool:FindFirstChild("Ammo")
        or tool:FindFirstChild("ammo")
        or tool:FindFirstChild("AMMO")
    if ammo and ammo:IsA("ValueBase") then
        return ammo
    end
    for _, d in ipairs(tool:GetDescendants()) do
        if d:IsA("ValueBase") and string.lower(d.Name) == "ammo" then
            return d
        end
    end
    return nil
end

local function allToolsWithAmmo(player)
    local list = {}
    local function add(container)
        if not container then
            return
        end
        for _, t in ipairs(container:GetChildren()) do
            if t:IsA("Tool") and findAmmoValue(t) then
                list[#list + 1] = t
            end
        end
    end
    add(player.Character)
    add(player:FindFirstChild("Backpack"))
    return list
end

local function watchGunFiringFlag(be, player)
    if not be or be:GetAttribute("__sentry_gf_watch") then
        return
    end
    be:SetAttribute("__sentry_gf_watch", true)
    for _, name in ipairs({ "GunFiring", "Shooting", "Attacking", "GunFire" }) do
        local flag = be:FindFirstChild(name)
        if flag and flag:IsA("ValueBase") and not flag:GetAttribute("__sentry_gf") then
            flag:SetAttribute("__sentry_gf", true)
            flag.Changed:Connect(function()
                local v = flag.Value
                if v == true or v == 1 then
                    local myHead = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head")
                    local mp = FireTracker.Mouse[player]
                    local aimed = myHead and mp and typeof(mp) == "Vector3"
                        and (mp - myHead.Position).Magnitude <= AIM_HIT_RADIUS
                    local far = true
                    do
                        local me = LocalPlayer.Character
                            and (LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                                or LocalPlayer.Character:FindFirstChild("Head"))
                        local them = player.Character
                            and (player.Character:FindFirstChild("HumanoidRootPart")
                                or player.Character:FindFirstChild("Head"))
                        if me and them then
                            far = (them.Position - me.Position).Magnitude >= 10000
                        elseif player.Character then
                            far = false
                        end
                    end
                    if aimed or far or not player.Character then
                        recordFire(player, name)
                    end
                end
            end)
        end
    end
end

local scanPlayers = function() LPH_ATTRIBUTES(VM(NONE))
    local now = os.clock()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local char = p.Character
            if char then
                local be = char:FindFirstChild("BodyEffects")
                if be then
                    local mp = be:FindFirstChild("MousePos")
                    if mp then
                        local ok, v = pcall(function()
                            return mp.Value
                        end)
                        if ok and typeof(v) == "Vector3" then
                            FireTracker.Mouse[p] = v
                        end
                    end
                    watchGunFiringFlag(be, p)
                end
            end
            for _, tool in ipairs(allToolsWithAmmo(p)) do
                local ammo = findAmmoValue(tool)
                local watch = GunWatch[tool]
                if ammo then
                    local val = tonumber(ammo.Value) or 0
                    if watch then
                        if val < watch.ammo then
                            recordFire(p, "ammo")
                        end
                        watch.ammo = val
                    else
                        GunWatch[tool] = { player = p, ammo = val }
                    end
                elseif watch then
                    GunWatch[tool] = nil
                end
            end
        end
    end
    for plr, at in pairs(FireTracker.FiredAt) do
        if now - at > 1.5 then
            FireTracker.FiredAt[plr] = nil
        end
    end
end

do
