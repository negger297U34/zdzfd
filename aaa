		local Text = Box.Text
		if Text ~= "" then
			table.insert(History, Text)
			if #History > 40 then
				table.remove(History, 1)
			end
			ExecLine(Text)
		end
		SetOpen(false)
	end

	local function StepHistory(Step)
		if #History == 0 then
			return
		end
		HistIdx = math.clamp(HistIdx + Step, 1, #History + 1)
		Box.Text = History[HistIdx] or ""
		Box.CursorPosition = #Box.Text + 1
	end

