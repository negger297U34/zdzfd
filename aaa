        local function worldStampPartTexture(desc)
            if worldMcIsIgnoredPart(desc) or worldProcessedParts[desc] then
                return
            end
            local texId = MC_PACK[desc.Material.Name]
            if not texId then
                return
            end
            if desc:FindFirstChild("FridayWorldTex") then
                worldProcessedParts[desc] = true
                return
            end
            local color = desc.Color
            local trans = desc.Transparency
            for _, face in ipairs(MC_FACES) do
                local tex = Instance.new("Texture")
                tex.Name = "FridayWorldTex"
                tex.ZIndex = 1
                tex.Texture = "rbxassetid://" .. texId
                tex.Face = face
                tex.Color3 = color
                tex.Transparency = trans
                tex.StudsPerTileU = 4
                tex.StudsPerTileV = 4
                tex.Parent = desc
            end
            pcall(function()
                desc.Material = Enum.Material.SmoothPlastic
            end)
            worldProcessedParts[desc] = true
        end

        local function worldEnsureMcStampPump()
            if worldMcStampConn then
                return
            end
            local acc = 0
            worldMcStampConn = RunService.Heartbeat:Connect(function(dt)
                if _G.__FridayUnloaded or _G.__FridayOmegaUnloaded then
                    return
                end
                if worldMcUseVariants or not flagOn("world_minecraft_tex", false) then
                    return
                end
                acc += dt or 0
                if acc < 0.03 then
                    return
                end
                acc = 0
                local budget = 18
                while budget > 0 do
                    local part = table.remove(worldMcStampQueue, 1)
                    if not part then
                        break
                    end
                    worldMcStampQueued[part] = nil
                    if part.Parent then
                        worldStampPartTexture(part)
                        budget -= 1
                    end
                end
            end)
            table.insert(_G.__FridayOmegaCleanup or {}, function()
                if worldMcStampConn then
                    worldMcStampConn:Disconnect()
                    worldMcStampConn = nil
                end
            end)
        end

        local function worldQueueMcStamp(desc)
            if worldMcUseVariants or worldMcIsIgnoredPart(desc) or worldProcessedParts[desc] then
                return
            end
            if not MC_PACK[desc.Material.Name] then
                return
            end
            if worldMcStampQueued[desc] then
                return
            end
            worldMcStampQueued[desc] = true
            table.insert(worldMcStampQueue, desc)
            worldEnsureMcStampPump()
        end

        local function worldApplyMcPack()
            if worldMcApplyBusy then
                return
            end
            worldMcApplyBusy = true
            task.spawn(function()
                worldMcRoot = Workspace:FindFirstChild("Map") or Workspace
                worldClearMcVariants()
                worldClearMcTexturesAsync()

                local usedMs = false
                if MaterialService then
                    for name, texId in pairs(MC_PACK) do
                        local matEnum = nil
                        pcall(function()
                            matEnum = Enum.Material[name]
                        end)
                        if matEnum then
                            local ok, matVar = pcall(function()
                                local existing = MaterialService:FindFirstChild("Friday_" .. name)
                                if existing then
                                    pcall(function()
                                        existing:Destroy()
                                    end)
                                end
                                local mv = Instance.new("MaterialVariant")
                                mv.Name = "Friday_" .. name
                                mv.BaseMaterial = matEnum
                                local asset = "rbxassetid://" .. tostring(texId)
                                mv.ColorMap = asset
                                mv.StudsPerTile = 4
                                mv.Parent = MaterialService
                                MaterialService:SetBaseMaterialOverride(matEnum, mv.Name)
                                return mv
                            end)
                            if ok and matVar then
                                usedMs = true
                                table.insert(worldMcVariants, matVar)
                                table.insert(worldMcOverrideMats, matEnum)
                            end
                        end
                    end
                end

                worldMcUseVariants = usedMs == true
                if worldTexConn then
                    worldTexConn:Disconnect()
                    worldTexConn = nil
                end
                if not usedMs then
                    worldEnsureMcStampPump()
                    local n = 0
                    local root = worldMcRoot
                    if not root or not root.Parent then
                        root = Workspace
                    end
                    worldTexConn = root.DescendantAdded:Connect(function(desc)
                        if not flagOn("world_minecraft_tex", false) or worldMcUseVariants then
                            return
                        end
                        worldQueueMcStamp(desc)
                    end)
                    for _, d in ipairs(root:GetDescendants()) do
                        if not flagOn("world_minecraft_tex", false) then
                            break
                        end
                        worldQueueMcStamp(d)
                        n += 1
                        if n % 120 == 0 then
                            task.wait()
                        end
                    end
                end
                worldMcApplyBusy = false
            end)
        end

