		end

		local Mirror = Link.Mirror and Link.Toggle.Value == true
		if Link.Armed ~= Armed or (Link.Mirror and Picker.Toggled ~= Mirror) then
			Link.Armed = Armed
			Picker.MenuVisible = Armed
			if Link.Mirror then
				Picker.Toggled = Mirror
