                            part.CanCollide = false
                        end)
                        if show then
                            hbUpdateVisual(d, part, size, col, trans)
                        else
                            hbDestroyVisual(d)
                        end
                    end
                end
            end
            for part, d in pairs(stored) do
                if not seen[part] then
                    hbRestore(part, d)
                end
            end
        end
        local function hbEnsureLoop(on)
            if on then
                if not hbConn then
