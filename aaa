    local function fridayStrafeArmChainSettle(jumpStuds, reason, alreadyInRing)
        jumpStuds = math.max(0, tonumber(jumpStuds) or 0)
        alreadyInRing = alreadyInRing == true
        local closeHop = jumpStuds <= 70
        local need
        if alreadyInRing or closeHop then
            need = math.clamp(0.04 + (jumpStuds / 3500), 0.05, 0.14)
        else
            need = math.clamp(0.10 + (jumpStuds / 1200), 0.12, 0.32)
        end
        local untilAt = tick() + need
        if alreadyInRing or closeHop then
            _G.__FridayStrafeChainUntil = untilAt
            _G.__FridayMoveSettleUntil = untilAt
        else
            _G.__FridayStrafeChainUntil = math.max(tonumber(rawget(_G, "__FridayStrafeChainUntil")) or 0, untilAt)
            _G.__FridayMoveSettleUntil = math.max(tonumber(rawget(_G, "__FridayMoveSettleUntil")) or 0, untilAt)
        end
        _G.__FridayStrafeAimReady = false
        if alreadyInRing or closeHop then
            strafeState.peakApproach = math.min(jumpStuds, 40)
            strafeState.chainCovered = true
            strafeState.softRetarget = true
        else
            strafeState.peakApproach = math.max(tonumber(strafeState.peakApproach) or 0, jumpStuds)
            strafeState.chainCovered = false
            strafeState.softRetarget = false
        end
        strafeState.settleAt = nil
        strafeState.stableFrames = 0
        fridayStrafeDbg("chain", string.format(
            "%s jump=%.0f settle=%.2fs inRing=%s soft=%s",
            tostring(reason or "retarget"),
            jumpStuds,
            need,
            tostring(alreadyInRing),
            tostring(strafeState.softRetarget == true)
        ), 0)
        return need
    end


