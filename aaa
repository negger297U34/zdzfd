        local function worldApplyEmitterTuning(emitter, weatherType)
            local preset = WEATHER_PRESETS[weatherType] or WEATHER_PRESETS.snow
            local ratePct = math.clamp(flagNum("world_weather_rate", 100), 0, 100) / 100
            local life = math.clamp(flagNum("world_weather_lifetime", 20), 1, 60)
            local scale = math.clamp(flagNum("world_weather_timescale", 1), 0.1, 5)
            local baseRate = preset.Rate or 900
            emitter.Rate = math.max(baseRate * ratePct, 1)
            if weatherType == "snow" then
                emitter.Lifetime = NumberRange.new(math.max(life * 0.35, 1), life)
            elseif weatherType == "comets" then
                emitter.Lifetime = NumberRange.new(math.max(life * 0.05, 0.35), math.max(life * 0.15, 1.2))
            elseif weatherType == "light rain" then
                emitter.Lifetime = NumberRange.new(math.max(life * 0.25, 2), math.max(life * 0.55, 4))
            else
                emitter.Lifetime = NumberRange.new(math.max(life * 0.04, 0.4), math.max(life * 0.12, 1.2))
            end
            emitter.TimeScale = scale
            emitter.Color = worldWeatherColorSequence()
        end

        local function worldCreateParticles()
            local cam = Workspace.CurrentCamera
            if not cam then
                return nil, nil
            end
            local weatherType = worldNormalizeWeatherType(flagVal("world_weather_particles", "snow"))
            local preset = WEATHER_PRESETS[weatherType] or WEATHER_PRESETS.snow

            local part = Instance.new("Part")
            part.Name = "FridayWeatherVolume"
            part.Size = weatherType == "comets" and Vector3.new(90, 60, 90) or Vector3.new(40, 40, 85)
            part.Transparency = 1
            part.CanCollide = false
            part.CanQuery = false
            part.CanTouch = false
            part.Anchored = true
            part.Massless = true
            part.CastShadow = false
            part.Parent = Workspace

            local emitter = Instance.new("ParticleEmitter")
            emitter.Name = "FridayWeatherEmitter"
            emitter.Parent = part
            for key, value in pairs(preset) do
                pcall(function()
                    emitter[key] = value
                end)
            end
            worldApplyEmitterTuning(emitter, weatherType)
            return part, weatherType
        end

