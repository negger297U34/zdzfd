	local function ExecOne(Raw)
		local Line = (tostring(Raw or ""):match("^%s*(.-)%s*$")) or ""
		local Cmd, Rest = Line:match("^(%S+)%s*(.-)%s*$")
		if not Cmd then
			return
		end
		Cmd = Cmd:lower()
		local Action = CMD_MAP[Cmd]
		if not Action then
			Notify("unknown cmd: " .. Cmd .. " (help)")
			return
		end

		if Action == "__help" then
			task.defer(ShowHelp)
		elseif Action == "__load" then
			RefreshLoadout()
		elseif Action == "__rejoin" then
			Notify("rejoining")
			pcall(function()
				game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, game.JobId, LP)
			end)
		elseif Action == "__hop" then
			Notify("server hop")
			pcall(function()
				game:GetService("TeleportService"):Teleport(game.PlaceId, LP)
			end)
		elseif Action == "__whitelist" or Action == "__unwhitelist" then
			local Plr = ResolvePlayer(Rest)
			if not Plr then
				Notify("player not found")
				return
			end
			local Map = WhitelistMap()
			Map[Plr] = Action == "__whitelist" or nil
			if Options.ta_whitelist_players then
				Options.ta_whitelist_players:SetValue(Map)
			end
			if type(_G.__FridayOmegaRefreshTaPlayers) == "function" then
				pcall(_G.__FridayOmegaRefreshTaPlayers)
			end
			Notify((Action == "__whitelist" and "whitelist + " or "whitelist - ") .. Plr.Name)
		elseif Action == "__spectate" then
			local Plr = ResolvePlayer(Rest)
			if not Plr then
				Notify("player not found")
				return
			end
			SetSpectate(Plr)
			Notify("spectating " .. Plr.Name)
		elseif Action == "__unspectate" then
			SetSpectate(nil)
			if Toggles.ta_spectate then
				Toggles.ta_spectate:SetValue(false)
			end
			Notify("spectate off")
		elseif Action:sub(1, 6) == "__stop" then
			local Actions = _G.__FridayOmegaTaActions
			if type(Actions) ~= "table" then
				Notify("backend combat non chargé")
				return
			end
			local FnName = ({
				__stopLoopKill = "stopLoopKill",
				__stopLoopKnock = "stopLoopKnock",
				__stopLoopBring = "stopLoopBring",
				__stopLoopFling = "stopLoopFling",
				__stopAllLoops = "stopAllLoops",
			})[Action]
			if type(Actions[FnName]) == "function" then
				pcall(Actions[FnName])
			elseif Action == "__stopAllLoops" and type(Actions.reset) == "function" then
				pcall(Actions.reset)
			end
			_G.__FridayCmdOverrideTargets = nil
			Notify("loops stopped")
		else
			local IsLoop = Action == "loopKill" or Action == "loopKnock" or Action == "loopBring" or Action == "loopFling"
			if IsLoop and Rest == "" then
				local Actions = _G.__FridayOmegaTaActions
				if type(Actions) == "table" and type(Actions[Action]) == "function" then
					pcall(Actions[Action])
				else
					Notify("backend combat non chargé")
				end
				return
			end
			local Plr = ResolvePlayer(Rest)
			if not Plr then
				Notify("player not found: " .. tostring(Rest))
				return
			end
			if RunAction(Action, { Plr }) then
				Notify(Cmd .. " → " .. Plr.DisplayName .. " (@" .. Plr.Name .. ")")
			end
		end
	end

	local function ExecLine(Full)
		Full = tostring(Full or ""):gsub("%s*|%s*", "/")
		local Parts = {}
		for Chunk in (Full .. "/"):gmatch("([^/]*)/") do
			local Part = Chunk:match("^%s*(.-)%s*$") or ""
			if Part ~= "" then
				table.insert(Parts, Part)
			end
		end
		task.spawn(function()
			for Index, Part in Parts do
				ExecOne(Part)
				if Index < #Parts then
					local Deadline = tick() + 45
					while tick() < Deadline and _G.__FridayTaActBusy == true do
						task.wait(0.1)
					end
					task.wait(0.15)
				end
			end
		end)
