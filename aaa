        local function worldNormalizeWeatherType(raw)
            if type(raw) == "table" then
                raw = raw.Name or raw.Value or raw[1] or raw.Selected or "snow"
            end
            local t = string.lower(tostring(raw or "snow")):gsub("_", " "):gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
            if t == "light rain" or t == "lightrain" then
                return "light rain"
            end
            if t == "comet" or t == "comets" then
                return "comets"
            end
            if t == "rain" or t == "snow" then
                return t
            end
            return "snow"
        end

