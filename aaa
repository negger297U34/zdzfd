end

local function requestRetaliate(attacker, mode, gen, dmg, why)
    if not attacker then
        return
    end
    local newRank = tonumber(EVIDENCE_RANK[why]) or 0
    if newRank < MIN_RETALIATE_RANK then
        if type(why) ~= "string" or why == "" or why == "no-evidence" or why == "pending" then
            return
        end
        if newRank <= 0 and not why:find("firer", 1, true) and not why:find("combat", 1, true) then
            return
        end
    end
    local cur = Retaliate.attacker
    if cur and cur ~= attacker and cur.Parent == Players and not isDowned(cur) then
        local curRank = tonumber(Retaliate.whyRank) or 0
        if newRank < curRank then
            return
        end
    end
    sentryClearHolsterBlock()
    Retaliate.attacker = attacker
    Retaliate.mode = mode or "knock"
    Retaliate.gen = gen
    Retaliate.whyRank = math.max(newRank, MIN_RETALIATE_RANK)
    Retaliate.hits += 1
    Retaliate.untilAt = math.max(Retaliate.untilAt, os.clock() + 1.85)
    abortBuysForSentry()
    ensureRetaliateWorker()

    local msg = SentryConfig.message
    if type(msg) == "string" and msg ~= "" and (os.clock() - Retaliate.lastChatAt) > 1.25 then
        Retaliate.lastChatAt = os.clock()
        task.spawn(sendSentryChat, msg)
    end
    if SentryConfig.wantAdd then
        addAttackerToSelection(attacker)
    end
end

local function onHealthChanged()
    if SentryConfig.enabled ~= true then
        local hum0 = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum0 then
            HealthState.Last = hum0.Health
        end
        return
    end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then
        return
    end
    if hum:GetAttribute("__sentry_hook_gen") ~= CharHooks.gen then
        return
    end

    local current = hum.Health
    local last = HealthState.Last

    if last ~= nil and current < last - 0.05 and current > 0 then
        local busy = Retaliate.running == true
        if (not busy) and os.clock() - HealthState.LastHitAt < 0.02 then
            HealthState.Last = current
            return
        end
        HealthState.LastHitAt = os.clock()
        local dmg = last - current
        local gen = CharHooks.gen
        local dmgTxt = string.format("%.1f", dmg)

        task.spawn(function()
            if CharHooks.gen ~= gen or SentryConfig.enabled ~= true then
                return
            end
            abortBuysForSentry()
            local attacker, why = resolveAttackerAsync()
            if CharHooks.gen ~= gen then
                clearSentryPriority()
                return
            end
            if attacker and isFriendlyWhitelisted(attacker) then
                clearSentryPriority()
                return
            end
            if attacker then
                sentryLog("HIT", string.format("%s shot you (-%s) [%s]", attacker.Name, dmgTxt, tostring(why)), {
                    plr = attacker,
                    dmg = dmg,
                    why = why,
                })
                local doCombat = SentryConfig.wantKill == true or SentryConfig.wantKnock == true
                if doCombat then
                    local mode = SentryConfig.wantKill and "kill" or "knock"
                    requestRetaliate(attacker, mode, gen, dmg, why)
                else
                    local msg = SentryConfig.message
                    if type(msg) == "string" and msg ~= "" then
                        task.spawn(sendSentryChat, msg)
                    end
                    if SentryConfig.wantAdd then
                        addAttackerToSelection(attacker)
                        sentryLog("ADD", "added " .. attacker.Name .. " to targets", { plr = attacker })
                    end
                    clearSentryPriority()
                end
            else
                sentryLog("SKIP", "no trusted attacker (-" .. dmgTxt .. ") why=" .. tostring(why), {
                    dmg = dmg,
                    why = why,
                })
                clearSentryPriority()
            end
        end)
    end

    HealthState.Last = current
end

local AllyWatch = {
    hp = {},
    lastHitAt = {},
    started = false,
}

local function allyProtectOn()
    return SentryConfig.enabled == true and SentryConfig.protectWhitelist == true
end

local function collectAllyCreators(ally)
    local char = ally and ally.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local list, seen = {}, {}
    if hum then
        collectCreatorPlayers(hum, list, seen)
    end
    if char then
        collectCreatorPlayers(char, list, seen)
        local be = char:FindFirstChild("BodyEffects")
        if be then
            collectCreatorPlayers(be, list, seen)
        end
    end
    return list
end

local function pickAllyFromCreators(list)
    if #list == 0 then
        return nil
    end
    if #list == 1 then
        return list[1]
    end
    local best, bestAt = nil, -1
    for _, plr in ipairs(list) do
        local firedAt = FireTracker.FiredAt[plr]
        if firedAt and firedAt > bestAt then
            best, bestAt = plr, firedAt
        end
    end
    return best or list[1]
end

local function resolveAllyAttacker(ally, hitAt)
    hitAt = hitAt or os.clock()
    local lastWhy = "ally-no-evidence"
    local function tryOnce()
        if not ally or ally.Parent ~= Players then
            return nil, "ally-gone"
        end
        local tagged = pickAllyFromCreators(collectAllyCreators(ally))
        if tagged and tagged ~= ally and tagged ~= LocalPlayer and not isFriendlyWhitelisted(tagged) then
            return tagged, "ally-creator-tag"
        end
        local head = ally.Character and ally.Character:FindFirstChild("Head")
        local firers = recentFirers(FIRE_WINDOW)
        local aimed = {}
        for _, p in ipairs(firers) do
            if p ~= ally and mouseOnUs(p, head) then
                aimed[#aimed + 1] = p
            end
        end
        if #aimed == 1 then
            return aimed[1], "ally-aimed-firer"
        end
        if #aimed > 1 then
            local synced = {}
            for _, p in ipairs(aimed) do
                if isHitSynced(p, hitAt) then
                    synced[#synced + 1] = p
                end
            end
            if #synced == 1 then
                return synced[1], "ally-aimed-firer"
            end
        end
        if #firers == 1 and firers[1] ~= ally and isHitSynced(firers[1], hitAt) then
            return firers[1], "ally-unique-firer"
        end
        local best, bestAt = nil, -1
        for _, p in ipairs(firers) do
            if p ~= ally and isHitSynced(p, hitAt) then
                local at = FireTracker.FiredAt[p] or 0
                if at > bestAt then
                    best, bestAt = p, at
                end
            end
        end
        if best then
            return best, "ally-unique-firer"
        end
        return nil, "ally-no-evidence"
    end
    local attacker, why = tryOnce()
    lastWhy = why or lastWhy
    if attacker then
        return attacker, why
    end
    for _ = 1, 8 do
        task.wait(0.03)
        attacker, why = tryOnce()
        lastWhy = why or lastWhy
        if attacker then
            return attacker, why
        end
    end
    return nil, lastWhy
end

local function protectAlly(ally, dmg)
    local hitAt = os.clock()
    local attacker, why = resolveAllyAttacker(ally, hitAt)
    local dmgTxt = string.format("%.1f", dmg)
    if not attacker or attacker == ally or attacker == LocalPlayer then
        sentryLog("SKIP", string.format("no attacker on %s (-%s) [%s]", ally.Name, dmgTxt, tostring(why)), {
            plr = ally,
            dmg = dmg,
            why = why,
        })
        return
    end
    if isFriendlyWhitelisted(attacker) then
        return
    end
    sentryLog("HIT", string.format("%s shot %s (-%s) [%s]", attacker.Name, ally.Name, dmgTxt, tostring(why)), {
        plr = attacker,
        dmg = dmg,
        why = why,
    })
    if SentryConfig.wantKill == true or SentryConfig.wantKnock == true then
        abortBuysForSentry()
        requestRetaliate(
            attacker,
            SentryConfig.wantKill and "kill" or "knock",
            CharHooks.gen,
            dmg,
            why or "ally-creator-tag"
        )
        return
    end
    local msg = SentryConfig.message
    if type(msg) == "string" and msg ~= "" then
        task.spawn(sendSentryChat, msg)
    end
    if SentryConfig.wantAdd then
        addAttackerToSelection(attacker)
        sentryLog("ADD", "added " .. attacker.Name .. " to targets", { plr = attacker })
    end
end

local function tickAllyWatch()
    local alive = {}
    for _, ally in ipairs(Players:GetPlayers()) do
        if ally ~= LocalPlayer and isFriendlyWhitelisted(ally) then
            local char = ally.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then
                alive[ally] = true
                local current = hum.Health
                local last = AllyWatch.hp[ally]
                AllyWatch.hp[ally] = current
                if last ~= nil and current > 0 and current < last - 0.05 then
                    local now = os.clock()
                    if now - (AllyWatch.lastHitAt[ally] or 0) >= 0.4 then
                        AllyWatch.lastHitAt[ally] = now
                        local dmg = last - current
                        task.spawn(function()
                            if allyProtectOn() then
                                protectAlly(ally, dmg)
                            end
                        end)
                    end
                end
            end
        end
    end
    for ally in pairs(AllyWatch.hp) do
        if not alive[ally] then
            AllyWatch.hp[ally] = nil
            AllyWatch.lastHitAt[ally] = nil
        end
    end
end

local function startAllyWatch()
    if AllyWatch.started then
        return
    end
    AllyWatch.started = true
    task.spawn(function()
        while task.wait(0.1) do
            if _G.__FridayUnloaded or _G.__FridayOmegaUnloaded then
                break
            end
            if allyProtectOn() then
                pcall(tickAllyWatch)
            elseif next(AllyWatch.hp) ~= nil then
                table.clear(AllyWatch.hp)
                table.clear(AllyWatch.lastHitAt)
            end
        end
        AllyWatch.started = false
    end)
end

