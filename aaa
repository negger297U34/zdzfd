local CACHE_DIR = "Artefact/cache"
local UpdateReady = false

local function CanCache()
	return type(readfile) == "function" and type(writefile) == "function" and type(isfile) == "function"
end

if CanCache() and type(makefolder) == "function" and type(isfolder) == "function" then
	pcall(function()
		if not isfolder("Artefact") then
			makefolder("Artefact")
		end
		if not isfolder(CACHE_DIR) then
			makefolder(CACHE_DIR)
		end
	end)
end

local function CachedGet(Url, Name)
	local Path = CACHE_DIR .. "/" .. Name
	local Cached
	if CanCache() then
		local Ok, Content = pcall(function()
			return isfile(Path) and readfile(Path) or nil
		end)
		Cached = Ok and type(Content) == "string" and #Content > 1000 and Content or nil
	end

	if Cached then
		task.spawn(function()
			local Ok, Fresh = pcall(game.HttpGet, game, Url)
			if Ok and type(Fresh) == "string" and #Fresh > 1000 and Fresh ~= Cached then
				if pcall(writefile, Path, Fresh) then
					UpdateReady = true
				end
			end
		end)
		return Cached
	end

	local Fresh = game:HttpGet(Url)
	if CanCache() then
		pcall(writefile, Path, Fresh)
	end
	return Fresh
end

