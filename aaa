	local function FindLoadoutRemote()
		local Detect = rawget(_G, "__FridayInfAmmoDetect")
		if type(Detect) == "table" and Detect.remote and Detect.remote.Parent then
			return Detect.remote
		end
		local RS = game:GetService("ReplicatedStorage")
		local Exact = RS:FindFirstChild("Loadout", true)
		if Exact and (Exact:IsA("RemoteEvent") or Exact:IsA("UnreliableRemoteEvent")) then
			return Exact
		end
		for _, Object in RS:GetDescendants() do
			if (Object:IsA("RemoteEvent") or Object:IsA("UnreliableRemoteEvent")) and Object.Name:lower():find("loadout", 1, true) then
				return Object
			end
		end
		return nil
	end

	local function RefreshLoadout()
		local Remote = FindLoadoutRemote()
		if not Remote then
			Notify("loadout unavailable")
			return
		end

		local Out, Used, Idx = { "None", "None", "None", "None" }, {}, 1
		local function Place(Name)
			if type(Name) ~= "string" or Name == "" or Name == "None" or Used[Name] or Idx > 4 then
				return
			end
			Out[Idx] = Name
			Used[Name] = true
			Idx += 1
		end

		local Equipped = LP.Character and LP.Character:FindFirstChildOfClass("Tool")
		if Equipped then
			Place(Equipped.Name)
		end
		local Detect = rawget(_G, "__FridayInfAmmoDetect")
		if type(Detect) == "table" and type(Detect.loadout) == "table" then
			for I = 1, 4 do
				Place(Detect.loadout[I])
			end
		end
		Place("[TacticalShotgun]")
		Place("[Double-Barrel SG]")
		Place("[Revolver]")
		Place("[Knife]")

		pcall(function()
			Remote:FireServer(Out)
		end)
		Notify("loadout refreshed")
	end

