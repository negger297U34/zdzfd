local Bridge = {}
do
	local GuiService = game:GetService("GuiService")

	local Store = {}
	local KeyTables = {}
	local KeyCallbacks = {}
	local Bound = {}
	local Controls = {}
	local AccentListeners = {}

	local AUTO_ARM = {
		ta_keybind = true,
		silent_aim_key = true,
		ta_sentry_key = true,
		ta_kill_aura_key = true,
		misc_anti_aimviewer_key = true,
	}

	local LABELS = {
		snipe_status = "SnipeStatus",
		staff_spy_label = "StaffSpyLabel",
	}

	local THEME = {
		Accent = "AccentColor",
		Background = "BackgroundColor",
		Section = "MainColor",
		Text = "FontColor",
		Stroke = "OutlineColor",
		Border = "OutlineColor",
		Outline = "OutlineColor",
	}

	local function Debug(Flag, Err)
		if _G.__ArtefactDebug then
			warn("[Artefact] " .. tostring(Flag) .. ": " .. tostring(Err))
		end
	end

	local function Call(Flag, Callback, ...)
		if type(Callback) ~= "function" then
			return
		end
		local Ok, Err = pcall(Callback, ...)
		if not Ok then
			Debug(Flag, Err)
		end
	end

	local function PlayerLabel(Player)
		return Player.DisplayName .. " (@" .. Player.Name .. ")"
	end

	local function FindPlayer(Value)
		if typeof(Value) == "Instance" then
			return Value
		end
		if type(Value) ~= "string" then
			return nil
		end
		local Name = string.lower(string.match(Value, "%(@([^%)]+)%)%s*$") or Value)
		for _, Player in Players:GetPlayers() do
			if Player ~= LP and (string.lower(Player.Name) == Name or string.lower(Player.DisplayName) == Name) then
				return Player
			end
		end
		return nil
	end

	local function ReadElement(Element)
		local Kind = Element.Type
		if Kind == "Toggle" then
			return Element.Value == true
		end
		if Kind ~= "Dropdown" then
			return Element.Value
		end
		if not Element.Multi then
			if Element.Value == nil then
				return ""
			end
			return Element.Value
		end

		local Out = {}
		local Selected = type(Element.Value) == "table" and Element.Value or {}
		if Element.SpecialType == "Player" then
			for Player, On in Selected do
				if On and typeof(Player) == "Instance" and Player.Parent then
					table.insert(Out, PlayerLabel(Player))
				end
			end
			table.sort(Out, function(A, B)
				return string.lower(A) < string.lower(B)
			end)
			return Out
		end

		for Key, Raw in Element.Values do
			local Value = type(Key) == "number" and Raw or Key
			if Selected[Value] then
				table.insert(Out, Value)
			end
		end
		return Out
	end

	local function WriteElement(Element, Value)
		local Kind = Element.Type
		if Kind == "Toggle" then
			Element:SetValue(Value == true)
		elseif Kind == "Slider" then
			Element:SetValue(tonumber(Value) or Element.Value)
		elseif Kind == "Input" then
			Element:SetValue(tostring(Value or ""))
		elseif Kind == "ColorPicker" then
			if typeof(Value) == "Color3" then
				Element:SetValueRGB(Value)
			end
		elseif Kind == "Dropdown" then
			if not Element.Multi then
				if type(Value) == "table" then
					Value = Value[1]
				end
				if Value == "" then
					Value = nil
				end
				Element:SetValue(Value)
				return
			end

			local Map = {}
			local function Add(Name)
				if Element.SpecialType == "Player" then
					local Player = FindPlayer(Name)
					if Player then
						Map[Player] = true
					end
				elseif Name ~= nil and Name ~= "" then
					Map[Name] = true
				end
			end
			if type(Value) == "table" then
				for Key, Item in Value do
					if Item == true then
						Add(Key)
					elseif type(Item) == "string" or typeof(Item) == "Instance" then
						Add(Item)
					end
				end
			elseif type(Value) == "string" then
				Add(Value)
			end
			Element:SetValue(Map)
		end
	end

	local function Fire(Entry)
		local Value = Store[Entry.Flag]
		for _, Callback in Entry.Callbacks do
			Call(Entry.Flag, Callback, Value)
		end
	end

	local function Bind(Flag)
		local Entry = Bound[Flag]
		if Entry then
			return Entry
		end
		if type(Flag) ~= "string" then
			return nil
		end

		local Element = Toggles[Flag] or Options[Flag]
		if not Element or Element.Type == "KeyPicker" or type(Element.OnChanged) ~= "function" then
			return nil
		end

		Entry = { Flag = Flag, Element = Element, Callbacks = {}, Silent = 0 }
		Bound[Flag] = Entry
		Store[Flag] = ReadElement(Element)

		Element:OnChanged(function()
			local Value = ReadElement(Element)
			if Entry.Before then
				Call(Flag, Entry.Before, Value)
			end
			Store[Flag] = Value
			if Entry.Silent == 0 then
				Fire(Entry)
			end
		end)

		return Entry
	end

	local function Quiet(Entry, Action)
		Entry.Silent += 1
		local Ok, Err = pcall(Action)
		Entry.Silent -= 1
		if not Ok then
			Debug(Entry.Flag, Err)
		end
		Store[Entry.Flag] = ReadElement(Entry.Element)
	end

	local Interface = {
		Directory = "Artefact",
		IsLoadingConfig = false,
		_controls = Controls,
	}

	Interface.Theme = setmetatable({}, {
		__index = function(_, Key)
			local Scheme = THEME[Key]
			if Scheme then
				return Library.Scheme[Scheme]
			end
			if Key == "Muted" or Key == "Inactive Text" then
				return Library.Scheme.FontColor:Lerp(Library.Scheme.BackgroundColor, 0.4)
			end
			return nil
		end,
		__newindex = function(Self, Key, Value)
			if THEME[Key] == nil and Key ~= "Muted" and Key ~= "Inactive Text" then
				rawset(Self, Key, Value)
			end
		end,
	})

	Interface.Flags = setmetatable({}, {
		__index = function(_, Flag)
			local Key = KeyTables[Flag]
			if Key then
				return Key
			end
			return Store[Flag]
		end,
		__newindex = function(_, Flag, Value)
			local Key = KeyTables[Flag]
			if Key then
				if type(Value) == "table" and Value.Toggled ~= nil then
					Key.Toggled = Value.Toggled == true
				end
				return
			end
			Store[Flag] = Value
		end,
	})

	setmetatable(Interface, {
		__index = function(_, Key)
			if Key == "WindowOpenState" then
				return Library.Toggled == true
			end
			if Key == "Window" or Key == "MainWindowFrame" then
				return Window.MainFrame
			end
			if Key == "Gui" then
				return Library.ScreenGui
			end
			if Key == "AccentColor" or Key == "BackgroundColor" or Key == "MainColor" or Key == "OutlineColor" or Key == "FontColor" then
				return Library.Scheme[Key]
			end
			return nil
		end,
	})

	local function Notify(Args)
		Args = type(Args) == "table" and Args or { Description = tostring(Args or "") }
		Library:Notify({
			Title = Args.Title or "Artefact",
			Description = tostring(Args.Description or ""),
			Time = Args.Time or 2,
		})
	end

	function Interface:Notif(Args)
		Notify(Args)
	end

	function Interface:Notify(Args)
		Notify(Args)
	end

	function Interface:Notification(Message, Duration)
		if type(Message) == "table" then
			Notify(Message)
			return
		end
		Notify({ Description = tostring(Message or ""), Time = Duration or 2 })
	end

	function Interface:Visible(State)
		if State == nil then
			Library:Toggle()
		elseif (Library.Toggled == true) ~= (State == true) then
			Library:Toggle()
		end
	end

	function Interface:Init() end

	function Interface:OnAccent(Callback)
		table.insert(AccentListeners, Callback)
		Call("accent", Callback, Library.Scheme.AccentColor)
	end

	function Interface:Confirm(Args)
		Args = Args or {}
		Call("confirm", Args.Callback, true)
	end

	do
		local LastAccent = Library.Scheme.AccentColor
		local LastScheme = SchemeSignature()
		Library:GiveSignal(RunService.Heartbeat:Connect(function()
			local Scheme = SchemeSignature()
			if Scheme == LastScheme then
				return
			end
			LastScheme = Scheme

			for _, Name in { "__FridayOmegaSyncIndicatorTheme", "__FridayOmegaSyncCombatLogsTheme" } do
				local Sync = rawget(_G, Name)
				if type(Sync) == "function" then
					pcall(Sync)
				end
			end

			local Accent = Library.Scheme.AccentColor
			if Accent ~= LastAccent then
				LastAccent = Accent
				for _, Callback in AccentListeners do
					Call("accent", Callback, Accent)
				end
			end
		end))
	end

	local KeyHooks = {
		ta_keybind = function(State)
			if type(_G.__FridayOmegaTaOnKeybind) == "function" then
				pcall(_G.__FridayOmegaTaOnKeybind, State)
			end
		end,
		lock_keybind = function(State, Key)
			if type(_G.__FridayCamlockButton) == "function" then
				local Ok, Locked = pcall(_G.__FridayCamlockButton, State)
				Key.Toggled = Ok and Locked == true
