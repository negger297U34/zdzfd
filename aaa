						elseif typeof(out[3]) == 'Vector3' and typeof(out[4]) == 'Vector3' then
							dist = (out[4] - out[3]).Magnitude
						end
						out[7] = dist
					end
    					local okFire = pcall(function()
    						remote:FireServer(table.unpack(out))
    					end)
    					fired = okFire == true
    				elseif remote then
    					local origin = handle.Position
    					local layouts
					if flags.ta_inf_range == true then
						layouts = {
							{ 'ShootGun', origin, aimPos, thead, 99999 },
							{ 'ShootGun', aimPos, thead, 99999 },
							{ 'ShootGun', origin, aimPos, thead, tool, 99999 },
							{ 'ShootGun', tool, origin, aimPos, thead, 99999 },
						}
					else
						layouts = {
							{ 'ShootGun', origin, aimPos, thead },
							{ 'ShootGun', aimPos, thead },
							{ 'ShootGun', origin, aimPos, thead, tool },
							{ 'ShootGun', tool, origin, aimPos, thead },
						}
					end
    					for _, layout in ipairs(layouts) do
    						local okFire = pcall(function()
    							remote:FireServer(table.unpack(layout))
    						end)
    						if okFire then
    							fired = true
    							break
    						end
    					end
    				end
    				pcall(function()
    					if tool.Activate then
    						tool:Activate()
    					end
    				end)
    				return true
    			end

    			local aimPos = taActAimPos(thead)
    			taActPrepareAim(plr, thead, aimPos)
    			return taActFireAimed(tool, thead, aimPos, nil, nil)
    		end

    		local function taActHeadshotStomp(plr, useCsync)
    			if not plr or not plr.Character then
    				return false
    			end
