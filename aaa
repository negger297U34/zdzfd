    	local function fridayCombatLogsResetPoll(char)
    		local st = { alive = true, creators = {}, stomp = false }
    		if not char then
    			fridayCombatLogs.pollState = st
    			return
    		end
    		local hum = char:FindFirstChildOfClass('Humanoid')
    		if hum then
    			st.hp = hum.Health
    			st.alive = hum.Health > 0
    		end
    		local be = char:FindFirstChild('BodyEffects')
    		if be then
    			local armor = be:FindFirstChild('Armor')
    			if armor and armor:IsA('ValueBase') then
    				st.armor = tonumber(armor.Value)
    			end
    		end
    		fridayCombatLogs.pollState = st
    	end

    	local function fridayCombatLogsPoll()
    		if not fridayCombatLogs.enabled then
    			return
    		end
    		for _, plr in ipairs(players:GetPlayers()) do
    			if plr ~= lp and plr.Character then
    				local be = plr.Character:FindFirstChild('BodyEffects')
    				if be then
    					local gf = be:FindFirstChild('GunFiring') or be:FindFirstChild('Shooting') or be:FindFirstChild('Attacking')
    					if gf and gf:IsA('ValueBase') and (gf.Value == true or gf.Value == 1) then
    						fridayCombatLogsMarkShooter(plr, false)
    					end
    				end
    			end
    		end
    		local char = lp.Character
    		if not char then
    			return
    		end
    		local hum = char:FindFirstChildOfClass('Humanoid')
    		if not hum then
    			return
    		end
    		local st = fridayCombatLogs.pollState
    		if type(st) ~= 'table' then
    			fridayCombatLogsResetPoll(char)
    			st = fridayCombatLogs.pollState
    		end

    		local hp = hum.Health
    		if type(st.hp) == 'number' and hp < st.hp and hp > 0 then
    			local dmg = math.floor(st.hp - hp + 0.5)
    			if dmg > 0 then
    				fridayCombatLogsPushShot(hum, dmg .. ' dmg')
    			end
    		end
    		st.hp = hp
    		st.alive = hp > 0

    		local be = char:FindFirstChild('BodyEffects')
    		if be then
    			local armor = be:FindFirstChild('Armor')
    			if armor and armor:IsA('ValueBase') then
    				local av = tonumber(armor.Value)
    				if av ~= nil then
    				if type(st.armor) == 'number' and av < st.armor then
    						local dmg = math.floor(st.armor - av + 0.5)
    						if dmg > 0 and dmg <= 250 then
    							fridayCombatLogsPushShot(hum, dmg .. ' armor')
    						end
    					end
    					st.armor = av
    				end
    			end
    		end
    	end

    	fridayCombatLogsWatchCreatorTag = function(hum, child)
    		if not child or not hum then
    			return
    		end
    		if child:GetAttribute('__friday_logs_creator') then
    			return
    		end
    		if not (child:IsA('ObjectValue') or child:IsA('StringValue')
    			or child:IsA('IntValue') or child:IsA('NumberValue')) then
    			return
    		end
    		if not fridayCombatLogsIsCreatorTagName(child.Name) then
    			return
    		end
    		child:SetAttribute('__friday_logs_creator', true)
    		local function onCreator()
    			if hum.Health <= 0 then
    				return
    			end
    			local shooter = fridayCombatLogsAttackerFromTag(child)
    			if not shooter or shooter == lp then
    				return
    			end
    			fridayCombatLogs.confirmedShooter = shooter
    			fridayCombatLogs.confirmedAt = tick()
    			fridayCombatLogsMarkShooter(shooter, true)
    			if type(_900) == 'table' and type(_900.rememberCombatAttacker) == 'function' then
    				pcall(_900.rememberCombatAttacker, shooter, true)
    			end
    			local pending = fridayCombatLogs.pendingHit
    			if pending and not pending.logged and tick() - pending.at <= 1.5 then
    				fridayCombatLogsCommitShot(hum, pending, shooter, true)
    				return
    			end
    			local cb = type(_900) == 'table' and _900.onLocalDamaged
    			if type(cb) == 'function' then
    				pcall(cb, hum, pending and pending.extra or 'hit', shooter)
    			end
    			if fridayCombatLogs.enabled and (not pending or pending.logged) then
    				fridayCombatLogsPush('SHOT', shooter, pending and pending.extra or 'hit')
    			end
    		end
    		if child:IsA('ValueBase') then
    			child.Changed:Connect(onCreator)
    		end
    		task.defer(onCreator)
    	end

    	local function fridayCombatLogsStartPoll()
    		if fridayCombatLogs.pollConn then
    			return
    		end
    		local acc = 0
    		fridayCombatLogs.pollConn = RunService.Heartbeat:Connect(function(dt)
    			if not fridayCombatLogs.enabled then
    				return
    			end
    			acc += dt or 0
    			if acc < 0.08 then
    				return
    			end
    			acc = 0
    			pcall(fridayCombatLogsPoll)
    		end)
    		table.insert(_G.__FridayOmegaCleanup or {}, function()
    			if fridayCombatLogs.pollConn then
    				fridayCombatLogs.pollConn:Disconnect()
    				fridayCombatLogs.pollConn = nil
    			end
    		end)
    	end

    	local function fridayCombatLogsDisconnectLocal()
    		for _, c in ipairs(fridayCombatLogs.localConns or {}) do
    			pcall(function()
    				c:Disconnect()
    			end)
    		end
    		fridayCombatLogs.localConns = {}
