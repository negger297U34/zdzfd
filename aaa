	local function placeCornerBox(esp, boxPosition, boxSize, color, enabled)
		local lines = esp.cornerLines
		if not lines then
			return
		end
		if not enabled then
			for i = 1, #lines do
				lines[i].Visible = false
			end
			return
		end
		local x, y = boxPosition.X, boxPosition.Y
		local w, h = boxSize.X, boxSize.Y
		local len = math.clamp(math.min(w, h) * 0.25, 4, 18)
		local corners = {
			{ Vector2.new(x, y), Vector2.new(x + len, y) },
			{ Vector2.new(x, y), Vector2.new(x, y + len) },
			{ Vector2.new(x + w, y), Vector2.new(x + w - len, y) },
			{ Vector2.new(x + w, y), Vector2.new(x + w, y + len) },
			{ Vector2.new(x, y + h), Vector2.new(x + len, y + h) },
			{ Vector2.new(x, y + h), Vector2.new(x, y + h - len) },
			{ Vector2.new(x + w, y + h), Vector2.new(x + w - len, y + h) },
			{ Vector2.new(x + w, y + h), Vector2.new(x + w, y + h - len) },
		}
		for i = 1, 8 do
			local line = lines[i]
			local a, b = corners[i][1], corners[i][2]
			line.From = a
			line.To = b
			line.Color = color
			line.Thickness = 1.4
			line.Visible = true
		end
	end


	local function placeOffscreenArrow(esp, worldPos, color, enabled)
		local arrow = esp.offArrow
		if not arrow then
			return false
		end
		if not enabled then
			arrow.Visible = false
			return false
		end
		local sp, onScreen = Camera:WorldToViewportPoint(worldPos)
		local vs = Camera.ViewportSize
		local cx, cy = vs.X * 0.5, vs.Y * 0.5
		local sx, sy = sp.X, sp.Y
		if onScreen and sp.Z > 0 and sx >= 0 and sx <= vs.X and sy >= 0 and sy <= vs.Y then
			arrow.Visible = false
			return false
		end
		if sp.Z < 0 then
			sx = cx - (sx - cx)
			sy = cy - (sy - cy)
		end
		local margin = 36
		local dir = Vector2.new(sx - cx, sy - cy)
		if dir.Magnitude < 0.001 then
			dir = Vector2.new(0, -1)
		else
			dir = dir.Unit
		end
		local maxX = vs.X - margin
		local maxY = vs.Y - margin
		local scale = math.huge
		if dir.X > 0.001 then
			scale = math.min(scale, (maxX - cx) / dir.X)
		elseif dir.X < -0.001 then
			scale = math.min(scale, (margin - cx) / dir.X)
		end
		if dir.Y > 0.001 then
			scale = math.min(scale, (maxY - cy) / dir.Y)
		elseif dir.Y < -0.001 then
			scale = math.min(scale, (margin - cy) / dir.Y)
		end
		if scale == math.huge then
			scale = 1
		end
		local tip = Vector2.new(cx + dir.X * scale, cy + dir.Y * scale)
		local base = tip - dir * 16
		local perp = Vector2.new(-dir.Y, dir.X) * 9
		arrow.PointA = tip
		arrow.PointB = base + perp
		arrow.PointC = base - perp
		arrow.Color = color
		arrow.Filled = true
		arrow.Visible = true
		return true
	end

