	local BAR_SEGS = 1

	local function lerp3(c1, c2, c3, t)
		t = math.clamp(t or 0, 0, 1)
		if t < 0.5 then
			return c1:Lerp(c2, t * 2)
		end
		return c2:Lerp(c3, (t - 0.5) * 2)
	end

	local function hideBarDrawings(outline, segs)
		if outline then
			outline.Visible = false
		end
		if segs then
			for i = 1, #segs do
				segs[i].Visible = false
			end
		end
	end

	local function placeBar(outline, segs, boxPosition, boxSize, side, pct, stackIdx, c1, c2, c3)
		local barThick = 2
		local gap = 3
		local pad = 4
		pct = math.clamp(pct or 0, 0, 1)
		stackIdx = stackIdx or 0
		c1, c2, c3 = c1 or Color3.new(0, 1, 0), c2 or Color3.new(1, 1, 0), c3 or Color3.new(1, 0, 0)
		local tip = lerp3(c1, c2, c3, 1 - pct)

		if side == "Left" or side == "Right" then
			local x = side == "Left" and (boxPosition.X - pad - barThick - stackIdx * (barThick + gap))
				or (boxPosition.X + boxSize.X + pad + stackIdx * (barThick + gap))
			outline.Position = Vector2.new(x - 1, boxPosition.Y - 1)
			outline.Size = Vector2.new(barThick + 2, boxSize.Y + 2)
			outline.Visible = true

			local filled = boxSize.Y * pct
			local filledTop = boxPosition.Y + (boxSize.Y - filled)
			local step = filled / BAR_SEGS
			for i = 1, BAR_SEGS do
				local seg = segs[i]
				if not seg then
					break
				end
				if pct <= 0.001 then
					seg.Visible = false
				else
					local y = filledTop + (i - 1) * step
					seg.Position = Vector2.new(x, y - 0.35)
					seg.Size = Vector2.new(barThick, step + 0.85)
					seg.Color = tip
					seg.Filled = true
					seg.Visible = true
				end
			end
			for i = BAR_SEGS + 1, #segs do
				segs[i].Visible = false
			end
		else
			local y = side == "Top" and (boxPosition.Y - pad - barThick - stackIdx * (barThick + gap))
				or (boxPosition.Y + boxSize.Y + pad + stackIdx * (barThick + gap))
			outline.Position = Vector2.new(boxPosition.X - 1, y - 1)
			outline.Size = Vector2.new(boxSize.X + 2, barThick + 2)
			outline.Visible = true

			local filled = boxSize.X * pct
			local step = filled / BAR_SEGS
			for i = 1, BAR_SEGS do
				local seg = segs[i]
				if not seg then
					break
				end
				if pct <= 0.001 then
					seg.Visible = false
				else
					local x = boxPosition.X + (i - 1) * step
					seg.Position = Vector2.new(x - 0.35, y)
					seg.Size = Vector2.new(step + 0.85, barThick)
					seg.Color = tip
					seg.Filled = true
					seg.Visible = true
				end
			end
			for i = BAR_SEGS + 1, #segs do
				segs[i].Visible = false
			end
		end
	end

	local function barStackDepth(count)
		if not count or count <= 0 then
			return 0
		end
		local barThick, gap, pad = 2, 3, 4
		return pad + count * (barThick + 2) + (count - 1) * gap
	end

