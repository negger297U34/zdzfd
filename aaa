            while SentryConfig.enabled == true and os.clock() < Retaliate.untilAt do
                abortBuysForSentry()
                sentryClearHolsterBlock()
                local attacker = Retaliate.attacker
                local mode = Retaliate.mode
                local gen = Retaliate.gen
                if not attacker or attacker.Parent ~= Players then
                    break
                end
                if CharHooks.gen ~= gen then
