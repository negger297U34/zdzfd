    local function strafeWalkGround(root, hum, pos)
        local lp = game:GetService("Players").LocalPlayer
        local params = RaycastParams.new()
        pcall(function()
            params.FilterType = Enum.RaycastFilterType.Exclude
        end)
        local filter = {}
        if lp.Character then
            filter[#filter + 1] = lp.Character
        end
        if strafeState.setback then
            filter[#filter + 1] = strafeState.setback
        end
        if strafeState.model then
            filter[#filter + 1] = strafeState.model
        end
        if strafeState.serverPart then
            filter[#filter + 1] = strafeState.serverPart
        end
        params.FilterDescendantsInstances = filter
        local hip = tonumber(hum and hum.HipHeight) or 0
        if hip < 0.05 then
            hip = 2
        end
        hip = hip + ((root and root.Size.Y / 2) or 1)
        local hit = workspace:Raycast(pos + Vector3.new(0, 2.5, 0), Vector3.new(0, -(hip + 10), 0), params)
        if hit then
            return hit.Position.Y + hip, true
        end
        return pos.Y, false
    end

    local function strafeWalkVisual(dt)
        if rawget(_G, "__FridayStrafeOn") ~= true or flags.ta_strafe_walkable ~= true then
            return
        end
        if rawget(_G, "__FridayStrafePaused") == true or rawget(_G, "__FridayTaStompGluing") == true then
            return
        end
        if _G.__FridaySpectateUid or _G.__FridayManualViewUid then
            return
        end
        local lp = game:GetService("Players").LocalPlayer
        local live = lp.Character
        local hum = live and live:FindFirstChildOfClass("Humanoid")
        local root = live and live:FindFirstChild("HumanoidRootPart")
        if not hum then
            return
        end
        strafeLockWalkHum(hum)
        if typeof(strafeState.walkCF) ~= "CFrame" then
            if typeof(strafeState.homeCF) == "CFrame" then
                strafeState.walkCF = strafeState.homeCF
            elseif root then
                strafeState.walkCF = root.CFrame
            else
                return
            end
        end
        dt = tonumber(dt) or 0
        if dt <= 0 then
            dt = 1 / 60
        elseif dt > 0.1 then
            dt = 0.1
        end
        local pos = strafeState.walkCF.Position
        local move = hum.MoveDirection
        local spd = tonumber(hum.WalkSpeed) or 16
        if spd <= 0 then
            spd = 16
        end
        if typeof(move) == "Vector3" and move.Magnitude > 0.01 then
            local flat = Vector3.new(move.X, 0, move.Z)
            if flat.Magnitude > 0.01 then
                pos = pos + flat.Unit * spd * dt
            end
        end
        local groundY, grounded = strafeWalkGround(root, hum, pos)
        local velY = tonumber(strafeState.walkVelY) or 0
        if grounded then
            if velY < 0 then
                velY = 0
            end
            pos = Vector3.new(pos.X, groundY, pos.Z)
            if strafeState.jumpQueued == true then
                local jp = tonumber(hum.JumpPower)
                velY = (jp and jp > 0 and jp) or 50
                strafeState.jumpQueued = false
                strafeState.jumpHeld = true
            else
                strafeState.jumpHeld = false
            end
        else
            velY = velY - (workspace.Gravity or 196.2) * dt
            pos = Vector3.new(pos.X, pos.Y + velY * dt, pos.Z)
            if pos.Y < groundY then
                pos = Vector3.new(pos.X, groundY, pos.Z)
                velY = 0
            end
        end
        strafeState.walkVelY = velY
        local flatMove = typeof(move) == "Vector3" and Vector3.new(move.X, 0, move.Z) or Vector3.zero
        if flatMove.Magnitude > 0.05 then
            strafeState.walkCF = CFrame.lookAt(pos, pos + flatMove)
        else
            local look = strafeState.walkCF.LookVector
            local flatLook = Vector3.new(look.X, 0, look.Z)
            if flatLook.Magnitude > 0.05 then
                strafeState.walkCF = CFrame.lookAt(pos, pos + flatLook)
            else
                strafeState.walkCF = CFrame.new(pos) * (strafeState.walkCF - strafeState.walkCF.Position)
            end
        end
        local setback = strafeEnsureSetback()
        local height = (root and root.Size.Y / 2 or 1) + 0.5
        if typeof(strafeState.walkCF) == "CFrame" then
            setback.CFrame = strafeState.walkCF * CFrame.new(0, height, 0)
        end
        local cam = workspace.CurrentCamera
        if cam then
            pcall(function()
                cam.CameraType = Enum.CameraType.Custom
                cam.CameraSubject = setback
            end)
        end
    end

    local function strafeBindWalk()
        strafeUnbindWalk()
        local rs = game:GetService("RunService")
        local uis = game:GetService("UserInputService")
        strafeState.jumpQueued = false
        strafeState.jumpHeld = false
        strafeState.walkVelY = 0
        pcall(function()
